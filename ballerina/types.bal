    string entryDate?;
    # UserID for a Timesheet user in Avaza
    @jsondata:Name {value: "UserIDFK"}
    int:Signed32 userIDFK?;
    # The Project timesheet category to link the timesheet to
    @jsondata:Name {value: "TimesheetCategoryIDFK"}
    int:Signed32 timesheetCategoryIDFK?;
    # The duration of the timesheet, in decimal hours. If null or 0, a timer will be started
    @jsondata:Name {value: "Duration"}
    decimal duration?;
    # Timesheet Notes
    @jsondata:Name {value: "Notes"}
    string notes?;
    # Optional. free nvarchar field available via Api to store any additional metadata against a timesheet. We suggest you use Json or your preferred serialisation format. 1000 characters max
    @jsondata:Name {value: "CustomMetadata"}
    string customMetadata?;
};

# An allocation record linking a bill payment to a specific supplier bill
public type BillPaymentAllocation record {
    # The amount allocated from the payment to the bill
    @jsondata:Name {value: "AllocationAmount"}
    decimal allocationAmount?;
    # Unique identifier for this payment allocation
    @jsondata:Name {value: "TransactionAllocationID"}
    int transactionAllocationID?;
    # The date this allocation was applied
    @jsondata:Name {value: "AllocationDate"}
    string allocationDate?;
    # The payment Transaction ID this allocation belongs to
    @jsondata:Name {value: "PaymentTransactionIDFK"}
    int paymentTransactionIDFK?;
    # The bill Transaction ID this payment is allocated against
    @jsondata:Name {value: "BillTransactionIDFK"}
    int billTransactionIDFK?;
};

# Represents the Queries record for the operation: listInvoiceTemplates
public type ListInvoiceTemplatesQueries record {
    # Only return templates of this type: INV, EST or BILL. Omit for all types
    @http:Query {name: "TemplateTypeCode"}
    string templateTypeCode?;
    # Page to display. Starts from 1
    int:Signed32 pageNumber?;
    # Number of items per page (max 1000, default 100)
    int:Signed32 pageSize?;
    # Only return templates whose name matches exactly (case-insensitive, surrounding whitespace ignored). Names are not unique within an account, so more than one template can match; use TemplateTypeCode to tell them apart. Partial matching is not supported
    @http:Query {name: "Name"}
    string name?;
};

# A tag applied to a project, with ID and name
public type ProjectTagItem record {
    # Unique identifier for the project tag
    @jsondata:Name {value: "ProjectTagID"}
    int:Signed32 projectTagID?;
    # Tag name
    @jsondata:Name {value: "Name"}
    string name?;
};

# A deleted timesheet entry record including all original field values, useful for external system synchronisation
public type DeletedTimeSheetEntryDetails record {
    # The bill line item ID if the entry had been included on a supplier bill
    @jsondata:Name {value: "BillLineItemIDFK"}
    int billLineItemIDFK?;
    # The UTC start time of the entry, if start/end time tracking was enabled
    @jsondata:Name {value: "StartTimeUTC"}
    string startTimeUTC?;
    # The project ID this entry was associated with
    @jsondata:Name {value: "ProjectIDFK"}
    int:Signed32 projectIDFK?;
    # Date and time the record was originally created (UTC)
    @jsondata:Name {value: "DateCreated"}
    string dateCreated?;
    # The local end time of the entry, if start/end time tracking was enabled
    @jsondata:Name {value: "EndTimeLocal"}
    string endTimeLocal?;
    # The billing rate amount. Only visible to Admin role users
    @jsondata:Name {value: "RateAmount"}
    decimal rateAmount?;
    # The UTC end time of the entry, if start/end time tracking was enabled
    @jsondata:Name {value: "EndTimeUTC"}
    string endTimeUTC?;
    # The IANA time zone ID of the user who owned the timesheet
    @jsondata:Name {value: "TimesheetUserTimeZone"}
    string timesheetUserTimeZone?;
    # The invoice line item ID if the entry had been invoiced
    @jsondata:Name {value: "InvoiceLineItemIDFK"}
    int invoiceLineItemIDFK?;
    # The cost rate amount. Only visible to Admin role users
    @jsondata:Name {value: "CostAmount"}
    decimal costAmount?;
    # The UTC time the timer was started, if a timer was running
    @jsondata:Name {value: "TimerStartedAtUTC"}
    string timerStartedAtUTC?;
    # Notes attached to the timesheet entry
    @jsondata:Name {value: "Notes"}
    string notes?;
    # Unique identifier of the deleted timesheet entry
    @jsondata:Name {value: "TimeSheetEntryID"}
    int timeSheetEntryID?;
    # Date and time the record was last updated before deletion (UTC)
    @jsondata:Name {value: "DateUpdated"}
    string dateUpdated?;
    # The task ID the entry was linked to, if any
    @jsondata:Name {value: "TaskIDFK"}
    int:Signed32 taskIDFK?;
    # The Avaza account this entry belonged to
    @jsondata:Name {value: "AccountIDFK"}
    int:Signed32 accountIDFK?;
    # Duration of the entry in decimal hours
    @jsondata:Name {value: "Duration"}
    decimal duration?;
    # The timesheet category ID applied to this entry
    @jsondata:Name {value: "TimeSheetCategoryIDFK"}
    int:Signed32 timeSheetCategoryIDFK?;
    # Whether the entry was billable
    boolean isBillable?;
    # Whether the entry had been paid
    boolean isPaid?;
    # Whether a timer was running on this entry at the time of deletion
    @jsondata:Name {value: "HasTimer"}
    boolean hasTimer?;
    # The local start time of the entry, if start/end time tracking was enabled
    @jsondata:Name {value: "StartTimeLocal"}
    string startTimeLocal?;
    # Name or email of the user who approved this entry
    @jsondata:Name {value: "ApprovedBy"}
    string approvedBy?;
    # The original date of the timesheet entry
    @jsondata:Name {value: "EntryDate"}
    string entryDate?;
    # The user ID who owned this timesheet entry
    @jsondata:Name {value: "UserIDFK"}
    int:Signed32 userIDFK?;
    # Approval status at the time of deletion
    @jsondata:Name {value: "TimesheetEntryApprovalStatusCode"}
    string timesheetEntryApprovalStatusCode?;
    # The user ID of the user who deleted this entry
    @jsondata:Name {value: "DeletedByUserIDFK"}
    int:Signed32 deletedByUserIDFK?;
    # Whether the entry had been invoiced
    @jsondata:Name {value: "IsInvoiced"}
    boolean isInvoiced?;
    # Date and time the entry was approved, if applicable
    @jsondata:Name {value: "DateApproved"}
    string dateApproved?;
    # The date and time the entry was deleted (UTC)
    @jsondata:Name {value: "DeletedDate"}
    string deletedDate?;
    # Custom metadata stored on the entry
    @jsondata:Name {value: "CustomMetadata"}
    string customMetadata?;
    # Whether the entry was payable
    boolean isPayable?;
};

