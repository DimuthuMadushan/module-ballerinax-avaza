# Represents the Queries record for the operation: getRunningTimer
public type GetRunningTimerQueries record {
    # Optional - User ID number if impersonating a different user. Otherwise assumes the current user. Only users with certain security roles have permission to impersonate other users
    @http:Query {name: "UserID"}
    int:Signed32 userID?;
};

# Request body for rejecting a batch of timesheet entries by their IDs
public type TimesheetRejectionRequest record {
    # (Required) List of TimeSheetEntryIDs to reject. 1-500 unique positive integers
    @jsondata:Name {value: "TimeSheetEntryIDs"}
    int[] timeSheetEntryIDs?;
    # (Optional) Free-text rejection reason included in the rejection notification email. Max 1000 characters
    @jsondata:Name {value: "RejectionReason"}
    string rejectionReason?;
    # (Optional) When true (default), sends the standard rejection notification email to each affected timesheet user. Set to false to suppress emails
    @jsondata:Name {value: "SendNotifications"}
    boolean sendNotifications?;
};

# Payload for creating a new fixed-amount billing entry against a task
public type NewFixedAmount record {
    # The task the fixed amount is added to. Required. Must exist in the authenticated account; the project is always derived from the task. Multiple fixed amounts per task are allowed
    @jsondata:Name {value: "TaskIDFK"}
    int:Signed32 taskIDFK?;
    # The fixed billing amount, in the currency of the customer the task's project belongs to. Required. Rounded to that currency's decimal places
    @jsondata:Name {value: "Amount"}
    decimal amount?;
    # The inventory item used when this fixed amount is invoiced. Required; there is no default
    @jsondata:Name {value: "InventoryItemIDFK"}
    int inventoryItemIDFK?;
    # Plain text notes, maximum 255 characters
    @jsondata:Name {value: "Notes"}
    string notes?;
};

# Result of previewing uninvoiced records for an invoice. Nothing is saved by a preview
public type PreviewUninvoicedItemsResult record {
    # The line items that AddUninvoicedItems would create for the same request
    @jsondata:Name {value: "LineItems"}
    PreviewLineItem[] lineItems?;
    # Sum of the previewed line tax amounts
    @jsondata:Name {value: "TaxAmount"}
    decimal taxAmount?;
    # Sum of the previewed line amounts
    @jsondata:Name {value: "SubtotalAmount"}
    decimal subtotalAmount?;
    # Timesheet entries that matched the filters but were skipped because they have a running timer
    @jsondata:Name {value: "SkippedTimesheetEntryIDs"}
    int[] skippedTimesheetEntryIDs?;
    # The total the previewed lines would add to the invoice
    @jsondata:Name {value: "TotalAmount"}
    decimal totalAmount?;
    # Non-fatal notices about the preview
    @jsondata:Name {value: "Warnings"}
    string[] warnings?;
};

# Represents the Queries record for the operation: lookupProjects
public type LookupProjectsQueries record {
    # Search term to filter projects by title
    string search?;
    # Page to display. Starts from 1
    int:Signed32 pageNumber?;
    # Number of items per page (max 1000)
    int:Signed32 pageSize?;
    # Filter to the projects that the supplied UserID can add timesheets to
    @http:Query {name: "TimesheetUserID"}
    int:Signed32 timesheetUserID?;
    # Filter by project code
    @http:Query {name: "ProjectCode"}
    string projectCode?;
    # Filter projects by customer company ID
    @http:Query {name: "CompanyIDFK"}
    int:Signed32 companyIDFK?;
};

# The outcome of marking an invoice as Sent
public type MarkInvoiceAsSentResponse record {
    # The Date Sent recorded against the invoice
    @jsondata:Name {value: "DateSent"}
    string dateSent?;
    # The resulting invoice status. Normally "Sent", but zero-amount invoices are set to "Paid"
    @jsondata:Name {value: "TransactionStatusCode"}
    string transactionStatusCode?;
    # Human readable confirmation of what happened
    @jsondata:Name {value: "Message"}
    string message?;
    # The full invoice number including prefix
    @jsondata:Name {value: "InvoiceNumber"}
    string invoiceNumber?;
    # The invoice that was updated
    @jsondata:Name {value: "InvoiceID"}
    int invoiceID?;
};

# An invoice template: the layout, labels, logo and payment options applied when an invoice, estimate or bill is rendered.
# TemplateTypeCode says which document type the template is for: INV and EST templates are used interchangeably on invoices and estimates, BILL templates are for bills only
public type InvoiceTemplateDetails record {
    @jsondata:Name {value: "LabelOverrides"}
    InvoiceTemplateLabelOverrides labelOverrides?;
    # Show the currency on the document
    @jsondata:Name {value: "ShowCurrency"}
    boolean showCurrency?;
    # Street address line of the billing address override
    @jsondata:Name {value: "BillingAddressLine"}
    string billingAddressLine?;
    # Overrides your company's tax number printed when ShowCompanyTaxNumber is on; null uses the account's Company Default Tax Number
    @jsondata:Name {value: "CompanyTaxNumberOverride"}
    string companyTaxNumberOverride?;
    # Overrides the sender address block printed on the document; null uses the account address
    @jsondata:Name {value: "AddressOverride"}
    string addressOverride?;
    # Postal or ZIP code of the billing address override
    @jsondata:Name {value: "BillingAddressPostCode"}
    string billingAddressPostCode?;
    # True when this is the account's default template for new invoices
    @jsondata:Name {value: "DefaultInvoiceTemplate"}
    boolean defaultInvoiceTemplate?;
    # Paper size used when rendering: A4 or USLetter
    @jsondata:Name {value: "ReportPageSize"}
    string reportPageSize?;
    # Show the inventory item column
    @jsondata:Name {value: "ShowInventoryItem"}
    boolean showInventoryItem?;
    # Show the per-line tax column
    @jsondata:Name {value: "ShowTaxColumn"}
    boolean showTaxColumn?;
    # Template name as shown in the Avaza web application. Names are not unique within an account
    @jsondata:Name {value: "Name"}
    string name?;
    # City of the billing address override
    @jsondata:Name {value: "BillingAddressCity"}
    string billingAddressCity?;
    # Public URL of the template logo, or null when no logo is set
    @jsondata:Name {value: "InvoiceLogoURL"}
    string invoiceLogoURL?;
    # Document type the template is for: INV (invoices), EST (estimates) or BILL (bills). INV and EST templates are interchangeable on invoices and estimates
    @jsondata:Name {value: "TemplateTypeCode"}
    string templateTypeCode?;
    # Show the purchase order number
    @jsondata:Name {value: "ShowPONumber"}
    boolean showPONumber?;
    # True when this is the account's default template for new estimates
    @jsondata:Name {value: "DefaultEstimateTemplate"}
    boolean defaultEstimateTemplate?;
    # Online payment providers enabled on this template. Only providers that are also enabled on the account are listed. Empty when none are enabled
    @jsondata:Name {value: "PaymentProviders"}
    InvoiceTemplatePaymentProviderSummary[] paymentProviders?;
    # Show the line item description column
    @jsondata:Name {value: "ShowDescription"}
    boolean showDescription?;
    # Print your company's tax number as the last line of the From block (the To block on bills). The number is CompanyTaxNumberOverride, falling back to the account's Company Default Tax Number; nothing prints when both are blank
    @jsondata:Name {value: "ShowCompanyTaxNumber"}
    boolean showCompanyTaxNumber?;
    # Show tax amounts on the document
    @jsondata:Name {value: "ShowTaxes"}
    boolean showTaxes?;
    # Unique identifier for the template. Use this value for InvoiceTemplateIDFK on invoices and estimates, or BillTemplateIDFK on bills
    @jsondata:Name {value: "InvoiceTemplateID"}
    int:Signed32 invoiceTemplateID?;
    # True when this is the account's default template for new retainer invoices
    @jsondata:Name {value: "DefaultRetainerTemplate"}
    boolean defaultRetainerTemplate?;
    # Show the unit price and quantity columns
    @jsondata:Name {value: "ShowUnitPriceandQty"}
    boolean showUnitPriceandQty?;
    # State or province of the billing address override
    @jsondata:Name {value: "BillingAddressState"}
    string billingAddressState?;
    # True when line items are grouped by type (time, expense, general) on the rendered document
    boolean isInvoiceGrouped?;
    # True when this is the account's default template for new bills
    @jsondata:Name {value: "DefaultBillTemplate"}
    boolean defaultBillTemplate?;
    # True when the BillingAddress* fields below replace the account billing address on the document
    @jsondata:Name {value: "BillingAddressOverride"}
    boolean billingAddressOverride?;
    # ISO country code of the billing address override
    @jsondata:Name {value: "BillingAddressCountryCode"}
    string billingAddressCountryCode?;
    # Overrides the sender company name printed on the document; null uses the account name
    @jsondata:Name {value: "CompanyNameOverride"}
    string companyNameOverride?;
    # Hex colour of the featured header band, e.g. #2f9aea
    @jsondata:Name {value: "FeaturedBackgroundColor1"}
    string featuredBackgroundColor1?;
    # Print the customer's TaxNumber as the last line of the To block (the supplier's, in the From block, on bills). Nothing prints when the customer has no tax number
    @jsondata:Name {value: "ShowCustomerTaxNumber"}
    boolean showCustomerTaxNumber?;
    # Logo resolution in dpi (120 or 300), or null when not set
    @jsondata:Name {value: "InvoiceLogoResolution"}
    int:Signed32 invoiceLogoResolution?;
    # How tax totals are disclosed at the bottom of the document: SingleTaxSubTotal, AllTaxRates, AllTaxComponentRate, NoTax, TaxComponentsNon0 or TaxRateNon0
    @jsondata:Name {value: "InvoiceTaxDisclosureCode"}
    string invoiceTaxDisclosureCode?;
    # File attachment ID of the logo, or null when no logo is set
    @jsondata:Name {value: "InvoiceFileAttachmentIDFK"}
    int invoiceFileAttachmentIDFK?;
    # Title printed at the top of the document, e.g. "Tax Invoice"
    @jsondata:Name {value: "HeaderTitle"}
    string headerTitle?;
    # Show the discount column
    @jsondata:Name {value: "ShowDiscount"}
    boolean showDiscount?;
    # Show the subject line
    @jsondata:Name {value: "ShowSubject"}
    boolean showSubject?;
    # Show the customer contact on the document
    @jsondata:Name {value: "ShowCustomerContact"}
    boolean showCustomerContact?;
    # Payment instructions (bank transfer, BPAY, etc.) enabled on this template. Empty when none are enabled
    @jsondata:Name {value: "PaymentInstructions"}
    InvoiceTemplatePaymentInstructionSummary[] paymentInstructions?;
    # Default notes text pre-filled on new documents that use this template
    @jsondata:Name {value: "DefaultInvoiceNotes"}
    string defaultInvoiceNotes?;
    # Hex colour of the text on the featured header band, e.g. #fff
    @jsondata:Name {value: "FeaturedFontColor1"}
    string featuredFontColor1?;
};

# Represents the Queries record for the operation: listProjectMembers
public type ListProjectMembersQueries record {
    # Get Project members filtered by UserID
    @http:Query {name: "UserID"}
    int:Signed32 userID?;
    # Get Project members filtered by ProjectID
    @http:Query {name: "ProjectID"}
    int:Signed32 projectID?;
