# Request model for creating a new project work schedule booking over a date range
public type CreateBooking record {
    # Possible values are "HoursPerDay" or "TotalDuration"
    @jsondata:Name {value: "DurationType"}
    string durationType?;
    # Hours to allocate per working day
    @jsondata:Name {value: "HoursPerDay"}
    decimal hoursPerDay?;
    # If true, fires the scheduleseries_created webhook event to any subscribed endpoints. Defaults to false to preserve existing integration behaviour
    @jsondata:Name {value: "SendWebhooks"}
    boolean sendWebhooks?;
    # The project to book time against
    @jsondata:Name {value: "ProjectIDFK"}
    int:Signed32 projectIDFK?;
    # Optional task to link the booking to
    @jsondata:Name {value: "TaskIDFK"}
    int:Signed32 taskIDFK?;
    # Optional start time of day for the booking
    @jsondata:Name {value: "StartTime"}
    string startTime?;
    # End date of the booking period
    @jsondata:Name {value: "EndDate"}
    string endDate?;
    # Total hours across the booking (alternative to HoursPerDay)
    @jsondata:Name {value: "TotalDuration"}
    decimal totalDuration?;
    # Start date of the booking period
    @jsondata:Name {value: "StartDate"}
    string startDate?;
    # The timesheet category for the booking
    @jsondata:Name {value: "CategoryIDFK"}
    int:Signed32 categoryIDFK?;
    # The user ID to schedule the booking for
    @jsondata:Name {value: "UserIDFK"}
    int:Signed32 userIDFK?;
    # Whether to include weekends and holidays
    @jsondata:Name {value: "ScheduleOnDaysOff"}
    boolean scheduleOnDaysOff?;
    # Additional notes for the booking
    @jsondata:Name {value: "Notes"}
    string notes?;
};

# Request to flag an existing draft invoice as Sent, without emailing it to the customer
public type MarkInvoiceAsSentRequest record {
    # Optional Date Sent to record against the invoice (ISO 8601, e.g. 2026-08-17). Defaults to today
    # in your user profile's timezone. Cannot be more than one day in the future
    @jsondata:Name {value: "DateSent"}
    string dateSent?;
    # If true, fires the invoice_sent webhook event to any subscribed endpoints. Defaults to false to preserve existing integration behaviour
    @jsondata:Name {value: "SendWebhooks"}
    boolean sendWebhooks?;
    # The ID of the invoice to mark as Sent. Must be a Draft invoice belonging to your account
    @jsondata:Name {value: "InvoiceID"}
    int invoiceID;
};

# Represents the Queries record for the operation: submitTimesheets
public type SubmitTimesheetsQueries record {
    # A date (yyyy-MM-dd) that falls within a week to have all timesheets in that week submitted. Respects the First Day of Week setting in your account Timesheet Settings to determine the week range
    @http:Query {name: "WholeWeekOf"}
    string wholeWeekOf?;
    @http:Query {name: "SendWebhooks"}
    boolean sendWebhooks?;
    # The user to submit timesheets for. Defaults to current user. Only allowed to be different from the current user when the current user has rights to Impersonate other users
    @http:Query {name: "UserID"}
    int:Signed32 userID?;
    # A date (yyyy-MM-dd) to submit all timesheets on this day
    @http:Query {name: "WholeDayOf"}
    string wholeDayOf?;
    # Send email alerts to timesheet approvers. Defaults to true
    @http:Query {name: "SendNotifications"}
    boolean sendNotifications?;
};

# A customer invoice including line items, status, amounts, issuer/recipient details, and web links
public type Invoice record {
    # Exchange rate to the account's base currency. 1.0 if same currency
    @jsondata:Name {value: "ExchangeRate"}
    decimal exchangeRate?;
    @jsondata:Name {value: "Issuer"}
    IssuerDetails issuer?;
    # Date and time the record was created
    @jsondata:Name {value: "DateCreated"}
    string dateCreated?;
    # Unique identifier for the invoice transaction
    @jsondata:Name {value: "TransactionID"}
    int transactionID?;
    # Prefix used in the invoice number (e.g. 'INV')
    @jsondata:Name {value: "TransactionPrefix"}
    string transactionPrefix?;
    # ISO 3-character currency code for the invoice
    @jsondata:Name {value: "CurrencyCode"}
    string currencyCode?;
    # Name of the customer company
    @jsondata:Name {value: "CompanyName"}
    string companyName?;
    # Customer's purchase order number for reference
    @jsondata:Name {value: "CustomerPONumber"}
    string customerPONumber?;
    # The external contact user ID associated with this invoice
    @jsondata:Name {value: "ExternalContactUserIDFK"}
    int:Signed32 externalContactUserIDFK?;
    # Total tax amount across all line items
    @jsondata:Name {value: "TaxAmount"}
    decimal taxAmount?;
    # Current status. Values: Draft, Sent, Late, Paid, Partial, Void
    @jsondata:Name {value: "TransactionStatusCode"}
    string transactionStatusCode?;
    # The full invoice number including prefix
    @jsondata:Name {value: "InvoiceNumber"}
    string invoiceNumber?;
    # Payment due date
    @jsondata:Name {value: "DueDate"}
    string dueDate?;
    # Additional notes or comments on the invoice
    @jsondata:Name {value: "Notes"}
    string notes?;
    # Line items on this invoice
    @jsondata:Name {value: "LineItems"}
    InvoiceLineItem[] lineItems?;
    # Date and time the record was last updated
    @jsondata:Name {value: "DateUpdated"}
    string dateUpdated?;
    # The Avaza account this invoice belongs to
    @jsondata:Name {value: "AccountIDFK"}
    int:Signed32 accountIDFK?;
    @jsondata:Name {value: "Recipient"}
    RecipientDetails recipient?;
    # The customer company ID this invoice is for
    @jsondata:Name {value: "CompanyIDFK"}
    int:Signed32 companyIDFK?;
    # Total amount of the invoice including tax
    @jsondata:Name {value: "TotalAmount"}
    decimal totalAmount?;
    # Subject line for the invoice
    @jsondata:Name {value: "Subject"}
    string subject?;
    # Date the invoice was issued
    @jsondata:Name {value: "DateIssued"}
    string dateIssued?;
    # Date the invoice was sent to the customer
    @jsondata:Name {value: "DateSent"}
    string dateSent?;
    @jsondata:Name {value: "Links"}
    InvoiceLinks links?;
    # Outstanding balance remaining on the invoice
    @jsondata:Name {value: "Balance"}
    decimal balance?;
    # Tax configuration: 'EX' (exclusive) or 'INC' (inclusive)
    @jsondata:Name {value: "TransactionTaxConfigCode"}
    string transactionTaxConfigCode?;
};

# A task type definition (workflow type) with name, icon, and default flag
public type AccountTaskTypeDetails record {
    # Whether this is the default task type for new tasks
    boolean isDefault?;
    # Unique identifier for the task type
    @jsondata:Name {value: "AccountTaskTypeID"}
    int:Signed32 accountTaskTypeID?;
    # Icon identifier for the task type
    @jsondata:Name {value: "Icon"}
    string icon?;
    # Type/category of the icon
    @jsondata:Name {value: "IconType"}
    string iconType?;
    # Display name of the task type
    @jsondata:Name {value: "Name"}
    string name?;
};

# Request model for creating a new customer payment. Optionally include allocations to invoices
public type NewPayment record {
    # Optional to override the default prefix added to Payment Numbers
    @jsondata:Name {value: "TransactionPrefix"}
    string transactionPrefix?;
    # Only required if no invoice allocations specified
    @jsondata:Name {value: "CustomerIDFK"}
    int:Signed32 customerIDFK?;
    # Optional. Only used when the Customer's currecy is different from the Avaza account's base currency. Specifies the exchange rate that should apply between the customer currency and base currency. If not provided we will obtain an up to date exchange rate for the Payment Issue Date
    @jsondata:Name {value: "ExchangeRate"}
    decimal exchangeRate?;
    # List of amounts within this payment that are allocated to invoices. The sum of these be less than or equal to the payment amount
    @jsondata:Name {value: "PaymentAllocations"}
    NewPaymentAllocation[] paymentAllocations?;
    # Date of Payment. If not specified, assumes today
    @jsondata:Name {value: "DateIssued"}
    string dateIssued?;
    # Optional for storing the reference # of the payment method
    @jsondata:Name {value: "TransactionReference"}
    string transactionReference?;
    # Optional for storing the payment provider who was the source of funds
    @jsondata:Name {value: "PaymentProviderCode"}
    string paymentProviderCode?;
    # If true, fires the invoice_updated webhook event for each invoice that was allocated against. Defaults to false to preserve existing integration behaviour
    @jsondata:Name {value: "SendWebhooks"}
    boolean sendWebhooks?;
    # Total amount of the payment
    @jsondata:Name {value: "Amount"}
    decimal amount?;
    # Optional. If not specified will be automatically generated
    @jsondata:Name {value: "PaymentNumber"}
    string paymentNumber?;
    @jsondata:Name {value: "Notes"}
    string notes?;
};

# An active custom field definition mapped to an entity type. Definitions are managed by account admins in Avaza settings and are read-only via the API
public type CustomFieldDefinitionDetails record {
    # Number of decimal places displayed for numeric types
    @jsondata:Name {value: "DecimalPlaces"}
    int:Signed32 decimalPlaces?;
    # Unique identifier for the custom field definition
    @jsondata:Name {value: "CustomFieldDefinitionID"}
    int:Signed32 customFieldDefinitionID?;
    # Whether a value is required when creating records of this entity type
    boolean isRequired?;
    # Active options for Dropdown fields, in display order. Empty for other data types
    @jsondata:Name {value: "Options"}
    CustomFieldOptionDetails[] options?;
    # Optional description / help text for the field
    @jsondata:Name {value: "Description"}
    string description?;
    # Whether the field allows multiple selections (Dropdown and User types only)
    boolean isMultiSelect?;
    # Unit suffix displayed after Number values (e.g. "km"), when configured
    @jsondata:Name {value: "UnitLabel"}
    string unitLabel?;
    # Data type of the field. Values: ShortText, LongText, Number, Percentage, Currency, Duration, Date, Checkbox, Dropdown, User, Location
    @jsondata:Name {value: "DataTypeCode"}
    string dataTypeCode?;
    # Field visibility. "Internal" = team members only; "Everyone" = also visible to external contacts
    @jsondata:Name {value: "VisibilityCode"}
    string visibilityCode?;
    # Display name of the custom field
    @jsondata:Name {value: "Name"}
    string name?;
};

# Represents the Queries record for the operation: deleteEstimate
public type DeleteEstimateQueries record {
    # If true, fires the estimate_deleted webhook to subscribed endpoints. Defaults to false
    boolean SendWebhooks?;
    # The ID of the estimate to delete, supplied in the query string
    int EstimateID?;
};

# File metadata bound into a signed upload URL
public type FileAttachmentUploadFileInfo record {
    # Declared size in bytes, when the caller supplied one
    @jsondata:Name {value: "Size"}
    int size?;
    # MIME type that will be stored
    @jsondata:Name {value: "MimeType"}
    string mimeType?;
    # Filename that will be stored (sanitised)
    @jsondata:Name {value: "Name"}
    string name?;
};

# Response from POST /api/FileAttachment/Upload: a single-use, time-limited upload URL plus the file metadata the server will apply. Shaped after the MCP file-transfer descriptor (SEP-2631) so MCP clients can map it directly
public type FileAttachmentUploadAuthorization record {
    @jsondata:Name {value: "Upload"}
    FileAttachmentUploadTransfer upload?;
    @jsondata:Name {value: "LinkedTo"}
    FileAttachmentLinkTarget linkedTo?;
    @jsondata:Name {value: "File"}
    FileAttachmentUploadFileInfo file?;
    # Largest body the PUT will accept, in bytes
    @jsondata:Name {value: "MaxSizeBytes"}
    int maxSizeBytes?;
};

# One custom field value to set on a Task, Project, Team Member (UserProfile), Contact or Company. Identify the field by
# CustomFieldDefinitionID (preferred) or by Name (case-insensitive). Custom field
# definitions and options can never be created or modified via the API — values only
# (see GET /api/CustomFieldDefinition for the account's definitions)
public type CustomFieldValueInput record {
    # The custom field definition ID to set (preferred identifier; see GET /api/CustomFieldDefinition)
    @jsondata:Name {value: "CustomFieldDefinitionID"}
    int:Signed32 customFieldDefinitionID?;
    # The value to set. Accepted formats by data type: text = string; Number/Percentage/Currency = JSON number or numeric string;
    # Duration = number (decimal hours) or "h:mm" string; Date = "yyyy-MM-dd" string; Checkbox = boolean;
    # Dropdown (single) = option name string or option id number; User (single) = UserID number or email string;
    # Location = "lat,lng" string. Pass null (with no Values) to clear the field
    @jsondata:Name {value: "Value"}
    record {} value?;
    # Multi-select fields only (Dropdown/User with isMultiSelect): the complete new selection as an array of option names/ids or user ids/emails. REPLACES the existing selection. An empty array clears the field
    @jsondata:Name {value: "Values"}
    record {}[] values?;
    # The custom field name (case-insensitive) — an alternative to CustomFieldDefinitionID
    @jsondata:Name {value: "Name"}
    string name?;
};

# Collection of tax rates configured in the account
public type TaxList record {
    # The list of tax rates configured in the Avaza account
    @jsondata:Name {value: "Taxes"}
    TaxItem[] taxes?;
};

# A tag to apply to a task, specifying name and hex color code
public type NewTag record {
    # Hex color code in format #000000
    @jsondata:Name {value: "Color"}
    string color?;
    # Tag name
    @jsondata:Name {value: "Name"}
    string name?;
};

# URLs for viewing and editing a bill in the Avaza web application
public type BillLinks record {
