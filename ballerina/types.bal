# Request model for creating a new customer company
public type NewCompany record {
    # Label printed next to the tax number on invoices, e.g. "VAT No.", "USt-IdNr.", "ABN" (max 100 chars). Null uses the invoice template's default label or "Tax Number"
    @jsondata:Name {value: "TaxNumberLabel"}
    string taxNumberLabel?;
    # The street address line for the company's billing address
    @jsondata:Name {value: "BillingAddressLine"}
    string billingAddressLine?;
    # The company's website URL
    string website?;
    # The state or province for the company's billing address
    @jsondata:Name {value: "BillingAddressState"}
    string billingAddressState?;
    # If true, fires the company_created webhook event to any subscribed endpoints. Defaults to false to preserve existing integration behaviour
    @jsondata:Name {value: "SendWebhooks"}
    boolean sendWebhooks?;
    # Internal notes or comments about the company
    @jsondata:Name {value: "Comments"}
    string comments?;
    # The ISO 2-letter country code for the company's billing address
    @jsondata:Name {value: "BillingCountryCode"}
    string billingCountryCode?;
    # The postcode or ZIP code for the company's billing address
    @jsondata:Name {value: "BillingAddressPostCode"}
    string billingAddressPostCode?;
    # The city for the company's billing address
    @jsondata:Name {value: "BillingAddressCity"}
    string billingAddressCity?;
    # The default currency code for this company. Defaults to the account's default currency if not provided
    @jsondata:Name {value: "CurrencyCode"}
    string currencyCode?;
    # The full formatted billing address string. If set, overrides the individual address fields
    @jsondata:Name {value: "BillingAddress"}
    string billingAddress?;
    # The name of the company. Required
    @jsondata:Name {value: "CompanyName"}
    string companyName;
    # Custom field values to set on the new company. Identify each item by CustomFieldDefinitionID (preferred) or Name (case-insensitive). Fields not supplied receive their configured default values; required fields without a default must be supplied. Custom field definitions/options cannot be created or modified via the API
    @jsondata:Name {value: "CustomFields"}
    CustomFieldValueInput[] customFields?;
    # The company's primary phone number
    @jsondata:Name {value: "Phone"}
    string phone?;
    # The company's tax registration number
    @jsondata:Name {value: "TaxNumber"}
    string taxNumber?;
    # The company's fax number
    @jsondata:Name {value: "Fax"}
    string fax?;
};

# A customer company and its associated projects, used in the project dropdown list
public type ProjectCompanyGroup record {
