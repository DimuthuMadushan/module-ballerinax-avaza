public type ProjectSectionDetails record {
    # Planned start date for the section
    @jsondata:Name {value: "StartDate"}
    string startDate?;
    # Sort order position for display
    @jsondata:Name {value: "DisplayOrder"}
    int:Signed32 displayOrder?;
    # Section title/name
    @jsondata:Name {value: "Title"}
    string title?;
    # Unique identifier for the section
    @jsondata:Name {value: "SectionID"}
    int:Signed32 sectionID?;
    # Planned end date for the section
    @jsondata:Name {value: "EndDate"}
    string endDate?;
};

# A customer or supplier company record with billing address, contacts, and financial settings
public type Company record {
    # Label printed next to the tax number on invoices, e.g. "VAT No.", "USt-IdNr.", "ABN" (max 100 chars). Null uses the invoice template's default label or "Tax Number"
    @jsondata:Name {value: "TaxNumberLabel"}
    string taxNumberLabel?;
    # The first line of the company's billing address (street address)
    @jsondata:Name {value: "BillingAddressLine"}
    string billingAddressLine?;
    # The company's website URL
    string website?;
    # The state or province of the company's billing address
    @jsondata:Name {value: "BillingAddressState"}
    string billingAddressState?;
    # The unique identifier of the company
    @jsondata:Name {value: "CompanyID"}
    int:Signed32 companyID?;
    # Internal notes or comments about the company
    @jsondata:Name {value: "Comments"}
    string comments?;
    # The UTC date and time when the company record was last updated
    @jsondata:Name {value: "DateUpdated"}
    string dateUpdated?;
    # The ID of the default trading terms applied to invoices for this company
    @jsondata:Name {value: "DefaultTradingTermIDFK"}
    int:Signed32 defaultTradingTermIDFK?;
    # The ISO 2-letter country code for the company's billing address
    @jsondata:Name {value: "BillingCountryCode"}
    string billingCountryCode?;
    # The UTC date and time when the company record was created
    @jsondata:Name {value: "DateCreated"}
    string dateCreated?;
    # The postcode or ZIP code of the company's billing address
    @jsondata:Name {value: "BillingAddressPostCode"}
    string billingAddressPostCode?;
    # The city of the company's billing address
    @jsondata:Name {value: "BillingAddressCity"}
    string billingAddressCity?;
    # The full formatted billing address string. If set, overrides the individual address fields
    @jsondata:Name {value: "BillingAddress"}
    string billingAddress?;
    # The default currency code used for invoices and transactions with this company
    @jsondata:Name {value: "CurrencyCode"}
    string currencyCode?;
    # The display name of the company
    @jsondata:Name {value: "CompanyName"}
    string companyName?;
    # Custom field values set on this company, in display order. Fields with no value are not included. Omitted entirely when the account's Custom Fields feature is disabled (external contact tokens only see fields with "Everyone" visibility). See GET /api/CustomFieldDefinition for the account's field definitions
    @jsondata:Name {value: "CustomFields"}
    CustomFieldValueItem[] customFields?;
    # The list of external contacts associated with this company
    @jsondata:Name {value: "Contacts"}
    CompanyContact[] contacts?;
    # The company's primary phone number
    @jsondata:Name {value: "Phone"}
    string phone?;
    # URL to view this company in the Avaza web application
    @jsondata:Name {value: "ViewCompanyURL"}
    string viewCompanyURL?;
    # The company's tax registration number
    @jsondata:Name {value: "TaxNumber"}
    string taxNumber?;
    # The company's fax number
    @jsondata:Name {value: "Fax"}
    string fax?;
};

# Paginated collection of customer companies with full details
public type CompanyList record {
    # Total number of companies matching the query
    @jsondata:Name {value: "TotalCount"}
    int:Signed32 totalCount?;
    # The number of results per page
    @jsondata:Name {value: "PageSize"}
    int:Signed32 pageSize?;
    # The current page number (1-based)
    @jsondata:Name {value: "PageNumber"}
    int:Signed32 pageNumber?;
    # The list of companies for the current page
    @jsondata:Name {value: "Companies"}
    Company[] companies?;
};

# Request body for approving a batch of timesheet entries by their IDs
public type TimesheetApprovalRequest record {
    # (Required) List of TimeSheetEntryIDs to approve. 1-500 unique positive integers
    @jsondata:Name {value: "TimeSheetEntryIDs"}
    int[] timeSheetEntryIDs?;
    # (Optional) Free-text approval note. Max 1000 characters. Currently accepted but not persisted
    @jsondata:Name {value: "ApprovalNote"}
    string approvalNote?;
};

public type ExpenseAttachmentBody record {
    # Upload software package
    @jsondata:Name {value: "File"}
    record {byte[] fileContent; string fileName;} file;
};

# A customer credit note with line items and allocations to invoices
public type CreditNote record {
    # The full credit note number including prefix
    @jsondata:Name {value: "CreditNoteNumber"}
    string creditNoteNumber?;
    # URL to view this credit note in the Avaza web application
    @jsondata:Name {value: "ViewCreditNoteURL"}
    string viewCreditNoteURL?;
    # Date and time the record was last updated
    @jsondata:Name {value: "DateUpdated"}
    string dateUpdated?;
    # Line items on this credit note
    @jsondata:Name {value: "CreditNoteLineItems"}
    CreditNoteLineItem[] creditNoteLineItems?;
    # Date and time the record was created
    @jsondata:Name {value: "DateCreated"}
    string dateCreated?;
    # Total credit note amount
    @jsondata:Name {value: "TotalAmount"}
    decimal totalAmount?;
    # Unique identifier for the credit note transaction
    @jsondata:Name {value: "TransactionID"}
    int transactionID?;
    # Prefix used in the credit note number
    @jsondata:Name {value: "TransactionPrefix"}
    string transactionPrefix?;
    # ISO 3-character currency code for the credit note
    @jsondata:Name {value: "CurrencyCode"}
    string currencyCode?;
    # The customer company ID this credit note is issued to
    @jsondata:Name {value: "CustomerIDFK"}
    int:Signed32 customerIDFK?;
    # The date the credit note was issued
    @jsondata:Name {value: "DateIssued"}
    string dateIssued?;
    # Current status of the credit note
    @jsondata:Name {value: "TransactionStatusCode"}
    string transactionStatusCode?;
    # List of allocations applying this credit note against invoices
    @jsondata:Name {value: "CreditNoteAllocations"}
    CreditNoteAllocation[] creditNoteAllocations?;
    # Unallocated balance remaining on the credit note
    @jsondata:Name {value: "Balance"}
    decimal balance?;
    # Additional notes on the credit note
    @jsondata:Name {value: "Notes"}
    string notes?;
};

# A timesheet entry in a list response, including user, project, category, duration, status, timer state, and optional invoice linkage
public type TimesheetListDetails record {
    # The section ID of the task this entry is linked to
    @jsondata:Name {value: "SectionIDFK"}
    int:Signed32 sectionIDFK?;
    # Email address of the timesheet user
    @jsondata:Name {value: "Email"}
    string email?;
    # The UTC start time of the entry, if start/end time tracking is enabled
    @jsondata:Name {value: "StartTimeUTC"}
    string startTimeUTC?;
    # The project ID this timesheet entry is associated with
    @jsondata:Name {value: "ProjectIDFK"}
    int:Signed32 projectIDFK?;
    # Whether this timesheet entry has been included on an invoice
    boolean isInvoiced?;
    # The local end time of the entry, if start/end time tracking is enabled
    @jsondata:Name {value: "EndTimeLocal"}
    string endTimeLocal?;
    # Date and time the record was created (UTC)
    @jsondata:Name {value: "DateCreated"}
    string dateCreated?;
    # Only visible to Admin role users
    @jsondata:Name {value: "RateAmount"}
    decimal rateAmount?;
    # The timesheet category ID applied to this entry
    @jsondata:Name {value: "TimesheetCategoryIDFK"}
    int:Signed32 timesheetCategoryIDFK?;
    # The UTC end time of the entry, if start/end time tracking is enabled
    @jsondata:Name {value: "EndTimeUTC"}
    string endTimeUTC?;
    # URL to view this timesheet entry's day in the Avaza web application
    @jsondata:Name {value: "ViewTimesheetURL"}
    string viewTimesheetURL?;
    # The IANA time zone ID of the user who owns the timesheet
    @jsondata:Name {value: "TimesheetUserTimeZone"}
    string timesheetUserTimeZone?;
    # Unique identifier for the timesheet entry
    @jsondata:Name {value: "TimesheetEntryID"}
    int timesheetEntryID?;
    # The invoice line item ID this entry was billed on, if invoiced
    @jsondata:Name {value: "InvoiceLineItemIDFK"}
    int invoiceLineItemIDFK?;
    # Only visible to Admin role users
    @jsondata:Name {value: "CostAmount"}
    decimal costAmount?;
    # Project code of the associated project, if project codes are enabled
    @jsondata:Name {value: "ProjectCode"}
    string projectCode?;
    # Name of the customer/company associated with the project
    @jsondata:Name {value: "CustomerName"}
    string customerName?;
    # The UTC date and time at which the timer was started, if a timer is running
    @jsondata:Name {value: "TimerStartedAtUTC"}
    string timerStartedAtUTC?;
    # Free-text notes attached to this timesheet entry
    @jsondata:Name {value: "Notes"}
    string notes?;
    # Title of the section the linked task belongs to
    @jsondata:Name {value: "SectionTitle"}
    string sectionTitle?;
    # Date and time the record was last updated (UTC)
    @jsondata:Name {value: "DateUpdated"}
    string dateUpdated?;
    # The task ID this timesheet entry is linked to, if any
    @jsondata:Name {value: "TaskIDFK"}
    int:Signed32 taskIDFK?;
    # Last name of the timesheet user
    @jsondata:Name {value: "Lastname"}
    string lastname?;
    # Title of the task this entry is linked to
    @jsondata:Name {value: "TaskTitle"}
    string taskTitle?;
    # Duration of the timesheet entry in decimal hours
    @jsondata:Name {value: "Duration"}
    decimal duration?;
    # Whether this timesheet entry is billable to the client
    boolean isBillable?;
    # This InvoiceIDFK is only included when the api get parameter includeInvoiceDetails==true
    @jsondata:Name {value: "InvoiceIDFK"}
    int invoiceIDFK?;
    # First name of the timesheet user
    @jsondata:Name {value: "Firstname"}
    string firstname?;
    # The customer/company ID associated with the project
    @jsondata:Name {value: "CustomerIDFK"}
    int:Signed32 customerIDFK?;
    # Title of the associated project
    @jsondata:Name {value: "ProjectTitle"}
    string projectTitle?;
    # Whether a timer is currently running on this entry
    @jsondata:Name {value: "HasTimer"}
    boolean hasTimer?;
    # The local start time of the entry, if start/end time tracking is enabled
    @jsondata:Name {value: "StartTimeLocal"}
    string startTimeLocal?;
    # Name or email of the user who approved this entry
    @jsondata:Name {value: "ApprovedBy"}
    string approvedBy?;
    # The date of the timesheet entry
    @jsondata:Name {value: "EntryDate"}
    string entryDate?;
    # The ID of the user who owns this timesheet entry
    @jsondata:Name {value: "UserIDFK"}
    int:Signed32 userIDFK?;
    # Name of the timesheet category applied to this entry
    @jsondata:Name {value: "CategoryName"}
    string categoryName?;
    # Approval status of the entry. Values: Draft, Pending, Approved, Rejected, AutoApproved
    @jsondata:Name {value: "TimesheetEntryApprovalStatusCode"}
    string timesheetEntryApprovalStatusCode?;
    # Date and time the entry was approved, if applicable
    @jsondata:Name {value: "DateApproved"}
    string dateApproved?;
    # Optional free-form metadata field for storing additional information. Maximum 1000 characters
    @jsondata:Name {value: "CustomMetadata"}
    string customMetadata?;
};

# A line item to be added to a new supplier bill
public type NewBillLineItem record {
    # If not specified then Inventory item ID must be specified. If specified and not matched to any existing inventory items then a new inventory item will be created. Max 200 characters
    @jsondata:Name {value: "InventoryItemName"}
    string inventoryItemName?;
    # The unit price for the lineitem
    @jsondata:Name {value: "UnitPrice"}
    decimal unitPrice;
    # Plain UTF8 text. (no HTML)
    @jsondata:Name {value: "Description"}
    string description?;
    # Enter 10.5 to give a 10.5% discount
    @jsondata:Name {value: "Discount"}
    decimal discount?;
    # If specified then it must match an existing Tax ID. If not specified then Tax Name and Tax Percent must be specified
    @jsondata:Name {value: "TaxIDFK"}
    int:Signed32 taxIDFK?;
    # Must be specified if the Tax ID is blank. If the Tax Name is specified it will be matched to an existing Tax Name or else a new Tax will be created
    @jsondata:Name {value: "TaxName"}
    string taxName?;
    # Optional. Project ID of an Avaza Project that belongs to this customer, so line item is attributed to that Project for reporting
    @jsondata:Name {value: "ProjectIDFK"}
    int:Signed32 projectIDFK?;
    # If not specified then Inventory Item Name must be specified
    @jsondata:Name {value: "InventoryItemIDFK"}
    int:Signed32 inventoryItemIDFK?;
    # The quantity for the line item
    @jsondata:Name {value: "Quantity"}
    decimal quantity;
    # The Tax Percent will only be used if a new tax is being created
    @jsondata:Name {value: "TaxPercent"}
    decimal taxPercent?;
};

# Request model for updating an existing leave schedule booking
public type EditLeave record {
    # Start date of the leave period
    @jsondata:Name {value: "StartDate"}
    string startDate?;
    # The leave type ID (e.g. Annual Leave, Sick Leave)
    @jsondata:Name {value: "LeaveTypeIDFK"}
    int:Signed32 leaveTypeIDFK?;
    # The Schedule Series ID to update
    @jsondata:Name {value: "ScheduleSeriesID"}
    int scheduleSeriesID?;
    # Hours of leave per day
    @jsondata:Name {value: "HoursPerDay"}
    decimal hoursPerDay?;
    # If true, fires the scheduleseries_updated webhook event to any subscribed endpoints. Defaults to false to preserve existing integration behaviour
    @jsondata:Name {value: "SendWebhooks"}
    boolean sendWebhooks?;
    # Optional start time for partial-day leave
    @jsondata:Name {value: "StartTime"}
    string startTime?;
    # The user ID this leave is for
    @jsondata:Name {value: "UserIDFK"}
    int:Signed32 userIDFK?;
    # End date of the leave period
    @jsondata:Name {value: "EndDate"}
    string endDate?;
    # Additional notes for the leave entry
    @jsondata:Name {value: "Notes"}
    string notes?;
};

# A project team member with their role permissions, rates, budget, and timesheet settings
public type ProjectMemberDetails record {
    # Whether this member's timesheets require approval
    boolean isTimesheetApprovalRequired?;
    # Whether this member can update tasks in this project
    boolean canUpdateTasks?;
    # Member's email address
    @jsondata:Name {value: "Email"}
    string email?;
    # Member's full display name
    @jsondata:Name {value: "Fullname"}
    string fullname?;
    # The project this membership belongs to
    @jsondata:Name {value: "ProjectIDFK"}
    int:Signed32 projectIDFK?;
    # Member's last name
    @jsondata:Name {value: "Lastname"}
    string lastname?;
    # Whether this member can approve timesheets on this project
    boolean isTimesheetApprover?;
    # Bill rate per hour for this member on this project
    @jsondata:Name {value: "RateAmount"}
    decimal rateAmount?;
    # Budget amount allocated to this member on this project
    @jsondata:Name {value: "BudgetAmount"}
    decimal budgetAmount?;
    # Whether this member's access to the project is disabled
    boolean isMemberDisabled?;
    # Member's first name
    @jsondata:Name {value: "Firstname"}
    string firstname?;
    # Whether this member can delete tasks in this project
    boolean canDeleteTasks?;
    # Whether this member can comment on tasks in this project
    boolean canCommentOnTasks?;
    # Cost rate per hour for this member on this project
    @jsondata:Name {value: "CostAmount"}
    decimal costAmount?;
    # Whether this member can create tasks in this project
    boolean canCreateTasks?;
    # The user ID of the project member
    @jsondata:Name {value: "UserIDFK"}
    int:Signed32 userIDFK?;
    # Whether this member can log timesheets to this project
    boolean isTimesheetAllowed?;
};

# A tag applied to a user for categorisation, with tag ID and name
public type UserTagDetails record {
    # Unique identifier for the user tag
    @jsondata:Name {value: "UserTagID"}
    int:Signed32 userTagID?;
    # Display name of the user tag
    @jsondata:Name {value: "UserTagName"}
    string userTagName?;
};

# A fixed-amount billing entry for fixed-price project invoicing, linked to a project, task, and inventory item
public type FixedAmountDetails record {
    # Date the record was last updated
    @jsondata:Name {value: "DateUpdated"}
    string dateUpdated?;
    # User ID of the last person to update this record
    @jsondata:Name {value: "UpdatedByUserIDFK"}
    int:Signed32 updatedByUserIDFK?;
    # The project this fixed amount is linked to
    @jsondata:Name {value: "ProjectIDFK"}
    int:Signed32 projectIDFK?;
    # The task this fixed amount is linked to, if any
    @jsondata:Name {value: "TaskIDFK"}
    int:Signed32 taskIDFK?;
    # The fixed billing amount
    @jsondata:Name {value: "Amount"}
    decimal amount?;
    # The inventory item used for this fixed amount
    @jsondata:Name {value: "InventoryItemIDFK"}
    int inventoryItemIDFK?;
    # Whether this fixed amount has been included on an invoice
    boolean isInvoiced?;
    # Title of the associated task
    @jsondata:Name {value: "TaskTitle"}
    string taskTitle?;
    # Date the record was created
    @jsondata:Name {value: "DateCreated"}
    string dateCreated?;
    # The invoice (Transaction) the linked line item belongs to. Only populated when includeInvoiceDetails=true
    @jsondata:Name {value: "InvoiceIDFK"}
    int invoiceIDFK?;
    # Name of the inventory item
    @jsondata:Name {value: "InventoryItemName"}
    string inventoryItemName?;
    # ID of the customer company the fixed amount's project belongs to
    @jsondata:Name {value: "CustomerIDFK"}
    int:Signed32 customerIDFK?;
    # Title of the associated project
    @jsondata:Name {value: "ProjectTitle"}
    string projectTitle?;
    # The invoice line item this fixed amount is linked to, if it has been invoiced
    @jsondata:Name {value: "InvoiceLineItemIDFK"}
    int invoiceLineItemIDFK?;
    # Short code of the associated project
    @jsondata:Name {value: "ProjectCode"}
    string projectCode?;
    # Unique identifier for the fixed amount entry
    @jsondata:Name {value: "FixedAmountID"}
    int:Signed32 fixedAmountID?;
    # Additional notes on the fixed amount
    @jsondata:Name {value: "Notes"}
    string notes?;
};

# A file attachment linked to a task
public type TaskFileAttachmentItem record {
    # Public URL to download the file
    @jsondata:Name {value: "AttachmentURL"}
    string attachmentURL?;
    # URL for in-browser preview of the file. Empty for non-previewable file types
    @jsondata:Name {value: "AttachmentPreviewURL"}
    string attachmentPreviewURL?;
    # Foreign key to the FileAttachment record
    @jsondata:Name {value: "FileAttachmentIDFK"}
    int fileAttachmentIDFK?;
};

# A user/team member record with profile information, availability hours, billing rates, roles, and tags
public type UserDetails record {
    # Available working hours on Tuesdays
    @jsondata:Name {value: "TuesdayAvailableHours"}
    decimal tuesdayAvailableHours?;
    # User's email address
    @jsondata:Name {value: "Email"}
    string email?;
    # User's job title or position
    @jsondata:Name {value: "PositionTitle"}
    string positionTitle?;
    # The user's default billing rate per hour
    @jsondata:Name {value: "DefaultBillableRate"}
    decimal defaultBillableRate?;
    # Available working hours on Wednesdays
    @jsondata:Name {value: "WednesdayAvailableHours"}
    decimal wednesdayAvailableHours?;
    # Name of the user's associated company
    @jsondata:Name {value: "CompanyName"}
    string companyName?;
    # Whether the user is an internal team member (true) or external contact (false)
    boolean isTeamMember?;
    # Unique identifier for the user
    @jsondata:Name {value: "UserID"}
    int:Signed32 userID?;
    # User's phone number
    @jsondata:Name {value: "Phone"}
    string phone?;
    # The user's default cost rate per hour
    @jsondata:Name {value: "DefaultCostRate"}
    decimal defaultCostRate?;
    # Available working hours on Saturdays
    @jsondata:Name {value: "SaturdayAvailableHours"}
    decimal saturdayAvailableHours?;
    # List of tags applied to the user for categorisation
    @jsondata:Name {value: "Tags"}
    UserTagDetails[] tags?;
    # User's last name
    @jsondata:Name {value: "Lastname"}
    string lastname?;
    # The Avaza account this user belongs to
    @jsondata:Name {value: "AccountIDFK"}
    int:Signed32 accountIDFK?;
    # List of security roles assigned to the user
    @jsondata:Name {value: "Roles"}
    RoleDetails[] roles?;
    # The company the user is associated with (for external contacts)
    @jsondata:Name {value: "CompanyIDFK"}
    int:Signed32 companyIDFK?;
    # The user's initials, shown wherever no profile picture is set (1-3 characters, editable by the user)
    @jsondata:Name {value: "Initials"}
    string initials?;
    # User's mobile phone number
    @jsondata:Name {value: "Mobile"}
    string mobile?;
    # Available working hours on Thursdays
    @jsondata:Name {value: "ThursdayAvailableHours"}
    decimal thursdayAvailableHours?;
    # User's first name
    @jsondata:Name {value: "Firstname"}
    string firstname?;
    # Available working hours on Mondays
    @jsondata:Name {value: "MondayAvailableHours"}
    decimal mondayAvailableHours?;
    # Windows Timezone ID
    @jsondata:Name {value: "TimeZone"}
    string timeZone?;
    # Custom field values set on this user, in display order (Team Member custom fields for team members, Contact custom fields for customer contacts). Fields with no value are not included. Omitted entirely when the account's Custom Fields feature is disabled (external contact tokens only see fields with "Everyone" visibility). See GET /api/CustomFieldDefinition for the account's field definitions
    @jsondata:Name {value: "CustomFields"}
    CustomFieldValueItem[] customFields?;
    # Public URL of the user's profile picture (512x512 JPEG), or null when the user has no picture. Read only
    @jsondata:Name {value: "ProfilePicURL"}
    string profilePicURL?;
    # IANA tz database timezone name
    @jsondata:Name {value: "IANATimezone"}
    string iANATimezone?;
    # Available working hours on Sundays
    @jsondata:Name {value: "SundayAvailableHours"}
    decimal sundayAvailableHours?;
    # Available working hours on Fridays
    @jsondata:Name {value: "FridayAvailableHours"}
    decimal fridayAvailableHours?;
};

# Represents the Queries record for the operation: completeFileAttachmentUpload
public type CompleteFileAttachmentUploadQueries record {
    # The signed upload token from the authorised URL
    string token?;
};

# Represents the Queries record for the operation: startTimer
public type StartTimerQueries record {
    @http:Query {name: "SendWebhooks"}
    boolean sendWebhooks?;
    # Optional - User ID number if impersonating a different user. Otherwise assumes the current user. Only users with certain security roles have permission to impersonate other users
    @http:Query {name: "UserID"}
    int:Signed32 userID?;
};

# One expense history entry: who did what, when
public type ExpenseHistoryItem record {
    # Display name of the action, e.g. "Created", "Receipt read by AI"
    @jsondata:Name {value: "ActionName"}
    string actionName?;
    # Action code, e.g. ExpenseCreated, ExpenseUpdated, ExpenseSubmitted, ExpenseApproved, ExpenseRejected, ExpenseAIScanned, ExpenseAIScanFailed
    @jsondata:Name {value: "ActionType"}
    string actionType?;
    # Extra detail, e.g. the rejection reason or the AI read summary. Null for most entries
    @jsondata:Name {value: "Comments"}
    string comments?;
    @jsondata:Name {value: "ActivityID"}
    int activityID?;
    # When it happened, in UTC
    @jsondata:Name {value: "DateCreated"}
    string dateCreated?;
    # Initials for an avatar: the user's initials when the entry is attributed to a user, otherwise derived from ActionBy
    @jsondata:Name {value: "ActionByInitials"}
    string actionByInitials?;
    # Public URL of the user's profile picture, or null when they have none
    @jsondata:Name {value: "ActionByProfilePicURL"}
    string actionByProfilePicURL?;
    # The user the action is attributed to. For AI receipt reads this is the user who requested the read
    @jsondata:Name {value: "ActionByUserIDFK"}
    int:Signed32 actionByUserIDFK?;
    # Name shown for the entry as recorded at the time; "Avaza AI" for AI receipt reads
    @jsondata:Name {value: "ActionBy"}
    string actionBy?;
};

# A schedule series record representing a continuous booking or leave allocation for a user over a date range
public type ScheduleSeriesDetails record {
    # Optional end time of day for the scheduled work
    @jsondata:Name {value: "EndTime"}
    string endTime?;
    # Unique identifier for the schedule series
    @jsondata:Name {value: "ScheduleSeriesID"}
    int scheduleSeriesID?;
    # The project this booking is for (null for leave)
    @jsondata:Name {value: "ProjectIDFK"}
    int:Signed32 projectIDFK?;
    # Date and time the record was created
    @jsondata:Name {value: "DateCreated"}
    string dateCreated?;
    # The applicable billing rate per hour for this booking
    @jsondata:Name {value: "RateAmount"}
    decimal rateAmount?;
    # Start date of the schedule series
    @jsondata:Name {value: "StartDate"}
    string startDate?;
    # Name of the customer company
    @jsondata:Name {value: "CompanyName"}
    string companyName?;
    # The leave type ID (for leave schedule entries)
    @jsondata:Name {value: "LeaveTypeIDFK"}
    int:Signed32 leaveTypeIDFK?;
