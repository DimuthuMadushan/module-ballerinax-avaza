    @jsondata:Name {value: "DateUpdated"}
    string dateUpdated?;
    # The Avaza account this estimate belongs to
    @jsondata:Name {value: "AccountIDFK"}
    int:Signed32 accountIDFK?;
    # Date and time the record was created
    @jsondata:Name {value: "DateCreated"}
    string dateCreated?;
    # Tax configuration: 'EX' (exclusive) or 'INC' (inclusive)
    @jsondata:Name {value: "EstimateTaxConfigCode"}
    string estimateTaxConfigCode?;
    @jsondata:Name {value: "Recipient"}
    RecipientDetails recipient?;
    # The customer company ID this estimate is for
