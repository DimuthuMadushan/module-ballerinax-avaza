    int:Signed32 pageSize?;
};

# Filters for selecting uninvoiced timesheet entries. Only billable, Approved/AutoApproved, not-yet-invoiced entries of the invoice's customer are ever selected; entries with a running timer are skipped and reported
public type UninvoicedTimeFilter record {
    # Optional. Only include time logged against these task IDs
    @jsondata:Name {value: "TaskIDs"}
    int:Signed32[] taskIDs?;
    # Include the person's name in generated descriptions. Default true
    @jsondata:Name {value: "IncludePerson"}
    boolean includePerson?;
    # Include the project name in generated descriptions. Default true
    @jsondata:Name {value: "IncludeProjectName"}
    boolean includeProjectName?;
    # Include the timesheet category in generated descriptions. Default true
    @jsondata:Name {value: "IncludeCategory"}
    boolean includeCategory?;
    # How to group entries into line items: NoGrouping (one line per entry), GroupByProject, GroupByProjectCategory, GroupByProjectUser, GroupByProjectSection or GroupByProjectTask. Grouped lines get the total duration and a blended rate. Default NoGrouping
    @jsondata:Name {value: "Grouping"}
    string grouping?;
    # Optional. Only include time in these timesheet category IDs
    @jsondata:Name {value: "CategoryIDs"}
    int:Signed32[] categoryIDs?;
    # Optional. Only include entries on or after this date
    @jsondata:Name {value: "DateFrom"}
    string dateFrom?;
    # Include start/end times in generated descriptions (entries with start/end times only). Default true
    @jsondata:Name {value: "IncludeStartEndTime"}
    boolean includeStartEndTime?;
    # Project IDs to pull uninvoiced time from. When omitted, all billable projects of the invoice's customer are included
    @jsondata:Name {value: "ProjectIDs"}
    int:Signed32[] projectIDs?;
    # Include the task title in generated descriptions. Default true
    @jsondata:Name {value: "IncludeTask"}
    boolean includeTask?;
    # Include entry notes in generated descriptions. Default true
    @jsondata:Name {value: "IncludeNotes"}
    boolean includeNotes?;
    # Optional. Only include time logged by these user IDs
    @jsondata:Name {value: "UserIDs"}
    int:Signed32[] userIDs?;
    # Include the entry date in generated descriptions. Default true
    @jsondata:Name {value: "IncludeDate"}
    boolean includeDate?;
    # Optional. Only include entries on or before this date
    @jsondata:Name {value: "DateTo"}
    string dateTo?;
};

