public type EditTaskDiscussion record {
    # Optional optimistic-concurrency guard. If supplied and differs from the row's current DateUpdated, the edit is rejected with 409
    @jsondata:Name {value: "ExpectedDateUpdated"}
    string expectedDateUpdated?;
    # The TaskResponseID of the comment to edit. Must be authored by the current user
    @jsondata:Name {value: "TaskResponseID"}
    int taskResponseID?;
    # The new message body. Required (non-empty after sanitisation) if FileAttachmentIDs is empty.
    # @mention markup is the same as on POST: &lt;span class="mention" data-mentionid="12345"&gt;@Firstname Lastname&lt;/span&gt; (the class attribute is required). On edit, only NEWLY-added mentions are notified/followed; mentions already present before the edit are not re-notified
    @jsondata:Name {value: "ResponseBody"}
    string responseBody?;
    # Final canonical attachment set after edit: existing IDs to KEEP plus new draft IDs to ADD. Existing IDs omitted from this list are hard-deleted. Maximum 8
    @jsondata:Name {value: "FileAttachmentIDs"}
    int[] fileAttachmentIDs?;
};

# Represents the Queries record for the operation: submitExpensesForApproval
public type SubmitExpensesForApprovalQueries record {
    @http:Query {name: "SendWebhooks"}
    boolean sendWebhooks?;
    # The user to submit the Expenses for. Defaults to current user. Only allowed to be different from the current user when the current user has rights to Impersonate other users
    @http:Query {name: "UserID"}
    int:Signed32 userID?;
    # Send email alerts to expense approvers. Defaults to true
    @http:Query {name: "SendNotifications"}
    boolean sendNotifications?;
};

# One custom field value on a Task, Project, Team Member, Contact or Company record. Fields with no value are omitted
# from the CustomFields collection entirely. Value carries the typed raw value
# (string / number / boolean / "yyyy-MM-dd" date string / option name(s) / user name(s) /
# "lat, lng" string); DisplayValue is the formatted, human-readable text
public type CustomFieldValueItem record {
    # Unique identifier of the custom field definition this value belongs to
    @jsondata:Name {value: "CustomFieldDefinitionID"}
    int:Signed32 customFieldDefinitionID?;
    # Selected option IDs. Dropdown fields only
    @jsondata:Name {value: "OptionIDs"}
    int:Signed32[] optionIDs?;
    # Whether the field allows multiple selections (Dropdown and User types only)
    boolean isMultiSelect?;
    # Formatted display text for the value (numbers formatted per the definition, Duration as h:mm, Checkbox as Yes/No, multi-select values comma-separated)
    @jsondata:Name {value: "DisplayValue"}
    string displayValue?;
    # Unit suffix configured on the definition (Number fields only, when set)
    @jsondata:Name {value: "UnitLabel"}
    string unitLabel?;
    # The typed raw value: string for text, number for numeric types (Duration is decimal hours), boolean for Checkbox, "yyyy-MM-dd" string for Date, option name(s) for Dropdown, user name(s) for User (array of strings when multi-select), "lat, lng" string for Location
    @jsondata:Name {value: "Value"}
    record {} value?;
    # Latitude. Location fields only
    @jsondata:Name {value: "Latitude"}
    decimal latitude?;
    # Longitude. Location fields only
    @jsondata:Name {value: "Longitude"}
    decimal longitude?;
    # Data type of the field. Values: ShortText, LongText, Number, Percentage, Currency, Duration, Date, Checkbox, Dropdown, User, Location
    @jsondata:Name {value: "DataTypeCode"}
    string dataTypeCode?;
    # Selected user IDs. User fields only
    @jsondata:Name {value: "UserIDs"}
    int:Signed32[] userIDs?;
    # Display name of the custom field
    @jsondata:Name {value: "Name"}
    string name?;
};

# Response from the /api/FileAttachment* endpoints. Mirrors the shape of /api/Expense/Attachment with an optional LinkedTo echo when an inline link was requested
public type FileAttachmentUploadResult record {
    # List of uploaded file attachment details
    @jsondata:Name {value: "FileAttachments"}
    FileAttachmentDetails[] fileAttachments?;
    @jsondata:Name {value: "LinkedTo"}
    FileAttachmentLinkTarget linkedTo?;
};

# Filters for selecting uninvoiced chargeable expenses. Only Approved/AutoApproved, chargeable, not-yet-invoiced expenses of the invoice's customer are ever selected
public type UninvoicedExpenseFilter record {
    # Include the person's name in generated descriptions. Default true
    @jsondata:Name {value: "IncludePerson"}
    boolean includePerson?;
    # Optional. Only include expenses dated on or after this date
    @jsondata:Name {value: "DateFrom"}
    string dateFrom?;
    # Include the project name in generated descriptions. Default true
    @jsondata:Name {value: "IncludeProjectName"}
    boolean includeProjectName?;
    # Include the expense category in generated descriptions. Default true
    @jsondata:Name {value: "IncludeCategory"}
    boolean includeCategory?;
    # Project IDs to pull uninvoiced expenses from. When omitted, all of the customer's uninvoiced chargeable expenses are included (with or without a project)
    @jsondata:Name {value: "ProjectIDs"}
    int:Signed32[] projectIDs?;
    # How to group expenses into line items: NoGrouping (one line per expense) or GroupByExpenseCategory (one line per project + category + tax). Default NoGrouping
    @jsondata:Name {value: "Grouping"}
    string grouping?;
    # Include expense notes in generated descriptions. Default true
    @jsondata:Name {value: "IncludeNotes"}
    boolean includeNotes?;
    # Optional. Only include expenses submitted by these user IDs
    @jsondata:Name {value: "UserIDs"}
    int:Signed32[] userIDs?;
    # Include the expense date in generated descriptions. Default true
    @jsondata:Name {value: "IncludeDate"}
    boolean includeDate?;
    # Include the expense report (trip) name in generated descriptions. Default false
    @jsondata:Name {value: "IncludeTripName"}
    boolean includeTripName?;
    # Optional. Only include expenses dated on or before this date
    @jsondata:Name {value: "DateTo"}
    string dateTo?;
};

# Paginated list of expense group/trip names for dropdown/autocomplete use
public type ExpenseGroupDropdownList record {
    # Total number of expense groups matching the filter
    @jsondata:Name {value: "TotalCount"}
    int:Signed32 totalCount?;
    # The number of results per page
    @jsondata:Name {value: "PageSize"}
    int:Signed32 pageSize?;
    # The current page number (1-based)
    @jsondata:Name {value: "PageNumber"}
    int:Signed32 pageNumber?;
    # List of expense group records
    @jsondata:Name {value: "ExpenseGroups"}
    ExpenseGroupMinimal[] expenseGroups?;
};

# Result of appending line items to an invoice
public type InvoiceLineItemsResult record {
    @jsondata:Name {value: "Invoice"}
    Invoice invoice?;
    # The TransactionLineItemIDs of the newly created line items, in request order
    @jsondata:Name {value: "AddedTransactionLineItemIDs"}
    int[] addedTransactionLineItemIDs?;
    # Non-fatal notices about the operation (e.g. an invoice status change caused by the new total)
    @jsondata:Name {value: "Warnings"}
    string[] warnings?;
};
