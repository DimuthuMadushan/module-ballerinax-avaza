    # URL for viewing the bill in a web browser
    @jsondata:Name {value: "WebView"}
    string webView?;
    # URL for viewing the bill in the Avaza application
    @jsondata:Name {value: "View"}
    string view?;
};

# A file attachment on a task discussion message
public type TaskDiscussionResponseAttachment record {
    # File size in human-readable format
    @jsondata:Name {value: "Size"}
    string size?;
    # Storage filename of the attachment
    @jsondata:Name {value: "Filename"}
    string filename?;
    # Preview image URL
    @jsondata:Name {value: "Preview"}
    string preview?;
    # Formatted creation date of the attachment
    @jsondata:Name {value: "DateCreatedString"}
    string dateCreatedString?;
    # Unique identifier for the file attachment
    @jsondata:Name {value: "FileAttachmentID"}
    int fileAttachmentID?;
    # Direct URL to the attachment
    @jsondata:Name {value: "URL"}
    string uRL?;
    # Attachment name
    @jsondata:Name {value: "Name"}
    string name?;
    # URL for a preview/thumbnail of the attachment
    @jsondata:Name {value: "PreviewURL"}
    string previewURL?;
    # Whether a preview is available for this attachment
    @jsondata:Name {value: "CanPreview"}
    boolean canPreview?;
    # MIME type or category of the attachment
    @jsondata:Name {value: "Type"}
    string 'type?;
    # Storage provider code for the attachment
    string provider?;
    # File extension (e.g. '.pdf', '.png')
    @jsondata:Name {value: "FileExtension"}
    string fileExtension?;
    # Public URL to download the attachment
    @jsondata:Name {value: "PublicFileURL"}
    string publicFileURL?;
};

# Request model for updating an existing task. Only fields in FieldsToUpdate are modified
public type UpdateTask record {
    # Decimal hours
    @jsondata:Name {value: "EstimatedEffort"}
    decimal estimatedEffort?;
    # The section (task group) this task belongs to
    @jsondata:Name {value: "SectionIDFK"}
    int:Signed32 sectionIDFK?;
    # Unique identifier for the task
    @jsondata:Name {value: "TaskID"}
    int:Signed32 taskID;
    # Array of field names to update. Only listed fields will be modified
    @jsondata:Name {value: "FieldsToUpdate"}
    string[] fieldsToUpdate;
    # Task description (may contain HTML)
    @jsondata:Name {value: "Description"}
    string description?;
    # FileAttachmentIDs (returned from prior /api/FileAttachment uploads) to newly link to this task. Each ID must have been created by the current user and not yet linked to any entity
    @jsondata:Name {value: "FileAttachmentIDsToAdd"}
    int[] fileAttachmentIDsToAdd?;
    # If true, fires the matching webhook event (e.g. task_updated) to any subscribed endpoints. Defaults to false to preserve existing integration behaviour
    @jsondata:Name {value: "SendWebhooks"}
    boolean sendWebhooks?;
    # Current task status code
    @jsondata:Name {value: "TaskStatusCode"}
    string taskStatusCode?;
    # Task start date
    @jsondata:Name {value: "DateStart"}
    string dateStart?;
    # Task title/name
    @jsondata:Name {value: "Title"}
    string title?;
    # Task priority. Values: None, Low, Medium, High, Urgent
    @jsondata:Name {value: "TaskPriorityCode"}
    string taskPriorityCode?;
    # Re-parent this task. Set to a valid TaskID (same project) to make it a subtask;
    #             set to null (or 0) to promote it back to a root-level task. Applied only when
    #             "ParentTaskIDFK" is included in FieldsToUpdate. When set, the task inherits the parent's
    #             section, and SubtaskCount/SubtaskProgress/DisplayOrder are recalculated server-side
    @jsondata:Name {value: "ParentTaskIDFK"}
    int:Signed32 parentTaskIDFK?;
    # Custom field values to set. Only applied when "CustomFields" is included in FieldsToUpdate. Identify each item by CustomFieldDefinitionID (preferred) or Name (case-insensitive). Multi-select items REPLACE the field's whole selection; "Value": null clears a field. Fields not referenced keep their current values. Custom field definitions/options cannot be created or modified via the API
    @jsondata:Name {value: "CustomFields"}
    CustomFieldValueInput[] customFields?;
    # Task completion percentage (0-100)
    @jsondata:Name {value: "PercentComplete"}
    int:Signed32 percentComplete?;
    # Task due date
    @jsondata:Name {value: "DateDue"}
    string dateDue?;
    # List of tags to apply to this task
    @jsondata:Name {value: "Tags"}
    NewTag[] tags?;
    # List of user IDs to assign to this task
    @jsondata:Name {value: "AssignedToUserIDFK"}
    int:Signed32[] assignedToUserIDFK?;
};

# Represents the Queries record for the operation: listBillPayments
public type ListBillPaymentsQueries record {
    # 1-based page number to retrieve. Default 1
    int:Signed32 pageNumber?;
    # Number of results per page. Maximum 1000, default 20
    int:Signed32 pageSize?;
    # Only return records updated after this UTC date-time (ISO 8601 format). Useful for incremental sync
    @http:Query {name: "UpdatedAfter"}
    string updatedAfter?;
};

# A security role assigned to a user, with role code and display name
public type RoleDetails record {
    # Display name of the role
    @jsondata:Name {value: "RoleName"}
    string roleName?;
    # Unique code for the role (e.g. Admin, PM, TimesheetUser)
    @jsondata:Name {value: "RoleCode"}
    string roleCode?;
};

# Represents the Queries record for the operation: listExpenses
public type ListExpensesQueries record {
    # Page to display. Starts from 1
    int:Signed32 pageNumber?;
    # Filter expenses with an ExpenseDate on or after this date. Format: MM/dd/yyyy hh:mm:ss tt
    @http:Query {name: "ExpenseDateFrom"}
    string expenseDateFrom?;
    # Filter expenses by Project ID
    @http:Query {name: "ProjectID"}
    int:Signed32 projectID?;
    # Filter by invoiced status: true for invoiced expenses, false for uninvoiced
    boolean isInvoiced?;
    # Filter expenses by a specific reimbursement batch ID
    @http:Query {name: "ExpenseReimbursementIDFK"}
    int expenseReimbursementIDFK?;
    # Number of items per page (max 1000)
    int:Signed32 pageSize?;
    # Filter expenses by Customer/Company ID
    @http:Query {name: "CustomerID"}
    int:Signed32 customerID?;
    # Filter expenses by the email address of the expense user
    @http:Query {name: "UserEmail"}
    string userEmail?;
    # Filter expenses by payment method ID
    @http:Query {name: "ExpensePaymentMethodIDFK"}
    int:Signed32 expensePaymentMethodIDFK?;
    # Only return expenses updated after this date-time. Format: MM/dd/yyyy hh:mm:ss tt
    @http:Query {name: "UpdatedAfter"}
    string updatedAfter?;
    # Filter by chargeable (billable) status: true for chargeable, false for non-chargeable
    boolean isChargeable?;
    # Filter by approval status. Values: Draft, Rejected, Approved, AutoApproved, Pending, Verified
    @http:Query {name: "ExpenseApprovalStatusCode"}
    string expenseApprovalStatusCode?;
    # Filter expenses by the UserID of the expense user
    @http:Query {name: "UserID"}
    int:Signed32 userID?;
    # Search expenses by matching against Merchant name and Expense Category Name
    @http:Query {name: "Search"}
    string search?;
    # Filter expenses with an ExpenseDate on or before this date. Format: MM/dd/yyyy hh:mm:ss tt
    @http:Query {name: "ExpenseDateTo"}
    string expenseDateTo?;
    # Filter expenses by expense category name (exact match)
    @http:Query {name: "CategoryName"}
    string categoryName?;
    # Sort by: DateUpdated, DateCreated, ExpenseDate (append ' desc' for descending)
    @http:Query {name: "Sort"}
    string sort?;
};

# URLs for client-facing view, internal view, and editing an estimate in Avaza
public type EstimateLinks record {
    # URL for the customer to view the estimate online
    @jsondata:Name {value: "ClientView"}
    string clientView?;
    # URL for editing the estimate in the Avaza application
    @jsondata:Name {value: "Edit"}
    string edit?;
    # URL for viewing the estimate in the Avaza application
    @jsondata:Name {value: "View"}
    string view?;
};

# A section (task group) within a project, with title, dates, display order, and project association
public type SectionDetails record {
    # Section start date in local time
    @jsondata:Name {value: "StartDate"}
    string startDate?;
    # Sort order position for display within the project
    @jsondata:Name {value: "DisplayOrder"}
    int:Signed32 displayOrder?;
    # Section end date in UTC
    @jsondata:Name {value: "EndDateUTC"}
    string endDateUTC?;
    # The project this section belongs to
    @jsondata:Name {value: "ProjectIDFK"}
    int:Signed32 projectIDFK?;
    # Section title/name
    @jsondata:Name {value: "Title"}
    string title?;
    # Section start date in UTC
    @jsondata:Name {value: "StartDateUTC"}
    string startDateUTC?;
    # Unique identifier for the section
    @jsondata:Name {value: "SectionID"}
    int:Signed32 sectionID?;
    # Section end date in local time
    @jsondata:Name {value: "EndDate"}
    string endDate?;
