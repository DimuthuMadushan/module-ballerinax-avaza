# An active option of a Dropdown custom field
public type CustomFieldOptionDetails record {
    # Hex colour assigned to the option (e.g. "#F0AD4E"), or null
    @jsondata:Name {value: "Color"}
    string color?;
    # Unique identifier for the option
    @jsondata:Name {value: "CustomFieldOptionID"}
    int:Signed32 customFieldOptionID?;
    # Option display name
    @jsondata:Name {value: "Name"}
    string name?;
};

# Request model for updating an existing company. Only fields in FieldsToUpdate are modified
public type UpdateCompany record {
    # Updated label printed next to the tax number on invoices, e.g. "VAT No." (max 100 chars). Blank clears it so the invoice template's default label or "Tax Number" is used
    @jsondata:Name {value: "TaxNumberLabel"}
    string taxNumberLabel?;
    # The updated street address line for the company's billing address
    @jsondata:Name {value: "BillingAddressLine"}
    string billingAddressLine?;
    # The company's updated website URL
    string website?;
    # A list of field names that should be updated. Only the fields named here will be changed
    @jsondata:Name {value: "FieldsToUpdate"}
    string[] fieldsToUpdate?;
    # The updated state or province for the company's billing address
    @jsondata:Name {value: "BillingAddressState"}
    string billingAddressState?;
    # The ID of the company to update. Required
    @jsondata:Name {value: "CompanyID"}
    int:Signed32 companyID?;
    # If true, fires the company_updated webhook event to any subscribed endpoints. Defaults to false to preserve existing integration behaviour
    @jsondata:Name {value: "SendWebhooks"}
    boolean sendWebhooks?;
    # Updated internal notes or comments about the company
    @jsondata:Name {value: "Comments"}
    string comments?;
    # The updated ISO 2-letter country code for the company's billing address
    @jsondata:Name {value: "BillingCountryCode"}
    string billingCountryCode?;
    # The updated postcode or ZIP code for the company's billing address
    @jsondata:Name {value: "BillingAddressPostCode"}
    string billingAddressPostCode?;
    # The updated city for the company's billing address
    @jsondata:Name {value: "BillingAddressCity"}
    string billingAddressCity?;
    # The updated full formatted billing address string. If set, overrides the individual address fields
    @jsondata:Name {value: "BillingAddress"}
    string billingAddress?;
    # The new name for the company
    @jsondata:Name {value: "CompanyName"}
    string companyName?;
    # Custom field values to set. Only applied when "CustomFields" is included in FieldsToUpdate. Identify each item by CustomFieldDefinitionID (preferred) or Name (case-insensitive). Multi-select items REPLACE the field's whole selection; "Value": null clears a field. Fields not referenced keep their current values. Custom field definitions/options cannot be created or modified via the API
    @jsondata:Name {value: "CustomFields"}
    CustomFieldValueInput[] customFields?;
    # The company's updated primary phone number
    @jsondata:Name {value: "Phone"}
    string phone?;
    # The company's updated tax registration number
    @jsondata:Name {value: "TaxNumber"}
    string taxNumber?;
    # The company's updated fax number
    @jsondata:Name {value: "Fax"}
    string fax?;
};

# A line item on a supplier bill, specifying the inventory item, quantity, unit price, tax, and amount
public type BillLineItem record {
    # Text description for the line item
    @jsondata:Name {value: "Description"}
    string description?;
    # Discount percentage applied to this line item
    @jsondata:Name {value: "Discount"}
    decimal discount?;
    # The tax rate ID applied to this line item
    @jsondata:Name {value: "TaxIDFK"}
    int:Signed32 taxIDFK?;
    # Name of the applied tax rate
    @jsondata:Name {value: "TaxName"}
    string taxName?;
    # Optional project ID this line item is attributed to for reporting
    @jsondata:Name {value: "ProjectIDFK"}
    int:Signed32 projectIDFK?;
    # Calculated line total (Quantity x UnitPrice less Discount)
    @jsondata:Name {value: "Amount"}
    decimal amount?;
    # The inventory/product item ID for this line item
    @jsondata:Name {value: "InventoryItemIDFK"}
    int inventoryItemIDFK?;
    # Quantity of items on this line
    @jsondata:Name {value: "Quantity"}
    decimal quantity?;
    # Unique identifier for the line item
    @jsondata:Name {value: "TransactionLineItemID"}
    int transactionLineItemID?;
    # Name of the inventory/product item
    @jsondata:Name {value: "InventoryItemName"}
    string inventoryItemName?;
    # Price per unit for this line item
    @jsondata:Name {value: "UnitPrice"}
    decimal unitPrice?;
    # Total tax amount for this line item
    @jsondata:Name {value: "TaxAmount"}
    decimal taxAmount?;
    # Stock Keeping Unit code for the inventory item
    @jsondata:Name {value: "InventoryItemSKU"}
    string inventoryItemSKU?;
    # Title of the associated project
    @jsondata:Name {value: "ProjectTitle"}
    string projectTitle?;
    # Short code for the applied tax rate
    @jsondata:Name {value: "TaxCode"}
    string taxCode?;
};

# Represents the Queries record for the operation: listFixedAmounts
public type ListFixedAmountsQueries record {
    # (Optional) The TaskID of a Task to filter Fixed Amounts for
    @http:Query {name: "TaskID"}
    int:Signed32 taskID?;
    # Page to display. Starts from 1
    int:Signed32 pageNumber?;
    # When true, each linked fixed amount also returns the InvoiceIDFK of the invoice its line item belongs to
    boolean includeInvoiceDetails?;
    # (Optional) The ProjectID of a Project to filter Fixed Amounts for
    @http:Query {name: "ProjectID"}
    int:Signed32 projectID?;
    # Filter by invoiced status: true for invoiced, false for uninvoiced
    boolean isInvoiced?;
    # Number of items per page (max 1000)
    int:Signed32 pageSize?;
    # Optional sorting instruction. Currently possible values: "DateUpdated", "DateCreated", "DateUpdated desc", "DateCreated desc"
    @http:Query {name: "Sort"}
    string sort?;
    # (Optional) Only return fixed amounts whose project belongs to this customer company
    @http:Query {name: "CustomerID"}
    int:Signed32 customerID?;
    # Only return fixed amounts updated after this date-time
    @http:Query {name: "UpdatedAfter"}
    string updatedAfter?;
};

# Represents the Queries record for the operation: lookupCompanies
public type LookupCompaniesQueries record {
    # Search string to match against Company name
    string search?;
    # 1-based page number to retrieve. Default 1
    int:Signed32 pageNumber?;
    # Number of results per page. Maximum 1000, default 20
    int:Signed32 pageSize?;
};

# JSON body for POST /api/FileAttachment/FromUrl. Server fetches the file from the supplied https URL
public type FileAttachmentSourceUrlRequest record {
    # Public https URL the server will fetch to obtain the file. Required
    @jsondata:Name {value: "SourceUrl"}
    string sourceUrl?;
    # Optional MIME type. Falls back to the response Content-Type header
    @jsondata:Name {value: "ContentType"}
    string contentType?;
    # Optional original filename. If omitted, derived from Content-Disposition or the URL path
    @jsondata:Name {value: "Filename"}
    string filename?;
    @jsondata:Name {value: "LinkTo"}
    FileAttachmentLinkTarget linkTo?;
};

# Represents the Queries record for the operation: getUninvoicedSummary
public type GetUninvoicedSummaryQueries record {
    # Group rows by "Customer" (default) or "Project"
    @http:Query {name: "GroupBy"}
    string groupBy?;
    # Optional. Limit the summary to this customer company
    @http:Query {name: "CompanyID"}
    int:Signed32 companyID?;
    # Optional. Limit the summary to this project
    @http:Query {name: "ProjectID"}
    int:Signed32 projectID?;
};

# Result of removing line items from an invoice
public type RemoveInvoiceLineItemsResult record {
    # Expenses released back to uninvoiced by the removal
    @jsondata:Name {value: "UnlinkedExpenseIDs"}
    int[] unlinkedExpenseIDs?;
    @jsondata:Name {value: "Invoice"}
    Invoice invoice?;
    # Fixed amounts released back to uninvoiced by the removal
    @jsondata:Name {value: "UnlinkedFixedAmountIDs"}
    int[] unlinkedFixedAmountIDs?;
    # Non-fatal notices about the operation
    @jsondata:Name {value: "Warnings"}
    string[] warnings?;
    # Timesheet entries released back to uninvoiced by the removal
    @jsondata:Name {value: "UnlinkedTimesheetEntryIDs"}
    int[] unlinkedTimesheetEntryIDs?;
};

# Paginated collection of projects with summary details
public type ProjectList record {
    # Total number of projects matching the query
    @jsondata:Name {value: "TotalCount"}
    int:Signed32 totalCount?;
    # Number of results per page
    @jsondata:Name {value: "PageSize"}
    int:Signed32 pageSize?;
    # Current page number (1-based)
    @jsondata:Name {value: "PageNumber"}
    int:Signed32 pageNumber?;
    # List of projects in this page
    @jsondata:Name {value: "Projects"}
    ProjectListDetails[] projects?;
};

# Request model for updating an existing invoice. Only fields in FieldsToUpdate are modified. When LineItems is included, existing lines not in the array are deleted
public type UpdatedInvoice record {
    # Exchange rate is only valid for invoices in currency other than default account currency. If not specified it will get the market rate based on the Date Issued
    @jsondata:Name {value: "ExchangeRate"}
    decimal exchangeRate?;
    @jsondata:Name {value: "LineItems"}
    UpdatedInvoiceLineItem[] lineItems?;
    # Required: The collection of Field Names you wish to update. Possible Values: CustomerPONumber, DateIssued, PaymentTerms, DueDate, Subject, Notes, TransactionTaxConfigCode, ExchangeRate, InvoiceTemplateIDFK, InvoiceNumber, LineItems
    @jsondata:Name {value: "FieldsToUpdate"}
    string[] fieldsToUpdate;
    # If true, fires the invoice_updated webhook event to any subscribed endpoints (and timesheet_updated for any timesheet rows whose invoice link changed). Defaults to false to preserve existing integration behaviour
    @jsondata:Name {value: "SendWebhooks"}
    boolean sendWebhooks?;
    @jsondata:Name {value: "PaymentTerms"}
    int:Signed32 paymentTerms?;
    # Invoice Subject in plain UTF8 text. (no HTML). 255 characters max
    @jsondata:Name {value: "Subject"}
    string subject?;
    # The ID of the Invoice to update
    @jsondata:Name {value: "TransactionID"}
    int transactionID;
    # Plain UTF8 text. 100 characters max
    @jsondata:Name {value: "CustomerPONumber"}
    string customerPONumber?;
    # The Date the Invoice is issued. Date should be specified as local date
    @jsondata:Name {value: "DateIssued"}
    string dateIssued?;
    # The invoice template to render the invoice with (an INV or EST type template). Use GET /api/InvoiceTemplate to look up template IDs by name. Required when InvoiceTemplateIDFK is listed in FieldsToUpdate
    @jsondata:Name {value: "InvoiceTemplateIDFK"}
    int:Signed32 invoiceTemplateIDFK?;
    # Pass a string or integer. If an integer is passed then the largest integer will be use as the seed to auto generate the next invoice number in the sequence
    @jsondata:Name {value: "InvoiceNumber"}
    string invoiceNumber?;
    # If the Due Date is specified then Payment Terms will be set to -1 (Custom). Otherwise DueDate will be auto calculated based on the provided IssueDate and Payment Term. Due Date must be greater than or equal to Issue Date
    @jsondata:Name {value: "DueDate"}
    string dueDate?;
    # Invoice Notes in plain UTF8 text. (no HTML). Max 2000 characters
    @jsondata:Name {value: "Notes"}
    string notes?;
    # Possible values are (EX --- Tax Exclusive, INC --- Tax Inclusive). If left set to null/emptystring it will use the account default
    @jsondata:Name {value: "TransactionTaxConfigCode"}
    string transactionTaxConfigCode?;
};

# A payment instruction method enabled on a template
public type InvoiceTemplatePaymentInstructionSummary record {
    # True when the method is enabled on the template but is not rendered on the document
    boolean isHiddenOnInvoice?;
    # Payment instruction method code, e.g. bank_transfer_generic, bpay, payid
    @jsondata:Name {value: "PaymentInstructionCode"}
    string paymentInstructionCode?;
    # ID of the account's payment instruction record
    @jsondata:Name {value: "AccountPaymentInstructionID"}
    int:Signed32 accountPaymentInstructionID?;
    # Display name of the method, e.g. "Bank Transfer (SEPA)"
    @jsondata:Name {value: "Name"}
    string name?;
};

# Details of an uploaded file attachment including ID, size, filename, and public URL
public type FileAttachmentDetails record {
    # Original filename as uploaded
    @jsondata:Name {value: "OriginalFilename"}
    string originalFilename?;
    # Public URL to access the uploaded file
    @jsondata:Name {value: "PublicFileURL"}
    string publicFileURL?;
    # File size in bytes
    @jsondata:Name {value: "SizeBytes"}
    int sizeBytes?;
    # Unique identifier for the file attachment
    @jsondata:Name {value: "FileAttachmentID"}
    int fileAttachmentID?;
    # URL for a preview/thumbnail of the file
    @jsondata:Name {value: "PreviewBaseURL"}
    string previewBaseURL?;
};

# Represents the Queries record for the operation: getExpenseSummary
public type GetExpenseSummaryQueries record {
    # (Required) Filter for expenses with expense dates greater or equal to the specified date. e.g. 2019-01-25
    @http:Query {name: "model.expenseDateFrom"}
    string modelExpenseDateFrom?;
    # (Optional) Combine one, two or three levels of Grouping. Combine these possible grouping values: "Category", "ChargeableStatus", "Merchant", "ApprovalStatus", "ReimbursementStatus", "Customer", "Project", "User", "Task", "Year", "Month", "Day", "Week"
    @http:Query {name: "model.groupBy"}
    string[] modelGroupBy?;
    # (Required) Filter for expenses with an expense date smaller or equal to the specified  date. e.g. 2019-01-25
    @http:Query {name: "model.expenseDateTo"}
    string modelExpenseDateTo?;
    # (Optional) Filter by Project
    @http:Query {name: "model.projectID"}
    int:Signed32 modelProjectID?;
    # (Optional) Defaults to the current user. Provide one or more UserIDs of Users whose expenses should be retrieved. If the current user doesn't have impersonation rights, then they will only see their own data
    @http:Query {name: "model.userID"}
    int:Signed32[] modelUserID?;
};

# Discussion thread for a task, containing paginated comment/response messages
public type TaskDiscussion record {
    # The task this discussion belongs to
    @jsondata:Name {value: "TaskID"}
    int:Signed32 taskID?;
    # The starting response ID for pagination
    int startItem?;
    # The project containing this task
    @jsondata:Name {value: "ProjectIDFK"}
    int:Signed32 projectIDFK?;
    # List of discussion messages/comments
    TaskDiscussionResponse[] responses?;
    # Number of messages returned per page
    int:Signed32 pageSize?;
};

# Request model for deleting specific line items from an invoice and releasing their linked records
public type RemoveInvoiceLineItemsRequest record {
    # If true, fires invoice_updated (plus timesheet_updated / expense_updated for released records) webhook events. Defaults to false
    @jsondata:Name {value: "SendWebhooks"}
    boolean sendWebhooks?;
    # The TransactionLineItemIDs to delete (1-100). Every ID must belong to this invoice. Any timesheets, expenses or fixed amounts linked to the deleted lines are released back to uninvoiced
    @jsondata:Name {value: "TransactionLineItemIDs"}
    int[] transactionLineItemIDs;
    # The Transaction ID of the invoice to remove line items from. The invoice must not be Void
    @jsondata:Name {value: "InvoiceID"}
    int invoiceID;
};

# Request body for POST /api/UserProfile. Creates a team member (CompanyIDFK = null) or a customer contact (CompanyIDFK set)
public type NewUserProfile record {
    # Email address. Must be a valid format and unique within the current account
    @jsondata:Name {value: "Email"}
    string email?;
    # User's job title. Max 100 characters
    @jsondata:Name {value: "PositionTitle"}
    string positionTitle?;
    # If true and at least one role is assigned, sends an invitation email and sets InvitationStatusCode = "InviteSent". See spec for the full matrix
    @jsondata:Name {value: "SendInviteEmail"}
    boolean sendInviteEmail?;
    # Default billable rate per hour. Team members only. Must be non-negative
    @jsondata:Name {value: "DefaultBillableRate"}
    decimal defaultBillableRate?;
    # Last name. Max 100 characters
    @jsondata:Name {value: "Lastname"}
    string lastname?;
    # Role codes to assign. Each entry must be a RoleCode from the Roles table that is assignable for the user type (UserAssignable=1 for team members, CustomerAssignable=1 for customer contacts). Empty/null = no roles (InvitationStatusCode = "NoRoles")
    @jsondata:Name {value: "Roles"}
    string[] roles?;
    # If set, creates a Customer Contact linked to this Company. If null, creates a Team Member
    @jsondata:Name {value: "CompanyIDFK"}
    int:Signed32 companyIDFK?;
    # Mobile phone number. Max 50 characters
    @jsondata:Name {value: "Mobile"}
    string mobile?;
    # First name. Max 100 characters
    @jsondata:Name {value: "Firstname"}
    string firstname?;
    # Windows Time Zone ID (e.g. "Pakistan Standard Time"). If omitted, defaults to the account's timezone
    @jsondata:Name {value: "TimeZone"}
    string timeZone?;
    # Custom field values to set on the new user (Team Member fields when CompanyIDFK is null, Contact fields when it is set). Identify each item by CustomFieldDefinitionID (preferred) or Name (case-insensitive). Fields not supplied receive their configured default values; required fields without a default must be supplied. Custom field definitions/options cannot be created or modified via the API
    @jsondata:Name {value: "CustomFields"}
    CustomFieldValueInput[] customFields?;
    # Phone number. Max 50 characters
    @jsondata:Name {value: "Phone"}
    string phone?;
    # Default cost rate per hour. Team members only. Must be non-negative
    @jsondata:Name {value: "DefaultCostRate"}
    decimal defaultCostRate?;
};

# Represents the Queries record for the operation: listScheduleAssignments
public type ListScheduleAssignmentsQueries record {
    # Page to display. Starts from 1
    int:Signed32 pageNumber?;
    # Filter to records for a particular Schedule Series
    @http:Query {name: "ScheduleSeriesID"}
    int scheduleSeriesID?;
    # The UserID of a schedule user to filter assignments for. Only api users with Admin role can see all schedules across all users. Users with ScheduleUser role can access their own ScheduleSeries
    @http:Query {name: "UserID"}
    int:Signed32 userID?;
    # Number of items per page (max 1000)
    int:Signed32 pageSize?;
    # Optional sorting instruction. Currently possible values: "DateUpdated", "DateCreated", "DateUpdated desc", "DateCreated desc"
    @http:Query {name: "Sort"}
    string sort?;
    # Filter for schedule assignement  that are  on or after a specific date
    @http:Query {name: "ScheduleDateFrom"}
    string scheduleDateFrom?;
    # Filter for schedules that are on or before a specific date
    @http:Query {name: "ScheduleDateTo"}
    string scheduleDateTo?;
    # The email of the user who has been scheduled
    @http:Query {name: "UserEmail"}
    string userEmail?;
    # Limit results to records updated after the specified date
    @http:Query {name: "UpdatedAfter"}
    string updatedAfter?;
};

# Represents the Queries record for the operation: listBills
public type ListBillsQueries record {
    # 1-based page number to retrieve. Default 1
    int:Signed32 pageNumber?;
    # Filter by due date start range
    @http:Query {name: "DueDateFrom"}
    string dueDateFrom?;
    # Filter by bill status code
    @http:Query {name: "TransactionStatusCode"}
    string transactionStatusCode?;
    # Filter by issue date start range
    @http:Query {name: "IssueDateFrom"}
    string issueDateFrom?;
    # Number of results per page. Maximum 1000, default 20
    int:Signed32 pageSize?;
    # Sort results by: DateUpdated, DateCreated (append ' desc' for descending)
    @http:Query {name: "Sort"}
    string sort?;
    # Filter by issue date end range
    @http:Query {name: "IssueDateTo"}
    string issueDateTo?;
    # Filter bills to a specific supplier company by Company ID
    @http:Query {name: "CompanyIDFK"}
    int:Signed32 companyIDFK?;
    # Filter by due date end range
    @http:Query {name: "DueDateTo"}
    string dueDateTo?;
    # Only return bills updated after this date-time (ISO 8601). Useful for incremental sync
    @http:Query {name: "UpdatedAfter"}
    string updatedAfter?;
};

# Represents the Queries record for the operation: listCompanies
public type ListCompaniesQueries record {
    # Set false to omit the CustomFields collection from each company. Defaults to true
    @http:Query {name: "IncludeCustomFields"}
    boolean includeCustomFields?;
    # 1-based page number to retrieve. Default 1
    int:Signed32 pageNumber?;
    # Number of results per page. Maximum 1000, default 20
    int:Signed32 pageSize?;
    # Sort results by: DateUpdated, DateCreated (append ' desc' for descending)
    @http:Query {name: "Sort"}
    string sort?;
    # Only return companies updated after this date-time (ISO 8601). Useful for incremental sync
    @http:Query {name: "UpdatedAfter"}
    string updatedAfter?;
};

# A line item on an invoice, specifying the inventory item, quantity, unit price, tax, project, and calculated amount
public type InvoiceLineItem record {
    # Text description for the line item
    @jsondata:Name {value: "Description"}
    string description?;
    # Discount percentage applied to this line item
    @jsondata:Name {value: "Discount"}
    decimal discount?;
    # The tax rate ID applied to this line item
    @jsondata:Name {value: "TaxIDFK"}
    int:Signed32 taxIDFK?;
    # Name of the applied tax rate
    @jsondata:Name {value: "TaxName"}
    string taxName?;
    # Optional project ID this line item is attributed to for reporting
    @jsondata:Name {value: "ProjectIDFK"}
    int:Signed32 projectIDFK?;
    # Calculated line total (Quantity x UnitPrice less Discount)
    @jsondata:Name {value: "Amount"}
    decimal amount?;
    # The inventory/product item ID for this line item
    @jsondata:Name {value: "InventoryItemIDFK"}
    int inventoryItemIDFK?;
    # Quantity of items on this line
    @jsondata:Name {value: "Quantity"}
    decimal quantity?;
    # Unique identifier for the line item
    @jsondata:Name {value: "TransactionLineItemID"}
    int transactionLineItemID?;
    # Name of the inventory/product item
    @jsondata:Name {value: "InventoryItemName"}
    string inventoryItemName?;
    # IDs of the Expenses linked to (invoiced by) this line item. Empty when the line item has no linked expenses
    @jsondata:Name {value: "ExpenseIDs"}
    int[] expenseIDs?;
    # Price per unit for this line item
    @jsondata:Name {value: "UnitPrice"}
    decimal unitPrice?;
    # Calculated tax amount on this line item
    @jsondata:Name {value: "TaxAmount"}
    decimal taxAmount?;
    # IDs of the Timesheet entries linked to (invoiced by) this line item. Empty when the line item has no linked timesheets
    @jsondata:Name {value: "TimesheetEntryIDs"}
    int[] timesheetEntryIDs?;
    # Stock Keeping Unit code for the inventory item
    @jsondata:Name {value: "InventoryItemSKU"}
    string inventoryItemSKU?;
    # Title of the associated project
    @jsondata:Name {value: "ProjectTitle"}
    string projectTitle?;
    # Short code for the applied tax rate
    @jsondata:Name {value: "TaxCode"}
    string taxCode?;
    # IDs of the Fixed Amounts linked to (invoiced by) this line item. Empty when the line item has no linked fixed amounts
    @jsondata:Name {value: "FixedAmountIDs"}
    int[] fixedAmountIDs?;
};

# Represents the Queries record for the operation: listProjects
public type ListProjectsQueries record {
    # Filter projects created on or before this date (ISO 8601)
    @http:Query {name: "DateCreatedTo"}
    string dateCreatedTo?;
    # Include Archived Projects in the results
    boolean includeArchived?;
    # Set false to omit the CustomFields collection from each project. Defaults to true
    @http:Query {name: "IncludeCustomFields"}
    boolean includeCustomFields?;
    # Filter by project status code. Per-account configurable; default codes are NotStarted, InProgress, Complete, OnHold (seeded for every account); admins may add custom codes
    @http:Query {name: "ProjectStatusCode"}
    string projectStatusCode?;
    # Page to display. Starts from 1
    int:Signed32 pageNumber?;
    # Filter projects belonging to a specific customer company by Company ID
    @http:Query {name: "CompanyID"}
    int:Signed32 companyID?;
    # Filter by billing type. Values: CategoryHourly, NoRate, NotBillable, PersonHourly, ProjectHourly
    @http:Query {name: "ProjectBillableTypeCode"}
    string projectBillableTypeCode?;
    # How multiple Tags combine. "any" (default) returns projects with at least one of the supplied tags; "all" returns only projects that have every supplied tag
    @http:Query {name: "TagMatchMode"}
    string tagMatchMode?;
    # Number of items per page (max 1000)
    int:Signed32 pageSize?;
    # Filter projects owned by a specific user by User ID
    @http:Query {name: "ProjectOwnerUserID"}
    int:Signed32 projectOwnerUserID?;
    # Only return projects updated after this UTC date-time (ISO 8601)
    @http:Query {name: "UpdatedAfter"}
    string updatedAfter?;
    # Filter by budget type. Values: CategoryHours, NoBudget, PersonHours, ProjectFees, ProjectHours
    @http:Query {name: "ProjectBudgetTypeCode"}
    string projectBudgetTypeCode?;
    # Filter projects created on or after this date (ISO 8601)
    @http:Query {name: "DateCreatedFrom"}
    string dateCreatedFrom?;
    # Filter projects by project category ID
    @http:Query {name: "ProjectCategoryID"}
    int:Signed32 projectCategoryID?;
    # A column to sort on. Current possible values: "DateUpdated", "DateCreated", "DateUpdated desc", "DateCreated desc"
    @http:Query {name: "Sort"}
    string sort?;
    # Filter to the projects that the supplied UserID can add timesheets to
    @http:Query {name: "TimesheetUserID"}
    int:Signed32 timesheetUserID?;
    # Set true to include the computed budget fields on each project (EffectiveBudgetHours, SpentHours, SpentAmount - the same Budget and Spent the All Projects page shows). The page size is capped at 100 when set, because the values are computed per request. Defaults to false. The stored settings BudgetAmount / BudgetHours are always returned
    @http:Query {name: "IncludeBudget"}
    boolean includeBudget?;
    # Filter to projects assigned the supplied tag name(s). Repeat the parameter for multiple tags (e.g. ?Tags=Urgent&amp;Tags=Retainer). Names are matched case-insensitively; a name not in the account simply matches nothing. By default a project matches if it has ANY of the supplied tags (see TagMatchMode)
    @http:Query {name: "Tags"}
    string[] tags?;
};

public type TaskSectionGroup record {
    @jsondata:Name {value: "SectionTitle"}
    string sectionTitle?;
    TaskDropdownSelection[] tasks?;
};

# Paginated collection of per-day schedule assignments
public type ScheduleAssignmentList record {
    # Total number of records matching the query across all pages
    @jsondata:Name {value: "TotalCount"}
    int:Signed32 totalCount?;
    # The number of records per page
    @jsondata:Name {value: "PageSize"}
    int:Signed32 pageSize?;
    # The current page number (1-based)
    @jsondata:Name {value: "PageNumber"}
    int:Signed32 pageNumber?;
    # The list of schedule assignment records for this page
    @jsondata:Name {value: "ScheduleAssignments"}
    ScheduleAssignmentDetails[] scheduleAssignments?;
};

# Request model for creating a new supplier bill payment
public type NewBillPayment record {
    # Optional to override the default prefix added to Payment Numbers
    @jsondata:Name {value: "TransactionPrefix"}
    string transactionPrefix?;
    # Optional for specifying the Bill Payment's Currency (3 letter ISO Currency Code)
    @jsondata:Name {value: "CurrencyCode"}
    string currencyCode?;
    # Optional. Only used when the Company's currency is different from the Avaza account's base currency. Specifies the exchange rate that should apply between the Company currency and base currency. If not provided we will obtain an up to date exchange rate for the Payment Issue Date
    @jsondata:Name {value: "ExchangeRate"}
    decimal exchangeRate?;
    # List of amounts within this payment that are allocated to invoices. The sum of these be less than or equal to the payment amount
    @jsondata:Name {value: "PaymentAllocations"}
    NewBillPaymentAllocation[] paymentAllocations?;
    # Date of Payment. If not specified, assumes today
    @jsondata:Name {value: "DateIssued"}
    string dateIssued?;
    # Optional for storing the reference # of the payment method
    @jsondata:Name {value: "TransactionReference"}
    string transactionReference?;
    # Optional for storing the payment provider who was the source of funds
    @jsondata:Name {value: "PaymentProviderCode"}
    string paymentProviderCode?;
    # If true, fires the bill_updated webhook event to any subscribed endpoints for each bill that was allocated against. Defaults to false to preserve existing integration behaviour
    @jsondata:Name {value: "SendWebhooks"}
    boolean sendWebhooks?;
    # The total amount of the payment
    @jsondata:Name {value: "Amount"}
    decimal amount?;
    # Only required if no invoice allocations specified
    @jsondata:Name {value: "CompanyIDFK"}
    int:Signed32 companyIDFK?;
    # Optional. If not specified will be automatically generated
    @jsondata:Name {value: "PaymentNumber"}
    string paymentNumber?;
    # Additional notes on the payment
    @jsondata:Name {value: "Notes"}
    string notes?;
};

# Represents the Queries record for the operation: listCustomFieldDefinitions
public type ListCustomFieldDefinitionsQueries record {
    # The entity type the fields are mapped to. Values: Project, Task, TeamMember, Contact, Company, Timesheet, Expense, Invoice, InvoiceLineItem, Estimate, EstimateLineItem, Schedule, Bill, BillLineItem. Required
    @http:Query {name: "EntityTypeCode"}
    string entityTypeCode?;
};

# Request model for creating a new expense entry. Requires expense date, amount, and category
public type NewExpense record {
    # The expense category to link the Expense to. If not provided, ExpenseCategoryName must be provided
    @jsondata:Name {value: "ExpenseCategoryIDFK"}
    int:Signed32 expenseCategoryIDFK?;
    # Optional (Only relevant if the expense currency is different to your account currency. If not provided we will look up the market exchange rate for you based on the expense date.) Exchange Rate = Expense Currency Amount / Base Currency Amount (e.g. if Expense currency is in AUD, and Base Currency is in USD, Exchange Rate = AUD $140 / USD $100 = 1.4)
    @jsondata:Name {value: "ExchangeRate"}
    decimal exchangeRate?;
    # Can work for matching an expense to a project, but only if it's an exact match for a single project under the customer
    @jsondata:Name {value: "ProjectName"}
    string projectName?;
    # If true, fires the expense_created webhook event to any subscribed endpoints. Defaults to false to preserve existing integration behaviour
    @jsondata:Name {value: "SendWebhooks"}
    boolean sendWebhooks?;
    # The Avaza project ID to associate the Expense with
    @jsondata:Name {value: "ProjectIDFK"}
    int:Signed32 projectIDFK?;
    # The email address of a Timesheet/Expense user in Avaza. If not provided, UserIDFK field must be provided
    @jsondata:Name {value: "UserEmail"}
    string userEmail?;
    # Links the expense to a Grouping/Trip report. If no matching name found, creates a new Group/Trip Report name
    @jsondata:Name {value: "GroupTripName"}
    string groupTripName?;
    # (Optional) ID of Expense Payment Method
    @jsondata:Name {value: "ExpensePaymentMethodIDFK"}
    int:Signed32 expensePaymentMethodIDFK?;
    # Pass false if creating a draft expense. True otherwise
    @jsondata:Name {value: "VerifyAndSave"}
    boolean verifyAndSave?;
    # A 3-letter ISO CurrencyCode for the expense currency. (e.g. USD). If not provided, defaults to the Account base currency
    @jsondata:Name {value: "CurrencyCode"}
    string currencyCode?;
    # The name of the merchant
    @jsondata:Name {value: "Merchant"}
    string merchant?;
    # The name of an existing customer in Avaza. Must be an exact (case insensitive) match
    @jsondata:Name {value: "CustomerName"}
    string customerName?;
    # Expense Notes
    @jsondata:Name {value: "Notes"}
    string notes?;
    # Array of File Attachment IDs to associate with this expense. The files need to have already been uploaded. Currently only accepts a single file
    @jsondata:Name {value: "FileAttachmentIDs"}
    int[] fileAttachmentIDs?;
    # Defaults to false if not provided
    boolean isReimbursable?;
    # Avaza Tax ID the expense belongs to. If left blank then Tax Name must be provided
    @jsondata:Name {value: "TaxIDFK"}
    int:Signed32 taxIDFK?;
    # (optional) TaskID of a Task to link the new Expense to. A Customer and Project must be provided also
    @jsondata:Name {value: "TaskIDFK"}
    int:Signed32 taskIDFK?;
    # Expense Amount (Required). Can be negative, e.g. to record a refund that reduces project cost and credits the client's next invoice
    @jsondata:Name {value: "Amount"}
    decimal amount?;
    # Must exactly match an existing Tax Name that you have configured in Avaza Tax settings. If left blank then Tax ID must be provided
    @jsondata:Name {value: "TaxName"}
    string taxName?;
    # A Tax number identifier for the merchant
    @jsondata:Name {value: "MerchantTaxNumber"}
    string merchantTaxNumber?;
    # Conditional - available for expenses that are assigned a unit priced based expense category. e.g Mileage. A negative Quantity gives a negative Amount
    @jsondata:Name {value: "Quantity"}
    decimal quantity?;
    # aka Billable. Defaults to false if not provided. If set to true, a CustomerIDFK or CustomerName must be provided
    boolean isChargeable?;
    # The Avaza Customer ID to associate the Expense with. Either this field or CustomerName can be provided
    @jsondata:Name {value: "CustomerIDFK"}
    int:Signed32 customerIDFK?;
    # The date of the expense entry (Required)
    @jsondata:Name {value: "ExpenseDate"}
    string expenseDate?;
    # Must match an existing expense category name otherwise a new category will be created. If left blank Expense Category ID must be provided
    @jsondata:Name {value: "ExpenseCategoryName"}
    string expenseCategoryName?;
    # UserID for a Timesheet/Expense user in Avaza. If not provided, UserEmail field must be provided
    @jsondata:Name {value: "UserIDFK"}
    int:Signed32 userIDFK?;
    # Optional - Enter "INC" if the tax amount is included in the expense amount otherwise enter "EX" when the amount exlcudes the tax. Defaults to "Ex". The tax amount on the expense will be autocalculated
    @jsondata:Name {value: "TransactionTaxConfigCode"}
    string transactionTaxConfigCode?;
};

# Request model for assigning or updating a timesheet category on a project
public type AssignProjectTimesheetCategory record {
    # Controls whether updated rates are applied to existing schedule bookings for this category.
    # Possible values: "new" (default, only new bookings), "all" (all existing bookings), "active" (bookings with end date in the future)
    @jsondata:Name {value: "ScheduleRateUpdateOption"}
    string scheduleRateUpdateOption?;
    # Controls whether updated rates are applied to existing timesheet entries for this category.
    # Possible values: "new" (default, do not update existing timesheets), "uninvoiced" (update all existing uninvoiced timesheets)
    @jsondata:Name {value: "TimesheetRateUpdateOption"}
    string timesheetRateUpdateOption?;
    # The project ID to assign the category to
    @jsondata:Name {value: "ProjectIDFK"}
    int:Signed32 projectIDFK?;
    # Hours budget for this category on this project
    @jsondata:Name {value: "BudgetHours"}
    decimal budgetHours?;
    # The cost rate per hour for this category on this project
    @jsondata:Name {value: "CostAmount"}
    decimal costAmount?;
    # The billing rate per hour for this category on this project
    @jsondata:Name {value: "RateAmount"}
    decimal rateAmount?;
    # The timesheet category ID to assign to the project
    @jsondata:Name {value: "TimesheetCategoryIDFK"}
    int:Signed32 timesheetCategoryIDFK?;
    # Whether time logged under this category is billable
    boolean isBillable?;
    # Whether time logged under this category is payable
    boolean isPayable?;
};

# Paginated collection of tasks
public type TaskList record {
    # Total number of tasks matching the filter criteria
    @jsondata:Name {value: "TotalCount"}
    int:Signed32 totalCount?;
    # List of task records for this page
    @jsondata:Name {value: "Tasks"}
    TaskDetails[] tasks?;
    # Number of results per page
    @jsondata:Name {value: "PageSize"}
    int:Signed32 pageSize?;
    # Current page number (1-based)
    @jsondata:Name {value: "PageNumber"}
    int:Signed32 pageNumber?;
};

# Request model for updating a project member's rates, budget, or permissions. Only fields in FieldsToUpdate are modified
public type UpdateProjectMember record {
    boolean isTimesheetApprovalRequired?;
    boolean canUpdateTasks?;
    # A string array of field names to be updated
    @jsondata:Name {value: "FieldsToUpdate"}
    string[] fieldsToUpdate;
    # Controls whether updated rates are applied to existing timesheet entries for this member.
    # Possible values: "new" (default, do not update existing timesheets), "uninvoiced" (update all existing uninvoiced timesheets).
    # Only applies when RateAmount or CostAmount is included in FieldsToUpdate
    @jsondata:Name {value: "TimesheetRateUpdateOption"}
    string timesheetRateUpdateOption?;
    # Required. The ProjectID
    @jsondata:Name {value: "ProjectIDFK"}
    int:Signed32 projectIDFK;
    boolean isTimesheetApprover?;
    # A new Rate Amount. Defaults to null
    @jsondata:Name {value: "RateAmount"}
    decimal rateAmount?;
    boolean isExpenseApprover?;
    # A new Budget Amount. Defaults to null
    @jsondata:Name {value: "BudgetAmount"}
    decimal budgetAmount?;
    # Controls whether updated rates are applied to existing schedule bookings for this member.
    # Possible values: "new" (default, only new bookings), "all" (all existing bookings), "active" (bookings with end date in the future).
    # Only applies when RateAmount or CostAmount is included in FieldsToUpdate
    @jsondata:Name {value: "ScheduleRateUpdateOption"}
    string scheduleRateUpdateOption?;
    boolean canDeleteTasks?;
    boolean canCommentOnTasks?;
    boolean canCreateTasks?;
    # A new Cost Amount. Defaults to null
    @jsondata:Name {value: "CostAmount"}
    decimal costAmount?;
    # Required. The UserID
    @jsondata:Name {value: "UserIDFK"}
    int:Signed32 userIDFK;
    boolean isTimesheetAllowed?;
};

# Request model for creating a new supplier bill. Supports automatic company/contact creation
public type NewBill record {
    # Exchange rate is only valid for invoices in currency other than default account currency. If not specified it will get the market rate based on the Date Issued
    @jsondata:Name {value: "ExchangeRate"}
    decimal exchangeRate?;
    # Line items to include on the bill. At least one line item is required
    @jsondata:Name {value: "LineItems"}
    NewBillLineItem[] lineItems?;
    # Specified value will be used to create a new customer contact only if a new customer is being created
    @jsondata:Name {value: "Email"}
    string email?;
    # If true, fires the bill_created webhook event to any subscribed endpoints. Defaults to false to preserve existing integration behaviour
    @jsondata:Name {value: "SendWebhooks"}
    boolean sendWebhooks?;
    # Specified value will be used to create a new customer contact only if a new customer is being created
    @jsondata:Name {value: "Lastname"}
    string lastname?;
    # The bill template to render the bill with (a BILL type template). Use GET /api/InvoiceTemplate?TemplateTypeCode=BILL to look up template IDs by name. If left blank the account default bill template will be used
    @jsondata:Name {value: "BillTemplateIDFK"}
    int:Signed32 billTemplateIDFK?;
    # If left blank then you must specify Company Name
    @jsondata:Name {value: "CompanyIDFK"}
    int:Signed32 companyIDFK?;
    #  "If left blank we will set it to customer default. If specified then it must match one of your existing pre configured payment term periods. Your account starts with:
    # (-1 --- Custom, 0 --- Upon Receipt, 7 --- 7 Days, 15 --- 15 Days, 30 --- 30 Days, 45 --- 45 Days, 60 --- 60 Days)
    @jsondata:Name {value: "PaymentTerms"}
    int:Signed32 paymentTerms?;
    # Pass any string. If left blank it will use the next number in the auto incrementing sequence. If an integer is passed then the largest integer will be use as the seed to auto generate the next invoice number in the sequence
    @jsondata:Name {value: "BillNumber"}
    string billNumber?;
    # Plain UTF8 text. (no HTML). 255 characters max
    @jsondata:Name {value: "Subject"}
    string subject?;
    # A prefix for the Invoice number. e.g. 'INV'. If left blank it will be set to the account default. Max length 20 characters
    @jsondata:Name {value: "TransactionPrefix"}
    string transactionPrefix?;
    # Specified value will be used to create a new customer contact only if a new customer is being created
    @jsondata:Name {value: "Firstname"}
    string firstname?;
    # Expects ISO Standard 3 character currency code. If left blank the currency will default to account's currency in general setting. For existing companies this field will be ignored and the invoice will use the currency of the customer. For new customers if the currency is not specified then account currency will be used otherwise the specified currency will be used
    @jsondata:Name {value: "CurrencyCode"}
    string currencyCode?;
    # If left blank then you must specify Company ID. Specified Name will be used to match existing customer record. If not matched then it will be used to create a new customer. First Name, Last Name and Email will only be used if it is a new company. If the Company name appears multiple times we will check the email address to find a matching company. If email address doesn't identify a matching company then the invoice creation will be rejected
    @jsondata:Name {value: "CompanyName"}
    string companyName?;
    # Plain UTF8 text. 100 characters max
    @jsondata:Name {value: "SupplierPONumber"}
    string supplierPONumber?;
    # If not specified it will use today's date. The date should be specified as local date
    @jsondata:Name {value: "DateIssued"}
    string dateIssued?;
    # It will be auto calculated based on the payment term and issue date. Due Date must be greater than or equal to Issue Date. If the Due Date is specified then Payment Terms will be set to -1 (Custom)
    @jsondata:Name {value: "DueDate"}
    string dueDate?;
    # Plain UTF8 text. (no HTML). Max 2000 characters
    @jsondata:Name {value: "Notes"}
    string notes?;
    # Possible values are (EX --- Tax Exclusive, INC --- Tax Inclusive). If left empty it will use the account default
    @jsondata:Name {value: "TransactionTaxConfigCode"}
    string transactionTaxConfigCode?;
};

# New Subscription to be Created
public type CreateSubscription record {
    # The URL that should be notified of the event
    @jsondata:Name {value: "target_url"}
    string targetUrl;
    # Optional Secret string (255 char max). If provided, the secret will be BASE 64 encoded and used as a basic authentication http header with webhook notifications. i.e. Authorization Basic [BASE64 of Secret]"
    string secret?;
    # The event code to be notified about. Possible values: company_created, company_deleted, company_updated, contact_created, contact_deleted, contact_updated, invoice_created, invoice_sent, invoice_updated, invoice_deleted, project_created, project_deleted, project_updated, task_created, task_updated, task_deleted, timesheet_created, timesheet_deleted, timesheet_updated, bill_created, bill_updated, estimate_created, estimate_updated, estimate_deleted, team_member_created, team_member_updated, team_member_deleted
    string event;
};

# A group within aggregated timesheet data, representing totals for one grouping dimension (e.g. a specific project or user)
public type TimesheetSummaryGroup record {
    # The display name of the group value (e.g. project title, user name)
    @jsondata:Name {value: "GroupName"}
    string groupName?;
    # Total hours for this group
    @jsondata:Name {value: "TotalHours"}
    decimal totalHours?;
    # Total billable hours for this group
    @jsondata:Name {value: "BillableHours"}
    decimal billableHours?;
    # The ID of the group value (e.g. Project ID, User ID)
    @jsondata:Name {value: "GroupID"}
    string groupID?;
    # Nested group data for the next grouping level, if applicable
    @jsondata:Name {value: "GroupData"}
    TimesheetSummaryGroup[] groupData?;
};

# Result of creating a webhook subscription, containing the new Subscription ID
public type SubscribeResult record {
    # The ID of the newly created webhook subscription
    @jsondata:Name {value: "ID"}
    int:Signed32 iD?;
};

# Represents the Queries record for the operation: listTimesheets
public type ListTimesheetsQueries record {
    # Filter timesheets by Task ID
    @http:Query {name: "TaskID"}
    int:Signed32 taskID?;
    # Page to display. Starts from 1
    int:Signed32 pageNumber?;
    # When true, includes invoice Transaction ID and line item ID for invoiced entries
    boolean includeInvoiceDetails?;
    # Filter timesheets with an entry date on or after this date (ISO 8601)
    @http:Query {name: "EntryDateFrom"}
    string entryDateFrom?;
    # Filter timesheets by Project ID
    @http:Query {name: "ProjectID"}
    int:Signed32 projectID?;
    # Filter by invoiced status: true or false
    boolean isInvoiced?;
    # Number of items per page (max 1000)
    int:Signed32 pageSize?;
    # Only return timesheets whose project belongs to this customer company
    @http:Query {name: "CustomerID"}
    int:Signed32 customerID?;
    # Filter timesheets by the email address of the timesheet user
    @http:Query {name: "UserEmail"}
    string userEmail?;
    # Only return timesheets updated after this date-time
    @http:Query {name: "UpdatedAfter"}
    string updatedAfter?;
    # Filter by billable status: true or false
    boolean isBillable?;
    # The UserID of a timesheet user to filter timesheets for. Only api users with certain higher roles can see timesheets across multiple users
    @http:Query {name: "UserID"}
    int:Signed32 userID?;
    # Filter timesheets with an entry date on or before this date (ISO 8601)
    @http:Query {name: "EntryDateTo"}
    string entryDateTo?;
    # Filter timesheets by category name
    @http:Query {name: "CategoryName"}
    string categoryName?;
    # Filter by approval status. Values: Draft, Pending, AutoApproved, Approved, Rejected
    @http:Query {name: "TimesheetEntryApprovalStatusCode"}
    string timesheetEntryApprovalStatusCode?;
    # Filter to only entries that currently have a running timer (true) or not (false)
    boolean isTimerRunning?;
    # Optional sorting instruction. Currently possible values: "DateUpdated", "DateCreated", "DateUpdated desc", "DateCreated desc","EntryDate", "EntryDate desc", "StartTimeLocal","StartTimeLocal desc", "TimeSheetEntryID", "TimeSheetEntryID desc"
    @http:Query {name: "Sort"}
    string sort?;
};

# Represents the Queries record for the operation: listTasks
public type ListTasksQueries record {
    # Set false to omit the CustomFields collection from each task. Defaults to true
    @http:Query {name: "IncludeCustomFields"}
    boolean includeCustomFields?;
    # Page to display. Starts from 1. Defaults to 1
    int:Signed32 pageNumber?;
    # Optional filter on task hierarchy. true = only root-level tasks (ParentTaskIDFK IS NULL); false = only subtasks (ParentTaskIDFK IS NOT NULL); omitted = no filter
    boolean isRootLevel?;
    # Optional filter to only display tasks with a specific status
    @http:Query {name: "TaskStatusCode"}
    string taskStatusCode?;
    # Optional filter to only display tasks belonging to a specific ProjectID
    @http:Query {name: "ProjectID"}
    int:Signed32 projectID?;
    # Number of items per page. Defaults to 20
    int:Signed32 pageSize?;
    # Optional filter to only display tasks with a specific priority
    @http:Query {name: "TaskPriorityCode"}
    string taskPriorityCode?;
    # Optional filter to records updated after a specific date
    @http:Query {name: "UpdatedAfter"}
    string updatedAfter?;
    # Optional filter to only display subtasks of the given parent task ID (i.e. tasks where ParentTaskIDFK = value)
    @http:Query {name: "ParentTaskIDFK"}
    int:Signed32 parentTaskIDFK?;
    # Optional filter to only display tasks with a Due Date after DueDateFrom
    @http:Query {name: "DueDateFrom"}
    string dueDateFrom?;
    # Optional filter to only display tasks with at least one of the provided UserIDs set as the Assigned User
    @http:Query {name: "AssignedToUserIDs"}
    int:Signed32[] assignedToUserIDs?;
    # Optional sorting instruction. Currently possible values: "DateUpdated", "DateCreated", "DateUpdated desc", "DateCreated desc", "SectionTitle", "Title"
    @http:Query {name: "Sort"}
    string sort?;
    # Optional filter to only display tasks with a Due Date before DueDateTo
    @http:Query {name: "DueDateTo"}
    string dueDateTo?;
    # Optional filter to only display tasks linked to a Task Status where isComplete=false, or where isComplete=true
    boolean isComplete?;
};

# Full details of a single timesheet entry including user, project, category, approval, timer, and rate information
public type TimesheetDetails record {
    # Email address of the timesheet user
    @jsondata:Name {value: "Email"}
    string email?;
    # The UTC start time of the entry, if start/end time tracking is enabled
    @jsondata:Name {value: "StartTimeUTC"}
    string startTimeUTC?;
    # The project ID this timesheet entry is associated with
    @jsondata:Name {value: "ProjectIDFK"}
    int:Signed32 projectIDFK?;
    # Whether this timesheet entry has been included on an invoice
    boolean isInvoiced?;
    # The local end time of the entry, if start/end time tracking is enabled
    @jsondata:Name {value: "EndTimeLocal"}
    string endTimeLocal?;
    # Date and time the record was created (UTC)
    @jsondata:Name {value: "DateCreated"}
    string dateCreated?;
    # Only visible to Admin role users
    @jsondata:Name {value: "RateAmount"}
    decimal rateAmount?;
    # The timesheet category ID applied to this entry
    @jsondata:Name {value: "TimesheetCategoryIDFK"}
    int:Signed32 timesheetCategoryIDFK?;
    # The UTC end time of the entry, if start/end time tracking is enabled
    @jsondata:Name {value: "EndTimeUTC"}
    string endTimeUTC?;
    # URL to view this timesheet entry's day in the Avaza web application
    @jsondata:Name {value: "ViewTimesheetURL"}
    string viewTimesheetURL?;
    # The IANA time zone ID of the user who owns the timesheet
    @jsondata:Name {value: "TimesheetUserTimeZone"}
    string timesheetUserTimeZone?;
    # Unique identifier for the timesheet entry
    @jsondata:Name {value: "TimesheetEntryID"}
    int timesheetEntryID?;
    # The invoice line item ID this entry was billed on, if invoiced
    @jsondata:Name {value: "InvoiceLineItemIDFK"}
    int invoiceLineItemIDFK?;
    # Only visible to Admin role users
    @jsondata:Name {value: "CostAmount"}
    decimal costAmount?;
    # Project code of the associated project, if project codes are enabled
    @jsondata:Name {value: "ProjectCode"}
    string projectCode?;
    # Name of the customer/company associated with the project
    @jsondata:Name {value: "CustomerName"}
    string customerName?;
    # The UTC date and time at which the timer was started, if a timer is running
    @jsondata:Name {value: "TimerStartedAtUTC"}
    string timerStartedAtUTC?;
    # Free-text notes attached to this timesheet entry
    @jsondata:Name {value: "Notes"}
    string notes?;
    # Date and time the record was last updated (UTC)
    @jsondata:Name {value: "DateUpdated"}
    string dateUpdated?;
    # The task ID this timesheet entry is linked to, if any
    @jsondata:Name {value: "TaskIDFK"}
    int:Signed32 taskIDFK?;
    # Last name of the timesheet user
    @jsondata:Name {value: "Lastname"}
    string lastname?;
    # Title of the task this entry is linked to
    @jsondata:Name {value: "TaskTitle"}
    string taskTitle?;
    # Duration of the timesheet entry in decimal hours
    @jsondata:Name {value: "Duration"}
    decimal duration?;
    # Whether this timesheet entry is billable to the client
    boolean isBillable?;
    # The invoice Transaction ID this entry was billed on, if invoiced
    @jsondata:Name {value: "InvoiceIDFK"}
    int invoiceIDFK?;
    # First name of the timesheet user
    @jsondata:Name {value: "Firstname"}
    string firstname?;
    # The customer/company ID associated with the project
    @jsondata:Name {value: "CustomerIDFK"}
    int:Signed32 customerIDFK?;
    # Title of the associated project
    @jsondata:Name {value: "ProjectTitle"}
    string projectTitle?;
    # Whether a timer is currently running on this entry
    @jsondata:Name {value: "HasTimer"}
    boolean hasTimer?;
    # The local start time of the entry, if start/end time tracking is enabled
    @jsondata:Name {value: "StartTimeLocal"}
    string startTimeLocal?;
    # Name or email of the user who approved this entry
    @jsondata:Name {value: "ApprovedBy"}
    string approvedBy?;
    # The date of the timesheet entry
    @jsondata:Name {value: "EntryDate"}
    string entryDate?;
    # The ID of the user who owns this timesheet entry
    @jsondata:Name {value: "UserIDFK"}
    int:Signed32 userIDFK?;
    # Name of the timesheet category applied to this entry
    @jsondata:Name {value: "CategoryName"}
    string categoryName?;
    # Approval status of the entry. Values: Draft, Pending, Approved, Rejected, AutoApproved
    @jsondata:Name {value: "TimesheetEntryApprovalStatusCode"}
    string timesheetEntryApprovalStatusCode?;
    # Date and time the entry was approved, if applicable
    @jsondata:Name {value: "DateApproved"}
    string dateApproved?;
    # Optional free-form metadata field for storing additional information. Maximum 1000 characters
    @jsondata:Name {value: "CustomMetadata"}
    string customMetadata?;
};

# A payment made to a supplier, including allocations to specific bills
public type BillPayment record {
    # Exchange rate to the account's base currency
    @jsondata:Name {value: "ExchangeRate"}
    decimal exchangeRate?;
    # List of allocations applying this payment to specific bills
    @jsondata:Name {value: "PaymentAllocations"}
    BillPaymentAllocation[] paymentAllocations?;
    # External reference number (e.g. cheque number or bank reference)
    @jsondata:Name {value: "TransactionReference"}
    string transactionReference?;
    # Date and time the record was last updated
    @jsondata:Name {value: "DateUpdated"}
    string dateUpdated?;
    # The Avaza account this payment belongs to
    @jsondata:Name {value: "AccountIDFK"}
    int:Signed32 accountIDFK?;
    # Date and time the record was created
    @jsondata:Name {value: "DateCreated"}
    string dateCreated?;
    # Total payment amount
    @jsondata:Name {value: "TotalAmount"}
    decimal totalAmount?;
    # Unique identifier for the payment transaction
    @jsondata:Name {value: "TransactionID"}
    int transactionID?;
    # The prefix used in the payment number
    @jsondata:Name {value: "TransactionPrefix"}
    string transactionPrefix?;
    # ISO 3-character currency code for the payment
    @jsondata:Name {value: "CurrencyCode"}
    string currencyCode?;
    # The supplier company ID this payment is made to
    @jsondata:Name {value: "SupplierIDFK"}
    int:Signed32 supplierIDFK?;
    # The date the payment was made
    @jsondata:Name {value: "DateIssued"}
    string dateIssued?;
    # URL to view this bill payment in the Avaza web application
    @jsondata:Name {value: "ViewBillPaymentURL"}
    string viewBillPaymentURL?;
    # Current status of the payment
    @jsondata:Name {value: "TransactionStatusCode"}
    string transactionStatusCode?;
    # Code identifying the payment provider/method used
    @jsondata:Name {value: "PaymentProviderCode"}
    string paymentProviderCode?;
    # Unallocated balance remaining on the payment
    @jsondata:Name {value: "Balance"}
    decimal balance?;
    # The full payment number including prefix
    @jsondata:Name {value: "PaymentNumber"}
    string paymentNumber?;
    # Additional notes on the payment
    @jsondata:Name {value: "Notes"}
    string notes?;
};

# Request model for creating a new customer invoice. Supports automatic company/contact creation
public type NewInvoice record {
    # Exchange rate is only valid for invoices in currency other than default account currency. If not specified it will get the market rate based on the Date Issued
    @jsondata:Name {value: "ExchangeRate"}
    decimal exchangeRate?;
    @jsondata:Name {value: "LineItems"}
    NewInvoiceLineItem[] lineItems?;
    # Specified value will be used to create a new customer contact only if a new customer is being created
    @jsondata:Name {value: "Email"}
    string email?;
    # If true, fires the invoice_created webhook event to any subscribed endpoints (and timesheet_updated / expense_updated for any timesheets or expenses pulled into the invoice). Defaults to false to preserve existing integration behaviour
    @jsondata:Name {value: "SendWebhooks"}
    boolean sendWebhooks?;
    # Specified value will be used to create a new customer contact only if a new customer is being created
    @jsondata:Name {value: "Lastname"}
    string lastname?;
    # If left blank then you must specify Company Name
    @jsondata:Name {value: "CompanyIDFK"}
    int:Signed32 companyIDFK?;
    #  "If left blank we will set it to customer default. If specified then it must match one of your existing pre configured payment term periods. Your account starts with:
    # (-1 --- Custom, 0 --- Upon Receipt, 7 --- 7 Days, 15 --- 15 Days, 30 --- 30 Days, 45 --- 45 Days, 60 --- 60 Days)
    @jsondata:Name {value: "PaymentTerms"}
    int:Signed32 paymentTerms?;
    # Plain UTF8 text. (no HTML). 255 characters max
    @jsondata:Name {value: "Subject"}
    string subject?;
    # A prefix for the Invoice number. e.g. 'INV'. If left blank it will be set to the account default. Max length 20 characters
    @jsondata:Name {value: "TransactionPrefix"}
    string transactionPrefix?;
    # Specified value will be used to create a new customer contact only if a new customer is being created
    @jsondata:Name {value: "Firstname"}
    string firstname?;
    # Expects ISO Standard 3 character currency code. If left blank the currency will default to account's currency in general setting. For existing companies this field will be ignored and the invoice will use the currency of the customer. For new customers if the currency is not specified then account currency will be used otherwise the specified currency will be used
    @jsondata:Name {value: "CurrencyCode"}
    string currencyCode?;
    # If left blank then you must specify Company ID. Specified Name will be used to match existing customer record. If not matched then it will be used to create a new customer. First Name, Last Name and Email will only be used if it is a new company. If the Company name appears multiple times we will check the email address to find a matching company. If email address doesn't identify a matching company then the invoice creation will be rejected
    @jsondata:Name {value: "CompanyName"}
    string companyName?;
    # Plain UTF8 text. 100 characters max
    @jsondata:Name {value: "CustomerPONumber"}
    string customerPONumber?;
    # If not specified it will use today's date. The date should be specified as local date
    @jsondata:Name {value: "DateIssued"}
    string dateIssued?;
    # Optional exchange-rate overrides applied when line items link Expenses in a currency different from the invoice currency. Expenses in currencies without an override use the stored/market rate. Ignored when no expenses are linked. Note: line item links cannot be used when creating a new customer company
    @jsondata:Name {value: "ExpenseExchangeRates"}
    ExpenseExchangeRate[] expenseExchangeRates?;
    # The invoice template to render the invoice with (an INV or EST type template). Use GET /api/InvoiceTemplate to look up template IDs by name. If left blank the account default invoice template will be used
    @jsondata:Name {value: "InvoiceTemplateIDFK"}
    int:Signed32 invoiceTemplateIDFK?;
    # Pass any string. If left blank it will use the next number in the auto incrementing sequence. If an integer is passed then the largest integer will be use as the seed to auto generate the next invoice number in the sequence
    @jsondata:Name {value: "InvoiceNumber"}
    string invoiceNumber?;
    # It will be auto calculated based on the payment term and issue date. Due Date must be greater than or equal to Issue Date. If the Due Date is specified then Payment Terms will be set to -1 (Custom)
    @jsondata:Name {value: "DueDate"}
    string dueDate?;
    # Plain UTF8 text. (no HTML). Max 2000 characters
    @jsondata:Name {value: "Notes"}
    string notes?;
    # Possible values are (EX --- Tax Exclusive, INC --- Tax Inclusive). If left empty it will use the account default
    @jsondata:Name {value: "TransactionTaxConfigCode"}
    string transactionTaxConfigCode?;
};

# An allocation record linking a customer payment to a specific invoice
public type PaymentAllocation record {
    # The amount allocated from the payment to the invoice
    @jsondata:Name {value: "AllocationAmount"}
    decimal allocationAmount?;
    # Unique identifier for this payment allocation
    @jsondata:Name {value: "TransactionAllocationID"}
    int transactionAllocationID?;
    # The date this allocation was applied
    @jsondata:Name {value: "AllocationDate"}
    string allocationDate?;
    # The payment Transaction ID this allocation belongs to
    @jsondata:Name {value: "PaymentTransactionIDFK"}
    int paymentTransactionIDFK?;
    # The invoice Transaction ID this payment is allocated against
    @jsondata:Name {value: "InvoiceTransactionIDFK"}
    int invoiceTransactionIDFK?;
};

# A task priority definition including code, display name, color, and sort order
public type TaskPriorityDetails record {
    # Sort order position for display (ascending)
    @jsondata:Name {value: "DisplayOrder"}
    int:Signed32 displayOrder?;
    # Unique identifier for the task priority
    @jsondata:Name {value: "TaskPriorityID"}
    int:Signed32 taskPriorityID?;
    # Short code identifying this priority (e.g. "High", "Low")
    @jsondata:Name {value: "PriorityCode"}
    string priorityCode?;
    # Hex color code for priority badge rendering
    @jsondata:Name {value: "Color"}
    string color?;
    # Display name of the priority
    @jsondata:Name {value: "Name"}
    string name?;
};

# Account-level configuration details including timesheet settings, currency, and branding options
public type AccountDetails record {
    # Unique identifier for the Avaza account
    @jsondata:Name {value: "AccountID"}
    int:Signed32 accountID?;
    # The day of the week that starts the timesheet week (0=Sunday, 1=Monday, etc.)
    @jsondata:Name {value: "TimesheetDayOfWeek"}
    int:Signed32 timesheetDayOfWeek?;
    # Format: ISO "YYYY-MM-DD HH:mm:ss.SSS"
    @jsondata:Name {value: "CurrentServerTimeISO"}
    string currentServerTimeISO?;
    # The primary email address associated with the account
    @jsondata:Name {value: "AccountEmail"}
    string accountEmail?;
    # Whether users can hide completed tasks when selecting tasks on timesheets
    @jsondata:Name {value: "AllowHidingCompletedTasksOnTimesheet"}
    boolean allowHidingCompletedTasksOnTimesheet?;
    @jsondata:Name {value: "SC"}
    string sC?;
    # The registered company/organisation name for the account
    @jsondata:Name {value: "CompanyName"}
    string companyName?;
    # AI receipt scanning is available to this account (POST api/Expense/ScanReceipt): enabled in Expense Settings on a paid plan
    @jsondata:Name {value: "ReceiptAIEnabled"}
    boolean receiptAIEnabled?;
    # Whether the account displays times in 24-hour format (true) or 12-hour format (false)
    boolean has24HourTimesheetFormat?;
    # The unique subdomain for the account (e.g. 'mycompany' in mycompany.avaza.com)
    @jsondata:Name {value: "Subdomain"}
    string subdomain?;
    # Whether the account is configured to track start and end times on timesheet entries
    boolean hasStartEndTimesheets?;
    # Whether the account requires expenses be approved
    @jsondata:Name {value: "ExpenseApprovalRequired"}
    boolean expenseApprovalRequired?;
    # Whether approved timesheets are locked from further editing by standard users
    @jsondata:Name {value: "LockApprovedTimesheets"}
    boolean lockApprovedTimesheets?;
    # ISO 3 letter base Currency Code for the account
    @jsondata:Name {value: "DefaultCurrencyCode"}
    string defaultCurrencyCode?;
    # A determination of the luminance of the Brand Primary Color (possible values: 'Dark', 'Medium', 'Light'). This can be used to determine appropriate font colors to sit on top of the brand color
    @jsondata:Name {value: "BrandPrimaryColorLuminance"}
    string brandPrimaryColorLuminance?;
    # The display format for timesheets (e.g. decimal hours vs hours:minutes)
    @jsondata:Name {value: "TimesheetDisplayFormatCode"}
    string timesheetDisplayFormatCode?;
    # A custom branding color for the account. Available on paid accounts
    @jsondata:Name {value: "BrandPrimaryColor"}
    string brandPrimaryColor?;
    # Approved expenses get locked from subsequent editing by standard expense users
    @jsondata:Name {value: "LockApprovedExpenses"}
    boolean lockApprovedExpenses?;
    # Whether weekly timesheet reminder emails are enabled for the account
    @jsondata:Name {value: "WeeklyTimesheetReminder"}
    boolean weeklyTimesheetReminder?;
};

# Represents the Queries record for the operation: listScheduleSeries
public type ListScheduleSeriesQueries record {
    # Filter for schedules that end on or before a specific date
    @http:Query {name: "ScheduleEndDateTo"}
    string scheduleEndDateTo?;
    # Page to display. Starts from 1
    int:Signed32 pageNumber?;
    # Filter to only include records linked to projects, where that project belongs to a specific customer company
    @http:Query {name: "CompanyID"}
    int:Signed32 companyID?;
    # Filter for schedules that start on or before a specific date
    @http:Query {name: "ScheduleStartDateTo"}
    string scheduleStartDateTo?;
    # Filter to only include books linked to a specific project
    @http:Query {name: "ProjectID"}
    int:Signed32 projectID?;
    # Number of items per page (max 1000)
    int:Signed32 pageSize?;
    # The email of the user who has been scheduled
    @http:Query {name: "UserEmail"}
    string userEmail?;
    # Filter to records of a particular leave type
    @http:Query {name: "LeaveTypeID"}
    int:Signed32 leaveTypeID?;
    # Limit results to records updated after the specified date
    @http:Query {name: "UpdatedAfter"}
    string updatedAfter?;
    # Filter for schedules that start on or after a specific date
    @http:Query {name: "ScheduleStartDateFrom"}
    string scheduleStartDateFrom?;
    # The UserID of a schedule user to filter assignments for. Only api users with Admin role can see all schedules across all users. Users with ScheduleUser role can access their own ScheduleSeries
    @http:Query {name: "UserID"}
    int:Signed32 userID?;
    # Filter for schedule records linked to a specific timesheeet category
    @http:Query {name: "TimeSheetCategoryID"}
    int:Signed32 timeSheetCategoryID?;
    # Optional sorting instruction. Currently possible values: "DateUpdated", "DateCreated", "DateUpdated desc", "DateCreated desc"
    @http:Query {name: "Sort"}
    string sort?;
    # Filter for schedule records with a specific timesheeet category name (exact string match)
    @http:Query {name: "TimeSheetCategoryName"}
    string timeSheetCategoryName?;
    # Filter for schedules that end on or after a specific date
    @http:Query {name: "ScheduleEndDateFrom"}
    string scheduleEndDateFrom?;
};

# A recurring invoice profile defining automatic invoice generation on a schedule, with line items and configuration
public type RecurringInvoice record {
    # Whether the profile continues generating invoices indefinitely with no expiry
    @jsondata:Name {value: "NeverExpires"}
    boolean neverExpires?;
    # The exchange rate applied when the invoice currency differs from the account default currency
    @jsondata:Name {value: "ExchangeRate"}
    decimal exchangeRate?;
    # The number of invoice cycles remaining before the profile completes. Null if the profile never expires
    @jsondata:Name {value: "NumberOfCyclesRemaining"}
    int:Signed32 numberOfCyclesRemaining?;
    # The subtotal amount before tax and discounts
    @jsondata:Name {value: "SubtotalAmount"}
    decimal subtotalAmount?;
    # The date and time this recurring invoice profile was created
    @jsondata:Name {value: "DateCreated"}
    string dateCreated?;
    # A friendly name for the recurring invoice profile
    @jsondata:Name {value: "ProfileName"}
    string profileName?;
    # The date the recurring profile first generates an invoice
    @jsondata:Name {value: "StartDate"}
    string startDate?;
    # The ISO 3-letter currency code for the generated invoices
    @jsondata:Name {value: "CurrencyCode"}
    string currencyCode?;
    # The name of the customer company this recurring invoice is billed to
    @jsondata:Name {value: "CompanyName"}
    string companyName?;
    # The total tax amount on the recurring invoice profile
    @jsondata:Name {value: "TaxAmount"}
    decimal taxAmount?;
    # URL to view this recurring invoice in the Avaza web application
    @jsondata:Name {value: "ViewRecurringInvoiceURL"}
    string viewRecurringInvoiceURL?;
    # Additional notes or terms that appear on generated invoices
    @jsondata:Name {value: "Notes"}
    string notes?;
    # Status of the recurring profile (e.g. Active, Paused, Completed)
    @jsondata:Name {value: "RecurringProfileStatusCode"}
    string recurringProfileStatusCode?;
    # The line items that will appear on each generated invoice
    @jsondata:Name {value: "LineItems"}
    RecurringInvoiceLineItem[] lineItems?;
    # The date and time this recurring invoice profile was last updated
    @jsondata:Name {value: "DateUpdated"}
    string dateUpdated?;
    # The account this recurring invoice profile belongs to
    @jsondata:Name {value: "AccountIDFK"}
    int:Signed32 accountIDFK?;
    # The ID of the customer company this recurring invoice is billed to
    @jsondata:Name {value: "CompanyIDFK"}
    int:Signed32 companyIDFK?;
    # The total amount including tax and after discounts
    @jsondata:Name {value: "TotalAmount"}
    decimal totalAmount?;
    # The date the most recent invoice was generated from this profile
    @jsondata:Name {value: "LastInvoiceDate"}
    string lastInvoiceDate?;
    # The date the next invoice will be generated from this profile
    @jsondata:Name {value: "NextInvoiceDate"}
    string nextInvoiceDate?;
    # The subject/title text that appears on generated invoices
    @jsondata:Name {value: "Subject"}
    string subject?;
    # The total discount amount applied to the profile
    @jsondata:Name {value: "DiscountAmount"}
    decimal discountAmount?;
    # The total number of invoice cycles configured for this profile. Null if the profile never expires
    @jsondata:Name {value: "NumberOfCycles"}
    int:Signed32 numberOfCycles?;
    # Whether automatic charging is enabled for this recurring profile
    boolean isAutoChargeEnabled?;
    # Unique identifier for the recurring invoice profile
    @jsondata:Name {value: "RecurringInvoiceID"}
    int recurringInvoiceID?;
    # The frequency at which invoices are generated (e.g. Weekly, Monthly, Yearly)
    @jsondata:Name {value: "RecurringProfileFrequencyCode"}
    string recurringProfileFrequencyCode?;
    # For custom frequency profiles, the number of units between invoice generations
    @jsondata:Name {value: "CustomFrequencyNumber"}
    int:Signed32 customFrequencyNumber?;
    # Specifies whether generated invoices are tax exclusive or tax inclusive (e.g. EX, INC)
    @jsondata:Name {value: "TransactionTaxConfigCode"}
    string transactionTaxConfigCode?;
};

# Represents the Queries record for the operation: listSections
public type ListSectionsQueries record {
    # Get sections for Project with ProjectID
    @http:Query {name: "ProjectID"}
    int:Signed32 projectID;
};

# Transfer descriptor for a signed upload URL
public type FileAttachmentUploadTransfer record {
    # Headers to send with the PUT (currently Content-Type). Optional: the server applies the authorised type regardless
    @jsondata:Name {value: "Headers"}
    record {|string...;|} headers?;
    # Always "PUT". The file bytes are the raw request body (no multipart wrapper)
    @jsondata:Name {value: "Method"}
    string method?;
    # Always "https"
    @jsondata:Name {value: "Transport"}
    string transport?;
    # UTC instant after which the URL is rejected with 410
    @jsondata:Name {value: "ExpiresAt"}
    string expiresAt?;
    # Single-use signed URL. Treat it as a bearer credential; it expires at ExpiresAt
    @jsondata:Name {value: "Url"}
    string url?;
};

# Collection of an account's project tags
public type ProjectTagList record {
    # The account's project tags, sorted alphabetically by name (case-insensitive)
    @jsondata:Name {value: "Tags"}
    ProjectTagItem[] tags?;
};

# A line item to be included on a new invoice
public type NewInvoiceLineItem record {
    # Plain UTF8 text. (no HTML). When the line item links source records and this is omitted, a description is generated from the linked records
    @jsondata:Name {value: "Description"}
    string description?;
    # Enter 10.5 to give a 10.5% discount
    @jsondata:Name {value: "Discount"}
    decimal discount?;
    # If specified then it must match an existing Tax ID. If not specified then Tax Name and Tax Percent must be specified - except on a line item linking source records, where the tax is derived from the linked records when omitted
    @jsondata:Name {value: "TaxIDFK"}
    int:Signed32 taxIDFK?;
    # Must be specified if the Tax ID is blank. If the Tax Name is specified it will be matched to an existing Tax Name or else a new Tax will be created
    @jsondata:Name {value: "TaxName"}
    string taxName?;
    # Optional. Project ID of an Avaza Project that belongs to this customer, so line item is attributed to that Project for reporting. Must be omitted when the line item links source records (it is derived from them)
    @jsondata:Name {value: "ProjectIDFK"}
    int:Signed32 projectIDFK?;
    # If not specified then Inventory Item Name must be specified
    @jsondata:Name {value: "InventoryItemIDFK"}
    int:Signed32 inventoryItemIDFK?;
    # The quantity for the line item. Required unless the line item links source records (TimesheetEntryIDs / ExpenseIDs / FixedAmountIDs), in which case it is calculated from the linked records when omitted (e.g. total timesheet duration with account rounding applied)
    @jsondata:Name {value: "Quantity"}
    decimal quantity?;
    # The Tax Percent will only be used if a new tax is being created
    @jsondata:Name {value: "TaxPercent"}
    decimal taxPercent?;
    # If not specified then Inventory item ID must be specified. If specified and not matched to any existing inventory items then a new inventory item will be created. Max 200 characters
    @jsondata:Name {value: "InventoryItemName"}
    string inventoryItemName?;
    # Optional. IDs of uninvoiced chargeable Expenses (Approved or AutoApproved, belonging to the invoice's customer) to link to this line item. Multiple expenses grouped onto one line must share the same tax. Quantity is 1 and UnitPrice is calculated from the expense amounts (including category markup and currency conversion) unless overridden. A line item may link only ONE source type, and InventoryItemIDFK/InventoryItemName/ProjectIDFK must be omitted on linked lines
    @jsondata:Name {value: "ExpenseIDs"}
    int[] expenseIDs?;
    # The unit price for the lineitem. Required unless the line item links source records, in which case it is calculated from the linked records when omitted (timesheets: the billable rate, blended when rates differ; expenses: converted amount including category markup; fixed amounts: the amount)
    @jsondata:Name {value: "UnitPrice"}
    decimal unitPrice?;
    # Optional. IDs of uninvoiced Timesheet entries to link to (invoice with) this line item. All entries must be billable, Approved or AutoApproved, not already invoiced, have no running timer, belong to the invoice's customer, and share a single project. Put one ID per line item for a dedicated line per entry, or several IDs to group them into one line. A line item may link only ONE source type, and InventoryItemIDFK/InventoryItemName/ProjectIDFK must be omitted on linked lines (they are derived from the source records)
    @jsondata:Name {value: "TimesheetEntryIDs"}
    int[] timesheetEntryIDs?;
    # Optional. ID of an uninvoiced Fixed Amount to link to this line item - maximum ONE per line item (fixed amounts are always invoiced on their own line). Quantity is 1 and UnitPrice/Tax/InventoryItem come from the fixed amount unless overridden. A line item may link only ONE source type, and InventoryItemIDFK/InventoryItemName/ProjectIDFK must be omitted on linked lines
    @jsondata:Name {value: "FixedAmountIDs"}
    int[] fixedAmountIDs?;
};

# Aggregated counts for a batch approve or reject request
public type TimesheetApprovalSummary record {
    # Number of TimeSheetEntryIDs supplied in the request
    @jsondata:Name {value: "Requested"}
    int:Signed32 requested?;
    # Number of entries that successfully transitioned to the target status
    @jsondata:Name {value: "Succeeded"}
    int:Signed32 succeeded?;
    # Number of entries that were already in the target status
    @jsondata:Name {value: "AlreadyInTargetState"}
    int:Signed32 alreadyInTargetState?;
    # Number of entries that could not be processed (forbidden, not found, ineligible, invoiced/paid, etc)
    @jsondata:Name {value: "Failed"}
    int:Signed32 failed?;
    # Number of entries the server inspected (always equals Requested)
    @jsondata:Name {value: "Processed"}
    int:Signed32 processed?;
};

# Represents the Queries record for the operation: getTimesheetSummary
public type GetTimesheetSummaryQueries record {
    # (Optional) Filter by the billable status of Timesheets
    @http:Query {name: "model.isBillable"}
    boolean modelIsBillable?;
    # (Optional) Filter for timesheets by whether they have been Invoiced or not
    @http:Query {name: "model.isInvoiced"}
    boolean modelIsInvoiced?;
    # (Optional) Filter for timesheets that belong to one of the specified statuses (Draft, Pending, Approved, AutoApproved, Rejected)
    @http:Query {name: "model.timesheetEntryApprovalStatusCode"}
    string[] modelTimesheetEntryApprovalStatusCode?;
    # (Optional) Combine one, two or three levels of Grouping. Combine these possible grouping values: "Customer", "Project", "Category", "User", "Task", "Year", "Month", "Day", "Week"
    @http:Query {name: "model.groupBy"}
    string[] modelGroupBy?;
    # (Required) Filter for timesheets with an entry date smaller or equal to the specified  date. e.g. 2019-01-25. You can optionally include a time component, otherwise it assumes 00:00
    @http:Query {name: "model.entryDateTo"}
    string modelEntryDateTo?;
    # (Required) Filter for timesheets greater or equal to the specified date. e.g. 2019-01-25. You can optionally include a time component, otherwise it assumes 00:00
    @http:Query {name: "model.entryDateFrom"}
    string modelEntryDateFrom?;
    # (Optional) Filter by Project
    @http:Query {name: "model.projectID"}
    int:Signed32 modelProjectID?;
    # (Optional) Defaults to the current user. Provide one or more UserIDs of Users whose timesheets should be retrieved. If the current user doesn't have impersonation rights, then they will only see their own data
    @http:Query {name: "model.userID"}
    int:Signed32[] modelUserID?;
};

# Collection of sections within a project
public type SectionList record {
    # Total number of sections in the project
    @jsondata:Name {value: "TotalCount"}
    int:Signed32 totalCount?;
    # List of sections in this project
    @jsondata:Name {value: "Sections"}
    SectionDetails[] sections?;
};

# Represents the Queries record for the operation: listDeletedTimesheets
public type ListDeletedTimesheetsQueries record {
    # Number of items per page
    @http:Query {name: "PageSize"}
    int:Signed32 pageSize?;
    # Page number (starts from 1)
    @http:Query {name: "PageNumber"}
    int:Signed32 pageNumber?;
    # Filter by user ID
    @http:Query {name: "UserID"}
    int:Signed32 userID?;
    # Filter by original timesheet entry date (start)
    @http:Query {name: "EntryDateFrom"}
    string entryDateFrom?;
    # Filter by original timesheet entry date (end)
    @http:Query {name: "EntryDateTo"}
    string entryDateTo?;
    # Sort expression (e.g. 'DeletedDate desc', 'EntryDate')
    @http:Query {name: "Sort"}
    string sort?;
    # Filter entries deleted after this UTC date
    @http:Query {name: "DeletedAfter"}
    string deletedAfter?;
};

# Billing address details for the Avaza account (the recipient of the bill)
public type BillRecipientDetails record {
    # Pre-formatted multi-line billing address for the recipient
    @jsondata:Name {value: "RecipientFormattedBillingAddress"}
    string recipientFormattedBillingAddress?;
    # State/province for the recipient
    @jsondata:Name {value: "RecipientBillingAddressState"}
    string recipientBillingAddressState?;
    # Label printed next to your company's tax number: the template's override, else the account's Company Default Tax Number Label, else "Tax Number"
    @jsondata:Name {value: "TaxNumberLabel"}
    string taxNumberLabel?;
    # Postal/ZIP code for the recipient
    @jsondata:Name {value: "RecipientBillingAddressPostCode"}
    string recipientBillingAddressPostCode?;
    # ISO country code for the recipient
    @jsondata:Name {value: "RecipientBillingAddressCountryCode"}
    string recipientBillingAddressCountryCode?;
    # City/suburb for the recipient
    @jsondata:Name {value: "RecipientBillingAddressCity"}
    string recipientBillingAddressCity?;
    # Your company's tax registration number as printed on the bill: the bill template's Company Tax Number override, else the account's Company Default Tax Number. Null when neither is set
    @jsondata:Name {value: "TaxNumber"}
    string taxNumber?;
    # Street address line for the recipient
    @jsondata:Name {value: "RecipientBillingAddressLine"}
    string recipientBillingAddressLine?;
};

# Request model for filtering schedule series with criteria including date ranges, user, project, and category
public type ScheduleSeriesFilterRequest record {
    # Filter series ending on or before this date
    @jsondata:Name {value: "ScheduleEndDateTo"}
    string scheduleEndDateTo?;
    # Filter by the customer company ID of the associated project
    @jsondata:Name {value: "CompanyID"}
    int:Signed32 companyID?;
    # Number of results per page. Default 20, maximum 1000
    @jsondata:Name {value: "PageSize"}
    int:Signed32 pageSize?;
    # Filter series starting on or before this date
    @jsondata:Name {value: "ScheduleStartDateTo"}
    string scheduleStartDateTo?;
    # Filter by project ID
    @jsondata:Name {value: "ProjectID"}
    int:Signed32 projectID?;
    # Filter by the scheduled user's email address
    @jsondata:Name {value: "UserEmail"}
    string userEmail?;
    # Filter by leave type ID
    @jsondata:Name {value: "LeaveTypeID"}
    int:Signed32 leaveTypeID?;
    # Filter to records updated after this date-time
    @jsondata:Name {value: "UpdatedAfter"}
    string updatedAfter?;
    # Filter series starting on or after this date
    @jsondata:Name {value: "ScheduleStartDateFrom"}
    string scheduleStartDateFrom?;
    # 1-based page number. Default 1
    @jsondata:Name {value: "PageNumber"}
    int:Signed32 pageNumber?;
    # Filter by the scheduled user's ID
    @jsondata:Name {value: "UserID"}
    int:Signed32 userID?;
    # Filter by timesheet category ID
    @jsondata:Name {value: "TimeSheetCategoryID"}
    int:Signed32 timeSheetCategoryID?;
    # Optional list of specific Schedule Series IDs to retrieve
    @jsondata:Name {value: "ScheduleSeriesIDs"}
    int[] scheduleSeriesIDs?;
    # Sort order. Values: DateUpdated, DateCreated (append ' desc' for descending)
    @jsondata:Name {value: "Sort"}
    string sort?;
    # Filter by exact timesheet category name
    @jsondata:Name {value: "TimeSheetCategoryName"}
    string timeSheetCategoryName?;
    # Filter series ending on or after this date
    @jsondata:Name {value: "ScheduleEndDateFrom"}
    string scheduleEndDateFrom?;
};

# A detailed expense entry including user, project, category, amount, tax, approval status, and attachment
public type ExpenseDetails record {
    # The expense category ID
    @jsondata:Name {value: "ExpenseCategoryIDFK"}
    int:Signed32 expenseCategoryIDFK?;
    # Exchange rate from expense currency to account base currency
    @jsondata:Name {value: "ExchangeRate"}
    decimal exchangeRate?;
    # Email address of the expense user
    @jsondata:Name {value: "Email"}
    string email?;
    # Unique identifier for the expense entry
    @jsondata:Name {value: "ExpenseID"}
    int expenseID?;
    # The project ID the expense is linked to
    @jsondata:Name {value: "ProjectIDFK"}
    int:Signed32 projectIDFK?;
    # The unit label (e.g. 'miles', 'km') for unit-priced categories
    @jsondata:Name {value: "ExpenseCategoryUnitName"}
    string expenseCategoryUnitName?;
    # Date and time the expense record was created
    @jsondata:Name {value: "DateCreated"}
    string dateCreated?;
    @jsondata:Name {value: "AiExtraction"}
    ExpenseAiExtraction aiExtraction?;
    # Url to view the Expense in Avaza
    @jsondata:Name {value: "ViewExpenseURL"}
    string viewExpenseURL?;
    # ID of the expense report/group this expense belongs to
    @jsondata:Name {value: "ExpenseReportIDFK"}
    int expenseReportIDFK?;
    # Reimbursement processing status
    @jsondata:Name {value: "ExpenseReimbursementStatusCode"}
    string expenseReimbursementStatusCode?;
    # The payment method ID used for this expense
    @jsondata:Name {value: "ExpensePaymentMethodIDFK"}
    int:Signed32 expensePaymentMethodIDFK?;
    # ISO 3-character currency code for the expense
    @jsondata:Name {value: "CurrencyCode"}
    string currencyCode?;
    # Whether the exchange rate is from an official/market source
    boolean isOfficialExchangeRate?;
    # Calculated tax amount on the expense
    @jsondata:Name {value: "TaxAmount"}
    decimal taxAmount?;
    # Approval status. Values: Draft, Pending, Approved, AutoApproved, Rejected, Verified
    @jsondata:Name {value: "ExpenseApprovalStatusCode"}
    string expenseApprovalStatusCode?;
    # Name of the merchant/vendor
    @jsondata:Name {value: "Merchant"}
    string merchant?;
    # URL for a preview/thumbnail of the expense attachment
    @jsondata:Name {value: "AttachmentPreviewURL"}
    string attachmentPreviewURL?;
    # Short code of the associated project
    @jsondata:Name {value: "ProjectCode"}
    string projectCode?;
    # Name of the associated customer/company
    @jsondata:Name {value: "CustomerName"}
    string customerName?;
    # ID of the receipt/file attachment, if any
    @jsondata:Name {value: "FileAttachmentIDFK"}
    int fileAttachmentIDFK?;
    # Display name for the tax configuration
    @jsondata:Name {value: "TransactionTaxConfigName"}
    string transactionTaxConfigName?;
    # Additional notes on the expense
    @jsondata:Name {value: "Notes"}
    string notes?;
    # Name of the expense report/group
    @jsondata:Name {value: "ExpenseReportName"}
    string expenseReportName?;
    # Name of the payment method
    @jsondata:Name {value: "ExpensePaymentMethodName"}
    string expensePaymentMethodName?;
    # Whether the expense is reimbursable to the employee
    boolean isReimbursable?;
    # Public URL of the expense receipt attachment
    @jsondata:Name {value: "AttachmentURL"}
    string attachmentURL?;
    # The tax rate ID applied to this expense
    @jsondata:Name {value: "TaxIDFK"}
    int:Signed32 taxIDFK?;
    # Date and time the expense record was last updated
    @jsondata:Name {value: "DateUpdated"}
    string dateUpdated?;
    # The task ID the expense is linked to
    @jsondata:Name {value: "TaskIDFK"}
    int:Signed32 taskIDFK?;
    # The expense amount in the expense currency
    @jsondata:Name {value: "Amount"}
    decimal amount?;
    # Name of the applied tax rate
    @jsondata:Name {value: "TaxName"}
    string taxName?;
    # Last name of the expense user
    @jsondata:Name {value: "Lastname"}
    string lastname?;
    # The reimbursement batch ID this expense belongs to, if reimbursed
    @jsondata:Name {value: "ExpenseReimbursementIDFK"}
    int expenseReimbursementIDFK?;
    # Tax registration number of the merchant
    @jsondata:Name {value: "MerchantTaxNumber"}
    string merchantTaxNumber?;
    # Title of the associated task
    @jsondata:Name {value: "TaskTitle"}
    string taskTitle?;
    # Quantity for unit-priced expenses (e.g. number of miles)
    @jsondata:Name {value: "Quantity"}
    decimal quantity?;
    # Whether the expense is billable to the customer
    boolean isChargeable?;
    # First name of the expense user
    @jsondata:Name {value: "Firstname"}
    string firstname?;
    # The customer/company ID the expense is associated with
    @jsondata:Name {value: "CustomerIDFK"}
    int:Signed32 customerIDFK?;
    # Title of the associated project
    @jsondata:Name {value: "ProjectTitle"}
    string projectTitle?;
    # The date the expense was incurred
    @jsondata:Name {value: "ExpenseDate"}
    string expenseDate?;
    # Whether the expense category has a predefined unit price (e.g. mileage rate)
    @jsondata:Name {value: "ExpenseCategoryHasUnitPrice"}
    boolean expenseCategoryHasUnitPrice?;
    # Name of the expense category
    @jsondata:Name {value: "ExpenseCategoryName"}
    string expenseCategoryName?;
    # The user ID who created/owns this expense
    @jsondata:Name {value: "UserIDFK"}
    int:Signed32 userIDFK?;
    # The unit price for the expense category, if applicable
    @jsondata:Name {value: "ExpenseCategoryUnitPrice"}
    decimal expenseCategoryUnitPrice?;
    # Detailed chargeable status code
    @jsondata:Name {value: "ChargeableStatusCode"}
    string chargeableStatusCode?;
    # Tax configuration: 'EX' (exclusive) or 'INC' (inclusive)
    @jsondata:Name {value: "TransactionTaxConfigCode"}
    string transactionTaxConfigCode?;
};

# An allocation entry for applying a customer payment to a specific invoice
public type NewPaymentAllocation record {
    # The Amount being allocated to the invoice. Expects same currency as invoice currency
    @jsondata:Name {value: "AllocationAmount"}
    decimal allocationAmount?;
    # Optional. Defaults to the current time in the Avaza account's timezone. The date the allocation is applied to the invoice. Can be difference from the Payment Date when doing prepayments etc
    @jsondata:Name {value: "AllocationDate"}
    string allocationDate?;
    # The Avaza Invoice TransactionID that is having a payment amount allocated to it
    @jsondata:Name {value: "InvoiceTransactionIDFK"}
    int invoiceTransactionIDFK?;
};

# Represents the Queries record for the operation: stopTimer
public type StopTimerQueries record {
    @http:Query {name: "SendWebhooks"}
    boolean sendWebhooks?;
    # Optional - User ID number if impersonating a different user. Otherwise assumes the current user. Only users with certain security roles have permission to impersonate other users
    @http:Query {name: "UserID"}
    int:Signed32 userID?;
};

# Collection of expense payment methods configured in the account
public type ExpensePaymentMethodDropdownList record {
    # List of expense payment methods
    @jsondata:Name {value: "ExpensePaymentMethods"}
    ExpensePaymentMethodMinimal[] expensePaymentMethods?;
};

# Represents the Queries record for the operation: listInvoices
public type ListInvoicesQueries record {
    # Page to display. Starts from 1
    int:Signed32 pageNumber?;
    # Filter invoices due on or after this date (ISO 8601)
    @http:Query {name: "DueDateFrom"}
    string dueDateFrom?;
    # Filter by invoice status. Values: Draft, Sent, Late, Paid, Partial, Void
    @http:Query {name: "TransactionStatusCode"}
    string transactionStatusCode?;
    # Filter invoices issued on or after this date (ISO 8601)
    @http:Query {name: "IssueDateFrom"}
    string issueDateFrom?;
    # Number of items per page (max 1000)
    int:Signed32 pageSize?;
    # Sort results by: DateUpdated, DateCreated (append ' desc' for descending)
    @http:Query {name: "Sort"}
    string sort?;
    # When true, each line item also lists the IDs of the timesheets, expenses and fixed amounts linked to it (TimesheetEntryIDs / ExpenseIDs / FixedAmountIDs). Defaults to false to keep large list responses small
    @http:Query {name: "IncludeSourceLinks"}
    boolean includeSourceLinks?;
    # Filter invoices issued before this date (ISO 8601)
    @http:Query {name: "IssueDateTo"}
    string issueDateTo?;
    # Filter invoices to a specific customer company by Company ID
    @http:Query {name: "CompanyIDFK"}
    int:Signed32 companyIDFK?;
    # Filter invoices due before this date (ISO 8601)
    @http:Query {name: "DueDateTo"}
    string dueDateTo?;
    # Only return invoices updated after this date-time
    @http:Query {name: "UpdatedAfter"}
    string updatedAfter?;
};

public type ApiFileAttachmentBody record {
    # The file to upload (multipart/form-data)
    record {byte[] fileContent; string fileName;} file;
};

# Result of deleting a single expense, indicating success or the error encountered
public type ExpenseDeleteResult record {
    # The Expense ID for this deletion result
    @jsondata:Name {value: "ExpenseID"}
    int expenseID?;
    # Error message if the deletion failed, otherwise null
    @jsondata:Name {value: "ErrorMessage"}
    string errorMessage?;
    # Whether the deletion was successful
    @jsondata:Name {value: "Success"}
    boolean success?;
};

# Paginated collection of estimates/quotes
public type EstimateList record {
    # Total number of records matching the query across all pages
    @jsondata:Name {value: "TotalCount"}
    int:Signed32 totalCount?;
    # The number of records per page
    @jsondata:Name {value: "PageSize"}
    int:Signed32 pageSize?;
    # The current page number (1-based)
    @jsondata:Name {value: "PageNumber"}
    int:Signed32 pageNumber?;
    # The list of estimates on this page
    @jsondata:Name {value: "Estimates"}
    EstimateDetails[] estimates?;
};

# An allocation record linking a credit note to a specific invoice
public type CreditNoteAllocation record {
    # The amount allocated from the credit note to the invoice
    @jsondata:Name {value: "AllocationAmount"}
    decimal allocationAmount?;
    # Unique identifier for this allocation
    @jsondata:Name {value: "TransactionAllocationID"}
    int transactionAllocationID?;
    # The credit note Transaction ID this allocation belongs to
    @jsondata:Name {value: "CreditNoteTransactionIDFK"}
    int creditNoteTransactionIDFK?;
    # The date this allocation was applied
    @jsondata:Name {value: "AllocationDate"}
    string allocationDate?;
    # The invoice Transaction ID this credit note is allocated against
    @jsondata:Name {value: "InvoiceTransactionIDFK"}
    int invoiceTransactionIDFK?;
};

# An inventory/product item used on invoices, bills, and estimates, with cost price, sale price, and tax defaults
public type InventoryItem record {
    # The default tax rate ID applied when purchasing this item (used on bills)
    @jsondata:Name {value: "PurchaseTaxIDFK"}
    int:Signed32 purchaseTaxIDFK?;
    # Detailed description of the item
    @jsondata:Name {value: "Description"}
    string description?;
    # Date the item was last updated
    @jsondata:Name {value: "DateUpdated"}
    string dateUpdated?;
    # Unique identifier for the inventory/product item
    @jsondata:Name {value: "InventoryItemID"}
    int inventoryItemID?;
    # Whether this item is hidden from the item pickers on bills ("Hide from Bills")
    boolean isHiddenOnBill?;
    # Date the item was created
    @jsondata:Name {value: "DateCreated"}
    string dateCreated?;
    # The default tax rate ID applied when selling this item
    @jsondata:Name {value: "SaleTaxIDFK"}
    int:Signed32 saleTaxIDFK?;
    # The cost/purchase price of the item
    @jsondata:Name {value: "CostPrice"}
    decimal costPrice?;
    # The default sale price of the item
    @jsondata:Name {value: "SalePrice"}
    decimal salePrice?;
    # Stock Keeping Unit code
    @jsondata:Name {value: "SKU"}
    string sKU?;
    # Name of the inventory item
    @jsondata:Name {value: "Name"}
    string name?;
    # Whether this item is hidden from the item pickers on invoices and estimates ("Hide from Invoicing")
    boolean isHidden?;
};

# A line item that would be (or was) generated from uninvoiced records, including the source record IDs it covers
public type PreviewLineItem record {
    # Expenses covered by this line
    @jsondata:Name {value: "ExpenseIDs"}
    int[] expenseIDs?;
    # The calculated unit price (blended rate / converted amount including markup / fixed amount)
    @jsondata:Name {value: "UnitPrice"}
    decimal unitPrice?;
    # The calculated tax amount
    @jsondata:Name {value: "TaxAmount"}
    decimal taxAmount?;
    # Timesheet entries covered by this line
    @jsondata:Name {value: "TimesheetEntryIDs"}
    int[] timesheetEntryIDs?;
    # The generated line description
    @jsondata:Name {value: "Description"}
    string description?;
    # The derived tax for the line
    @jsondata:Name {value: "TaxIDFK"}
    int:Signed32 taxIDFK?;
    # The type of source records this line invoices: Timesheet, Expense or FixedAmount
    @jsondata:Name {value: "SourceType"}
    string sourceType?;
    # The calculated line total
    @jsondata:Name {value: "Amount"}
    decimal amount?;
    # The project the line is attributed to, if any
    @jsondata:Name {value: "ProjectIDFK"}
    int:Signed32 projectIDFK?;
    # The derived inventory item for the line
    @jsondata:Name {value: "InventoryItemIDFK"}
    int inventoryItemIDFK?;
    # The calculated quantity (e.g. total hours)
    @jsondata:Name {value: "Quantity"}
    decimal quantity?;
    # Fixed amounts covered by this line
    @jsondata:Name {value: "FixedAmountIDs"}
    int[] fixedAmountIDs?;
};

# A line item to be included on a new estimate
public type NewEstimateLineItem record {
    # If not specified then Inventory item ID must be specified. If specified and not matched to any existing inventory items then a new inventory item will be created. Max 200 characters
    @jsondata:Name {value: "InventoryItemName"}
    string inventoryItemName?;
    # The unit price for the lineitem
    @jsondata:Name {value: "UnitPrice"}
    decimal unitPrice;
    # Plain UTF8 text. (no HTML)
    @jsondata:Name {value: "Description"}
    string description?;
    # Enter 10.5 to give a 10.5% discount
    @jsondata:Name {value: "Discount"}
    decimal discount?;
    # If specified then it must match an existing Tax ID. If not specified then Tax Name and Tax Percent must be specified
    @jsondata:Name {value: "TaxIDFK"}
    int:Signed32 taxIDFK?;
    # Must be specified if the Tax ID is blank. If the Tax Name is specified it will be matched to an existing Tax Name or else a new Tax will be created
    @jsondata:Name {value: "TaxName"}
    string taxName?;
    # If not specified then Inventory Item Name must be specified
    @jsondata:Name {value: "InventoryItemIDFK"}
    int:Signed32 inventoryItemIDFK?;
    # The quantity for the line item
    @jsondata:Name {value: "Quantity"}
    decimal quantity;
    # The Tax Percent will only be used if a new tax is being created
    @jsondata:Name {value: "TaxPercent"}
    decimal taxPercent?;
};

# Billing address details for the customer receiving an invoice or estimate
public type RecipientDetails record {
    # Pre-formatted multi-line billing address for the recipient
    @jsondata:Name {value: "RecipientFormattedBillingAddress"}
    string recipientFormattedBillingAddress?;
    # Name of the customer company
    @jsondata:Name {value: "CompanyName"}
    string companyName?;
    # State/province for the recipient
    @jsondata:Name {value: "RecipientBillingAddressState"}
    string recipientBillingAddressState?;
    # Label printed next to the recipient's tax number: the company's own Tax Number Label, else the template's default customer label, else "Tax Number"
    @jsondata:Name {value: "TaxNumberLabel"}
    string taxNumberLabel?;
    # Postal/ZIP code for the recipient
    @jsondata:Name {value: "RecipientBillingAddressPostCode"}
    string recipientBillingAddressPostCode?;
    # ISO country code for the recipient
    @jsondata:Name {value: "RecipientBillingAddressCountryCode"}
    string recipientBillingAddressCountryCode?;
    # City/suburb for the recipient
    @jsondata:Name {value: "RecipientBillingAddressCity"}
    string recipientBillingAddressCity?;
    # The customer company ID
    @jsondata:Name {value: "CompanyIDFK"}
    int:Signed32 companyIDFK?;
    # The customer company's tax registration number (Company.TaxNumber). Null when not set
    @jsondata:Name {value: "TaxNumber"}
    string taxNumber?;
    # Street address line for the recipient
    @jsondata:Name {value: "RecipientBillingAddressLine"}
    string recipientBillingAddressLine?;
};

# The state and result of the AI receipt read behind an expense created by receipt scanning
public type ExpenseAiExtraction record {
    # Processing (the receipt is being read), Completed, NotReceipt (the file was not a receipt), Failed, Refused (the AI provider declined the image) or QuotaExceeded
    @jsondata:Name {value: "Status"}
    string status?;
    # The expense fields that were filled from the receipt, e.g. Merchant, Date, Amount, Currency, Tax, Category, Payment Method, Merchant Tax Number, Notes
    @jsondata:Name {value: "FilledFields"}
    string[] filledFields?;
    # The same sentence the expense history shows, e.g. "AI extracted 6 fields ..."
    @jsondata:Name {value: "Message"}
    string message?;
    # When the read was started (UTC)
    @jsondata:Name {value: "StartedUtc"}
    string startedUtc?;
    # How many expense fields the AI could read from the receipt
    @jsondata:Name {value: "FieldsExtracted"}
    int:Signed32 fieldsExtracted?;
    # When the read finished (UTC). Null while Processing
    @jsondata:Name {value: "CompletedUtc"}
    string completedUtc?;
    # Caveats worth showing the user, e.g. why the Amount was left blank
    @jsondata:Name {value: "Notes"}
    string[] notes?;
};

# JSON body for POST /api/FileAttachment/Base64. Provide the file as base64-encoded bytes plus its filename
public type FileAttachmentBase64Request record {
    # Optional MIME type. Inferred from extension if omitted
    @jsondata:Name {value: "ContentType"}
    string contentType?;
    # Base64-encoded file content. Required
    @jsondata:Name {value: "Base64Data"}
    string base64Data?;
    # Original filename including extension. Required
    @jsondata:Name {value: "Filename"}
    string filename?;
    @jsondata:Name {value: "LinkTo"}
    FileAttachmentLinkTarget linkTo?;
};

# Request body for PUT /api/UserProfile. Only fields named in FieldsToUpdate are written
public type UpdateUserProfile record {
    # Allowlist of field names to update (case-insensitive, matches JSON keys). Other fields in the payload are ignored
    @jsondata:Name {value: "FieldsToUpdate"}
    string[] fieldsToUpdate?;
    # New email address. Must be a valid format and unique within the account. If changed, the GlobalUser link is rebuilt
    @jsondata:Name {value: "Email"}
    string email?;
    # New position title. Max 100 characters
    @jsondata:Name {value: "PositionTitle"}
    string positionTitle?;
    # Only meaningful when Roles is in FieldsToUpdate. Drives invite-email behaviour after roles are replaced — see spec matrix
    @jsondata:Name {value: "SendInviteEmail"}
    boolean sendInviteEmail?;
    # New default billable rate. Team members only. Non-negative
    @jsondata:Name {value: "DefaultBillableRate"}
    decimal defaultBillableRate?;
    # New last name. Max 100 characters
    @jsondata:Name {value: "Lastname"}
    string lastname?;
    # When included in FieldsToUpdate, fully replaces the existing role set (pass [] to remove all). Each entry must be a RoleCode that is valid for the user's existing type (UserAssignable=1 for team members, CustomerAssignable=1 for customer contacts)
    @jsondata:Name {value: "Roles"}
    string[] roles?;
    # New mobile. Max 50 characters
    @jsondata:Name {value: "Mobile"}
    string mobile?;
    # New first name. Max 100 characters
    @jsondata:Name {value: "Firstname"}
    string firstname?;
    # New Windows Time Zone ID
    @jsondata:Name {value: "TimeZone"}
    string timeZone?;
    # Custom field values to set. Only applied when "CustomFields" is included in FieldsToUpdate. Identify each item by CustomFieldDefinitionID (preferred) or Name (case-insensitive). Multi-select items REPLACE the field's whole selection; "Value": null clears a field. Fields not referenced keep their current values. Custom field definitions/options cannot be created or modified via the API
    @jsondata:Name {value: "CustomFields"}
    CustomFieldValueInput[] customFields?;
    # UserID of the existing, non-archived UserProfile to update
    @jsondata:Name {value: "UserID"}
    int:Signed32 userID?;
    # New phone. Max 50 characters
    @jsondata:Name {value: "Phone"}
    string phone?;
    # New default cost rate. Team members only. Non-negative
    @jsondata:Name {value: "DefaultCostRate"}
    decimal defaultCostRate?;
};

# A component of a compound tax rate, with its own code, name, percentage, and compound flag
public type TaxComponent record {
    # The ID of the parent TaxItem this component belongs to
    @jsondata:Name {value: "TaxIDFK"}
    int:Signed32 taxIDFK?;
    # The percentage rate for this individual tax component
    @jsondata:Name {value: "Percentage"}
    decimal percentage?;
    # Short code identifying this tax component
    @jsondata:Name {value: "ComponentTaxCode"}
    string componentTaxCode?;
    # Unique identifier for the tax component
    @jsondata:Name {value: "TaxComponentID"}
    int:Signed32 taxComponentID?;
    # Whether this component is compounded on top of the previous components (true) or applied to the original amount (false)
    boolean isCompound?;
    # Display name of the tax component
    @jsondata:Name {value: "Name"}
    string name?;
};

# Collection of custom field definitions mapped to an entity type
public type CustomFieldDefinitionList record {
    # Active custom field definitions mapped to the requested entity type, in display order
    @jsondata:Name {value: "CustomFieldDefinitions"}
    CustomFieldDefinitionDetails[] customFieldDefinitions?;
};

# OAuth2 Refresh Token Grant Configs
public type OAuth2RefreshTokenGrantConfig record {|
    *http:OAuth2RefreshTokenGrantConfig;
    # Refresh URL
    string refreshUrl = "https://any.avaza.com/oauth2/token";
|};

# Collection of users/team members in the Avaza account
public type UserList record {
    # The list of user records
    @jsondata:Name {value: "Users"}
    UserDetails[] users?;
};

# Collection of expense categories configured in the account
public type ExpenseCategoryList record {
    # List of expense categories
    @jsondata:Name {value: "Categories"}
    ExpenseCategoryDetails[] categories?;
};

# Full project details including sections, team members with rates/permissions, and project tags
public type ProjectDetails record {
    # Hours recorded to date for hour-based budget types: every timesheet entry except Rejected, billable entries only when the project deducts billable hours only. Null for ProjectFees / NoBudget
    @jsondata:Name {value: "SpentHours"}
    decimal spentHours?;
    # Project status code. Per-account configurable. Default codes (NotStarted, InProgress, Complete, OnHold) are seeded for every account; admins may add custom codes via the Project Statuses settings panel. Codes are unique within an account and stable once created
    @jsondata:Name {value: "ProjectStatusCode"}
    string projectStatusCode?;
    # Whether the project is archived. Archived projects are hidden from default views
    boolean isArchived?;
    # Unique identifier for the project
    @jsondata:Name {value: "ProjectID"}
    int:Signed32 projectID?;
    # Date the project was created
    @jsondata:Name {value: "DateCreated"}
    string dateCreated?;
    # Monetary budget allocated to the project (the stored setting; ProjectFees only). Null when the token owner cannot see amounts on this project (Administrator, Finance Manager and Portfolio Manager always can; other users need "Can manage Project Member Cost and Billable Rates" on the project)
    @jsondata:Name {value: "BudgetAmount"}
    decimal budgetAmount?;
    # ISO currency code of the project's customer company (the account's default currency for projects on the internal company). Every money value on this project is in this currency
    @jsondata:Name {value: "CurrencyCode"}
    string currencyCode?;
    # Planned start date for the project
    @jsondata:Name {value: "StartDate"}
    string startDate?;
    # Name of the customer company this project belongs to
    @jsondata:Name {value: "CompanyName"}
    string companyName?;
    # The project category ID, if categorised
    @jsondata:Name {value: "ProjectCategoryIDFK"}
    int:Signed32 projectCategoryIDFK?;
    # List of sections (task groups) within this project
    @jsondata:Name {value: "Sections"}
    ProjectSectionDetails[] sections?;
    # List of tags applied to this project
    @jsondata:Name {value: "ProjectTags"}
    ProjectTagItem[] projectTags?;
    # User ID of the project owner/manager
    @jsondata:Name {value: "ProjectOwnerUserIDFK"}
    int:Signed32 projectOwnerUserIDFK?;
    # Short reference code for the project
    @jsondata:Name {value: "ProjectCode"}
    string projectCode?;
    # Project description or notes
    @jsondata:Name {value: "Notes"}
    string notes?;
    # Whether users must select a task when logging time to this project
    boolean isTaskRequiredOnTimesheet?;
    # Hex colour assigned to the project status (e.g. "#F0AD4E")
    @jsondata:Name {value: "ProjectStatusColor"}
    string projectStatusColor?;
    # Name of the project category
    @jsondata:Name {value: "ProjectCategoryName"}
    string projectCategoryName?;
    # The default task type ID used for new tasks in this project
    @jsondata:Name {value: "DefaultAccountTaskTypeIDFK"}
    int:Signed32 defaultAccountTaskTypeIDFK?;
    # Date the project was last updated
    @jsondata:Name {value: "DateUpdated"}
    string dateUpdated?;
    # Hours budget allocated to the project (the stored setting; ProjectHours only - see EffectiveBudgetHours for the CategoryHours / PersonHours sums)
    @jsondata:Name {value: "BudgetHours"}
    decimal budgetHours?;
    # Billing configuration. Values: CategoryHourly, NoRate, NotBillable, PersonHourly, ProjectHourly. Null for external customer-contact tokens, which never receive budget or billing details
    @jsondata:Name {value: "ProjectBillableTypeCode"}
    string projectBillableTypeCode?;
    # Project title/name
    @jsondata:Name {value: "Title"}
    string title?;
    # Display name of the project status (e.g. "In Progress", "At Risk")
    @jsondata:Name {value: "ProjectStatusName"}
    string projectStatusName?;
    # The customer company ID this project is linked to
    @jsondata:Name {value: "CompanyIDFK"}
    int:Signed32 companyIDFK?;
    # The project-level hourly rate (when billing type is ProjectHourly). Null when the token owner cannot see amounts on this project
    @jsondata:Name {value: "ProjectHourlyRate"}
    decimal projectHourlyRate?;
    # Planned end date for the project
    @jsondata:Name {value: "EndDate"}
    string endDate?;
    # URL to view this project in the Avaza web application
    @jsondata:Name {value: "ViewProjectURL"}
    string viewProjectURL?;
    # Budget configuration. Values: CategoryHours, NoBudget, PersonHours, ProjectFees, ProjectHours. Null for external customer-contact tokens, which never receive budget or billing details
    @jsondata:Name {value: "ProjectBudgetTypeCode"}
    string projectBudgetTypeCode?;
    # Custom field values set on this project, in display order. Fields with no value are not included. Omitted entirely when the account's Custom Fields feature is disabled (external contact tokens only see fields with "Everyone" visibility). See GET /api/CustomFieldDefinition for the account's field definitions
    @jsondata:Name {value: "CustomFields"}
    CustomFieldValueItem[] customFields?;
    # True if this status marks the project as complete (one row per account)
    @jsondata:Name {value: "ProjectStatusIsComplete"}
    boolean projectStatusIsComplete?;
    # Effective hours budget for hour-based budget types: BudgetHours for ProjectHours, the sum of the category budgets for CategoryHours, the sum of the member budgets for PersonHours. Null for ProjectFees / NoBudget and when no budget is entered
    @jsondata:Name {value: "EffectiveBudgetHours"}
    decimal effectiveBudgetHours?;
    # Html Hex Color Code starting with #
    @jsondata:Name {value: "ProjectCategoryColor"}
    string projectCategoryColor?;
    # Name of the default task type
    @jsondata:Name {value: "DefaultAccountTaskTypeName"}
    string defaultAccountTaskTypeName?;
    # True if this is the account's default-for-new-projects status (one row per account)
    @jsondata:Name {value: "ProjectStatusIsNotStarted"}
    boolean projectStatusIsNotStarted?;
    # Amount spent to date for ProjectFees / NoBudget projects, in CurrencyCode: timesheets at the project's cost or billable rate setting, plus expenses net of tax (no markup) when the project deducts expenses; task fixed amounts are never included; every entry except Rejected. Null for hour-based budget types and null when the token owner cannot see amounts on this project
    @jsondata:Name {value: "SpentAmount"}
    decimal spentAmount?;
    # List of team members assigned to this project
    @jsondata:Name {value: "Members"}
    ProjectMemberDetails[] members?;
};

