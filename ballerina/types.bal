# A line item to be included when updating an estimate
public type UpdatedEstimateLineItem record {
    # The unit price for the lineitem
    @jsondata:Name {value: "UnitPrice"}
    decimal unitPrice;
    # Plain UTF8 text. (no HTML). 5000 characters max
    @jsondata:Name {value: "Description"}
    string description?;
    # Enter 10.5 to give a 10.5% discount
    @jsondata:Name {value: "Discount"}
    decimal discount?;
    # Optional ID of an existing EstimateLineItem that should be retained and updated. Leave blank (or 0) to add a new line item
    @jsondata:Name {value: "EstimateLineItemID"}
    int estimateLineItemID?;
    # Must match an existing Tax ID in your account
    @jsondata:Name {value: "TaxIDFK"}
    int:Signed32 taxIDFK;
    # The ID of the InventoryItem this line item is linked to. Must belong to your account
    @jsondata:Name {value: "InventoryItemIDFK"}
    int inventoryItemIDFK;
    # The quantity for the line item
    @jsondata:Name {value: "Quantity"}
    decimal quantity;
};

# Result of adding all matching uninvoiced records to an invoice
public type AddUninvoicedItemsResult record {
    @jsondata:Name {value: "Invoice"}
    Invoice invoice?;
