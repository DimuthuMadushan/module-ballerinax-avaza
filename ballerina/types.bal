# Request model for updating an existing project. Only fields in FieldsToUpdate are modified
public type UpdateProjectModel record {
    # Update the project status (string, optional): (Possible values: NotStarted, InProgress, Complete, OnHold)
    @jsondata:Name {value: "ProjectStatusCode"}
    string projectStatusCode?;
    # A string array of field names to be updated. Only listed fields will be modified
    @jsondata:Name {value: "FieldsToUpdate"}
    string[] fieldsToUpdate?;
    # Whether timesheets entered against this project require a task to be selected
    boolean isTaskRequiredOnTimesheet?;
    # Whether timesheet approval should be required by default for newly added project members
    @jsondata:Name {value: "TimesheetApprovalRequiredbyDefault"}
    boolean timesheetApprovalRequiredbyDefault?;
    # Controls whether updated rates are applied to existing timesheet entries when ProjectBillableTypeCode changes.
    # Possible values: "new" (do not update existing timesheets), "uninvoiced" (update all existing uninvoiced timesheets).
    # Defaults to "uninvoiced" if not specified, to preserve backwards compatibility.
    # Only applies when ProjectBillableTypeCode is included in FieldsToUpdate
    @jsondata:Name {value: "TimesheetRateUpdateOption"}
    string timesheetRateUpdateOption?;
    # If true, fires the project_updated webhook event to any subscribed endpoints. Defaults to false to preserve existing integration behaviour
    @jsondata:Name {value: "SendWebhooks"}
    boolean sendWebhooks?;
    # Hours budget allocated to the project
    @jsondata:Name {value: "BudgetHours"}
    decimal budgetHours?;
    # The ID of the Project to update
    @jsondata:Name {value: "ProjectID"}
    int:Signed32 projectID?;
    # The billing method of the project. (string, optional) Possible values: CategoryHourly, NoRate, NotBillable, PersonHourly, ProjectHourly
    @jsondata:Name {value: "ProjectBillableTypeCode"}
    string projectBillableTypeCode?;
    # Planned end date for the project
    @jsondata:Name {value: "EndDate"}
    string endDate?;
    # Monetary budget allocated to the project
    @jsondata:Name {value: "BudgetAmount"}
    decimal budgetAmount?;
    # Planned start date for the project
    @jsondata:Name {value: "StartDate"}
    string startDate?;
    # Controls whether updated rates are applied to existing schedule bookings when ProjectBillableTypeCode changes.
    # Possible values: "new" (default, only new bookings), "all" (all existing bookings), "active" (bookings with end date in the future).
    # Only applies when ProjectBillableTypeCode is included in FieldsToUpdate
    @jsondata:Name {value: "ScheduleRateUpdateOption"}
    string scheduleRateUpdateOption?;
    # (optional) Any descriptive notes about the project. (2000 characters max)
    @jsondata:Name {value: "ProjectNotes"}
    string projectNotes?;
    # The project budgeting type. (string, optional) Possible values: NoBudget, PersonHours, ProjectFees, ProjectHours, CategoryHours
    @jsondata:Name {value: "ProjectBudgetTypeCode"}
    string projectBudgetTypeCode?;
    # Custom field values to set. Only applied when "CustomFields" is included in FieldsToUpdate. Identify each item by CustomFieldDefinitionID (preferred) or Name (case-insensitive). Multi-select items REPLACE the field's whole selection; "Value": null clears a field. Fields not referenced keep their current values. Custom field definitions/options cannot be created or modified via the API
    @jsondata:Name {value: "CustomFields"}
    CustomFieldValueInput[] customFields?;
    # (optional) An updated project title. (255 characters max)
    @jsondata:Name {value: "ProjectTitle"}
    string projectTitle?;
    # The project category ID, if categorised
    @jsondata:Name {value: "ProjectCategoryIDFK"}
    int:Signed32 projectCategoryIDFK?;
    # Desired final set of tags on the project (replace semantics). Object array; each item has a Name. Only applied when "ProjectTags" is present in FieldsToUpdate. An empty array removes all of the project's tag associations. Names are matched case-insensitively against the account tag pool and created on first use. (255 characters max per name)
    @jsondata:Name {value: "ProjectTags"}
    ProjectTagInput[] projectTags?;
};

# Identifies an entity to inline-link an uploaded attachment to. Supported entityType values: "Task", "Expense", "Estimate", "Invoice"
public type FileAttachmentLinkTarget record {
    # Entity kind. One of: "Task", "Expense", "Estimate", "Invoice"
    @jsondata:Name {value: "EntityType"}
    string entityType?;
    # The target entity's primary key
    @jsondata:Name {value: "EntityId"}
    int entityId?;
};

# Filters for selecting uninvoiced fixed amounts. Each fixed amount always becomes its own line item
public type UninvoicedFixedAmountFilter record {
