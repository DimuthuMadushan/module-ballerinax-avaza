# Request model for appending line items to an existing invoice without modifying its other line items
public type AddInvoiceLineItemsRequest record {
    # The line items to append (1-100). Each may optionally link uninvoiced timesheets, expenses or a fixed amount via TimesheetEntryIDs / ExpenseIDs / FixedAmountIDs; amounts and descriptions are calculated from the linked records unless supplied. Existing line items on the invoice are never modified or deleted by this endpoint
    @jsondata:Name {value: "LineItems"}
    NewInvoiceLineItem[] lineItems;
    # Optional exchange-rate overrides applied when linked Expenses are in a currency different from the invoice currency
    @jsondata:Name {value: "ExpenseExchangeRates"}
    ExpenseExchangeRate[] expenseExchangeRates?;
    # If true, fires invoice_updated (plus timesheet_updated / expense_updated for linked records) webhook events. Defaults to false
    @jsondata:Name {value: "SendWebhooks"}
    boolean sendWebhooks?;
    # The Transaction ID of the invoice to append line items to. The invoice must not be Void
    @jsondata:Name {value: "InvoiceID"}
    int invoiceID;
};

# Request model for creating a new external contact. Optionally creates a new company if one doesn't exist
public type NewCompanyContact record {
    # The city for the billing address of a newly created company
    @jsondata:Name {value: "CompanyBillingAddressCity"}
    string companyBillingAddressCity?;
    # The contact's job title or position
    @jsondata:Name {value: "PositionTitle"}
    string positionTitle?;
    # If true, fires the contact_created webhook event to any subscribed endpoints. Defaults to false to preserve existing integration behaviour
    @jsondata:Name {value: "SendWebhooks"}
    boolean sendWebhooks?;
    # The ISO 2-letter country code for the billing address of a newly created company
    @jsondata:Name {value: "CompanyBillingAddressCountryCode"}
    string companyBillingAddressCountryCode?;
    # The contact's last name. Required
    @jsondata:Name {value: "Lastname"}
    string lastname;
    # If true, updates an existing contact with the same email address instead of creating a duplicate. Defaults to true
    @jsondata:Name {value: "UpdateExisting"}
    boolean updateExisting?;
    # The ID of an existing company to associate the contact with. If omitted, CompanyName is used to find or create a company
    @jsondata:Name {value: "CompanyIDFK"}
    int:Signed32 companyIDFK?;
    # The full formatted billing address string for a newly created company
    @jsondata:Name {value: "CompanyBillingAddress"}
    string companyBillingAddress?;
    # The street address line for the billing address of a newly created company
    @jsondata:Name {value: "CompanyBillingAddressLine"}
    string companyBillingAddressLine?;
    # The contact's mobile phone number
    @jsondata:Name {value: "Mobile"}
    string mobile?;
    # The currency code for a newly created company. Defaults to the account's default currency if not provided
    @jsondata:Name {value: "CurrencyCode"}
    string currencyCode?;
    # The contact's first name. Required
    @jsondata:Name {value: "Firstname"}
    string firstname;
    # The name of the company to associate the contact with. Used to find an existing company or create a new one if not found
    @jsondata:Name {value: "CompanyName"}
    string companyName?;
    # Custom field values to set on the contact. Identify each item by CustomFieldDefinitionID (preferred) or Name (case-insensitive). When a new contact is created, fields not supplied receive their configured default values and required fields without a default must be supplied; when an existing contact is updated (UpdateExisting), only the supplied fields change. Custom field definitions/options cannot be created or modified via the API
    @jsondata:Name {value: "CustomFields"}
    CustomFieldValueInput[] customFields?;
    # The state or province for the billing address of a newly created company
    @jsondata:Name {value: "CompanyBillingAddressState"}
    string companyBillingAddressState?;
    # The contact's phone number
    @jsondata:Name {value: "Phone"}
    string phone?;
    # The postcode or ZIP code for the billing address of a newly created company
    @jsondata:Name {value: "CompanyBillingAddressPostCode"}
    string companyBillingAddressPostCode?;
    # The contact's email address. Required
    @jsondata:Name {value: "ContactEmail"}
    string contactEmail;
};

