};

# Request model for adding a user as a member of a project, with rate, budget, and permission settings
public type NewProjectMember record {
    boolean isTimesheetApprovalRequired?;
    boolean canUpdateTasks?;
    # Required. The ProjectID
    @jsondata:Name {value: "ProjectIDFK"}
    int:Signed32 projectIDFK?;
    boolean isTimesheetApprover?;
    # Optional. If not provided, defaults to the User's default Rate Amount
    @jsondata:Name {value: "RateAmount"}
    decimal rateAmount?;
    boolean isExpenseApprover?;
    # Optional
    @jsondata:Name {value: "BudgetAmount"}
    decimal budgetAmount?;
    boolean canDeleteTasks?;
    boolean canCommentOnTasks?;
    boolean canCreateTasks?;
    # Optional. If not provided, defaults to the User's default Cost Amount
    @jsondata:Name {value: "CostAmount"}
    decimal costAmount?;
    # Required. The UserID to assign
    @jsondata:Name {value: "UserIDFK"}
    int:Signed32 userIDFK?;
    boolean isTimesheetAllowed?;
};

# Represents the Queries record for the operation: deleteSection
public type DeleteSectionQueries record {
    # The ID of the section to delete
    int SectionID;
};

# Represents the Queries record for the operation: listContacts
public type ListContactsQueries record {
    # Set false to omit the CustomFields collection from each contact. Defaults to true
    @http:Query {name: "IncludeCustomFields"}
    boolean includeCustomFields?;
    # 1-based page number to retrieve. Default 1
    int:Signed32 pageNumber?;
    # Number of results per page. Maximum 1000, default 20
    int:Signed32 pageSize?;
    # Sort results by: DateUpdated, DateCreated (append ' desc' for descending)
    @http:Query {name: "Sort"}
    string sort?;
    # Filter contacts to a specific company by Company ID
    @http:Query {name: "CompanyIDFK"}
    int:Signed32 companyIDFK?;
    # Only return contacts updated after this date-time
    @http:Query {name: "UpdatedAfter"}
    string updatedAfter?;
};

# Per-entry result for a batch approve or reject request
public type TimesheetApprovalResultItem record {
    # Result status: Approved, Rejected, AlreadyApproved, AlreadyRejected, or Failed
    @jsondata:Name {value: "Status"}
    string status?;
    # The TimeSheetEntryID supplied by the caller
    @jsondata:Name {value: "TimeSheetEntryID"}
    int timeSheetEntryID?;
    # UTC timestamp of the state change, populated only when the status changed as a result of this request
    @jsondata:Name {value: "ActedAt"}
    string actedAt?;
    # UserID of the caller, populated only when the status changed as a result of this request
    @jsondata:Name {value: "ActedByUserID"}
    int:Signed32 actedByUserID?;
    # Human-readable failure message when Status=Failed
    @jsondata:Name {value: "Message"}
    string message?;
    # Machine-readable error code when Status=Failed
    @jsondata:Name {value: "ErrorCode"}
    string errorCode?;
};

# Request model for updating an existing expense entry. Only fields in FieldsToUpdate are modified
public type UpdateExpense record {
    # Defaults to false if not provided
    boolean isReimbursable?;
    # The expense category to link the Expense to
    @jsondata:Name {value: "ExpenseCategoryIDFK"}
    int:Signed32 expenseCategoryIDFK?;
    # Optional (Only relevant if the expense currency is different to your account currency. If not provided we will look up the market exchange rate for you based on the expense date.) Exchange Rate = Expense Currency Amount / Base Currency Amount (e.g. if Expense currency is in AUD, and Base Currency is in USD, Exchange Rate = AUD $140 / USD $100 = 1.4)
    @jsondata:Name {value: "ExchangeRate"}
    decimal exchangeRate?;
    # Array of field names to update. Only listed fields will be modified
    @jsondata:Name {value: "FieldsToUpdate"}
    string[] fieldsToUpdate;
    # The ID of the expense to update (required)
    @jsondata:Name {value: "ExpenseID"}
    int expenseID;
    # Avaza Tax ID the expense belongs to
    @jsondata:Name {value: "TaxIDFK"}
    int:Signed32 taxIDFK?;
    # If true, fires the expense_updated webhook event to any subscribed endpoints. Defaults to false to preserve existing integration behaviour
    @jsondata:Name {value: "SendWebhooks"}
    boolean sendWebhooks?;
    # The Avaza project ID to associate the Expense with
    @jsondata:Name {value: "ProjectIDFK"}
    int:Signed32 projectIDFK?;
    # (optional) TaskID of a Task to link the new Expense to. A Customer and Project must be provided also
    @jsondata:Name {value: "TaskIDFK"}
    int:Signed32 taskIDFK?;
    # Expense Amount (Required). Can be negative, e.g. to record a refund that reduces project cost and credits the client's next invoice
    @jsondata:Name {value: "Amount"}
    decimal amount?;
    # A Tax number identifier for the merchant
    @jsondata:Name {value: "MerchantTaxNumber"}
    string merchantTaxNumber?;
    # Conditional - available for expenses that are assigned a unit priced based expense category. e.g Mileage. A negative Quantity gives a negative Amount
    @jsondata:Name {value: "Quantity"}
    decimal quantity?;
    # Links the expense to a Grouping/Trip report. If no matching name found, creates a new Group/Trip Report name
    @jsondata:Name {value: "GroupTripName"}
    string groupTripName?;
    # (Optional) ID of Expense Payment Method
    @jsondata:Name {value: "ExpensePaymentMethodIDFK"}
    int:Signed32 expensePaymentMethodIDFK?;
    # Pass false if creating a draft expense. True otherwise
    @jsondata:Name {value: "VerifyAndSave"}
    boolean verifyAndSave?;
    # aka Billable. Defaults to false if not provided. If set to true, a CustomerIDFK or CustomerName must be provided
    boolean isChargeable?;
    # A 3-letter ISO CurrencyCode for the expense currency. (e.g. USD). If not provided, defaults to the Account base currency
    @jsondata:Name {value: "CurrencyCode"}
    string currencyCode?;
    # The Avaza Customer ID to associate the Expense with
    @jsondata:Name {value: "CustomerIDFK"}
    int:Signed32 customerIDFK?;
    # The date of the expense entry
    @jsondata:Name {value: "ExpenseDate"}
    string expenseDate?;
    # The name of the merchant
    @jsondata:Name {value: "Merchant"}
    string merchant?;
    # Expense Notes
    @jsondata:Name {value: "Notes"}
    string notes?;
    # Optional - Enter "INC" if the tax amount is included in the expense amount otherwise enter "EX" when the amount exlcudes the tax. Defaults to "Ex". The tax amount on the expense will be autocalculated
    @jsondata:Name {value: "TransactionTaxConfigCode"}
    string transactionTaxConfigCode?;
    # Array of File Attachment IDs to associate with this expense. The files need to have already been uploaded. Currently only accepts a single file
    @jsondata:Name {value: "FileAttachmentIDs"}
    int[] fileAttachmentIDs?;
};

# Paginated collection of supplier bill payments
public type BillPaymentList record {
    # Total number of payments matching the filter criteria
    @jsondata:Name {value: "TotalCount"}
    int:Signed32 totalCount?;
    # Number of results per page
    @jsondata:Name {value: "PageSize"}
    int:Signed32 pageSize?;
    # Current page number (1-based)
    @jsondata:Name {value: "PageNumber"}
    int:Signed32 pageNumber?;
    # The list of bill payments for this page
    @jsondata:Name {value: "Payments"}
    BillPayment[] payments?;
};

# Request model for creating a new estimate/quote. Supports automatic company/contact creation
public type NewEstimate record {
    # A prefix for the Estimate number. e.g. 'INV'. If left blank it will be set to the account default. Max length 20 characters
    @jsondata:Name {value: "EstimatePrefix"}
    string estimatePrefix?;
    # Exchange rate is only valid for Estimates in currency other than default account currency. If not specified it will get the market rate based on the Date Issued
    @jsondata:Name {value: "ExchangeRate"}
    decimal exchangeRate?;
    @jsondata:Name {value: "LineItems"}
    NewEstimateLineItem[] lineItems?;
    # Specified value will be used to create a new customer contact only if a new customer is being created
    @jsondata:Name {value: "Email"}
    string email?;
    # If true, fires the estimate_created webhook event to any subscribed endpoints. Defaults to false to preserve existing integration behaviour
    @jsondata:Name {value: "SendWebhooks"}
    boolean sendWebhooks?;
    # Specified value will be used to create a new customer contact only if a new customer is being created
    @jsondata:Name {value: "Lastname"}
    string lastname?;
    # Possible values are (EX --- Tax Exclusive, INC --- Tax Inclusive). If left empty it will use the account default
    @jsondata:Name {value: "EstimateTaxConfigCode"}
    string estimateTaxConfigCode?;
    # If left blank then you must specify Company Name
    @jsondata:Name {value: "CompanyIDFK"}
    int:Signed32 companyIDFK?;
    # Plain UTF8 text. (no HTML). 255 characters max
    @jsondata:Name {value: "Subject"}
    string subject?;
    # Pass any string. If left blank it will use the next number in the auto incrementing sequence. If an integer is passed then the largest integer will be use as the seed to auto generate the next Estimate number in the sequence
    @jsondata:Name {value: "EstimateNumber"}
    string estimateNumber?;
    # Specified value will be used to create a new customer contact only if a new customer is being created
    @jsondata:Name {value: "Firstname"}
    string firstname?;
    # Expects ISO Standard 3 character currency code. If left blank the currency will default to account's currency in general setting. For existing companies this field will be ignored and the Estimate will use the currency of the customer. For new customers if the currency is not specified then account currency will be used otherwise the specified currency will be used
    @jsondata:Name {value: "CurrencyCode"}
    string currencyCode?;
    # If left blank then you must specify Company ID. Specified Name will be used to match existing customer record. If not matched then it will be used to create a new customer. First Name, Last Name and Email will only be used if it is a new company. If the Company name appears multiple times we will check the email address to find a matching company. If email address doesn't identify a matching company then the Estimate creation will be rejected
    @jsondata:Name {value: "CompanyName"}
    string companyName?;
    # Plain UTF8 text. 100 characters max
    @jsondata:Name {value: "CustomerPONumber"}
    string customerPONumber?;
    # If not specified it will use today's date. The date should be specified as local date
    @jsondata:Name {value: "DateIssued"}
    string dateIssued?;
    # The template to render the estimate with (an INV or EST type template). Use GET /api/InvoiceTemplate to look up template IDs by name. If left blank the account default estimate template will be used
    @jsondata:Name {value: "InvoiceTemplateIDFK"}
    int:Signed32 invoiceTemplateIDFK?;
    # It will be auto calculated based on the payment term and issue date. Due Date must be greater than or equal to Issue Date. If the Due Date is specified then Payment Terms will be set to -1 (Custom)
    @jsondata:Name {value: "DueDate"}
    string dueDate?;
    # Plain UTF8 text. (no HTML). Max 2000 characters
    @jsondata:Name {value: "Notes"}
    string notes?;
};

# Represents the Queries record for the operation: uploadFileAttachment
public type UploadFileAttachmentQueries record {
    # Optional. One of: "Task", "Expense", "Estimate", "Invoice". When supplied, linkToEntityId must also be supplied
    string linkToEntityType?;
    # Optional. The target entity's primary key. Required when linkToEntityType is supplied
    int linkToEntityId?;
};

