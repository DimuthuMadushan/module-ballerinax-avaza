# An allocation entry for applying a bill payment to a specific bill
public type NewBillPaymentAllocation record {
    # The Amount being allocated to the bill. Expects same currency as bill currency
    @jsondata:Name {value: "AllocationAmount"}
    decimal allocationAmount?;
