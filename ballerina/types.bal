    int companyID?;
};

# A supplier bill (purchase invoice) including line items, status, amounts, and issuer/recipient details
public type Bill record {
    # Exchange rate to the account's base currency. 1.0 if same currency
    @jsondata:Name {value: "ExchangeRate"}
    decimal exchangeRate?;
    @jsondata:Name {value: "Issuer"}
    BillIssuerDetails issuer?;
    # Date and time the record was created
    @jsondata:Name {value: "DateCreated"}
    string dateCreated?;
    # The full bill/invoice number including prefix
    @jsondata:Name {value: "BillNumber"}
    string billNumber?;
    # Unique identifier for the bill transaction
    @jsondata:Name {value: "TransactionID"}
    int transactionID?;
    # The prefix used in the bill number (e.g. 'BILL')
    @jsondata:Name {value: "TransactionPrefix"}
    string transactionPrefix?;
    # ISO 3-character currency code for the bill
    @jsondata:Name {value: "CurrencyCode"}
    string currencyCode?;
    # The name of the supplier company
    @jsondata:Name {value: "CompanyName"}
    string companyName?;
    # Total tax amount across all line items
    @jsondata:Name {value: "TaxAmount"}
    decimal taxAmount?;
    # Supplier purchase order number reference
    @jsondata:Name {value: "SupplierPONumber"}
    string supplierPONumber?;
    # Current status of the bill. Values: Draft, Verified, Late, Paid, Partial, Void
    @jsondata:Name {value: "TransactionStatusCode"}
    string transactionStatusCode?;
    # The payment due date for the bill
    @jsondata:Name {value: "DueDate"}
    string dueDate?;
    # Additional notes or comments on the bill
    @jsondata:Name {value: "Notes"}
    string notes?;
    # Line items on this bill
    @jsondata:Name {value: "LineItems"}
    BillLineItem[] lineItems?;
    # Date and time the record was last updated
    @jsondata:Name {value: "DateUpdated"}
    string dateUpdated?;
    # The Avaza account this bill belongs to
    @jsondata:Name {value: "AccountIDFK"}
    int:Signed32 accountIDFK?;
    @jsondata:Name {value: "Recipient"}
    BillRecipientDetails recipient?;
    # The supplier company ID this bill is from
    @jsondata:Name {value: "CompanyIDFK"}
    int:Signed32 companyIDFK?;
    # Total amount of the bill including tax
    @jsondata:Name {value: "TotalAmount"}
    decimal totalAmount?;
    # Subject line or description for the bill
    @jsondata:Name {value: "Subject"}
    string subject?;
    # The date the bill was verified/approved
    @jsondata:Name {value: "DateVerified"}
    string dateVerified?;
    # The date the bill was issued
    @jsondata:Name {value: "DateIssued"}
    string dateIssued?;
    @jsondata:Name {value: "Links"}
    BillLinks links?;
    # Outstanding balance remaining on the bill
    @jsondata:Name {value: "Balance"}
    decimal balance?;
    # Tax configuration: 'EX' (tax exclusive) or 'INC' (tax inclusive)
    @jsondata:Name {value: "TransactionTaxConfigCode"}
    string transactionTaxConfigCode?;
};

# Request body for POST /api/UserProfile/Archive and POST /api/UserProfile/Unarchive
public type UserProfileIDRequest record {
    # UserID of the existing UserProfile to archive or unarchive
    @jsondata:Name {value: "UserID"}
    int:Signed32 userID?;
};

# Paginated list of active projects grouped by customer company, for dropdown/autocomplete use
public type ProjectDropdownList record {
    # List of Projects grouped by Customer Name
    ProjectCompanyGroup[] companies?;
    # Current page number (1 based)
    int:Signed32 pageNumber?;
    # Current page size
    @jsondata:Name {value: "PageSize"}
    int:Signed32 pageSize?;
    # More records probably exist
    boolean hasMore?;
};

# A single message in a task discussion, including author, body text, timestamps, attachments, and reply context
public type TaskDiscussionResponse record {
    # Display name of the message author
    @jsondata:Name {value: "CreatedByName"}
    string createdByName?;
    # Whether this message is unread by the current user
    @jsondata:Name {value: "Unread"}
    string unread?;
    # Whether this is an internal note (not visible to external contacts)
    boolean isInternalNote?;
    @jsondata:Name {value: "ReplyToFileType1"}
    string replyToFileType1?;
    # User ID of the message author
    @jsondata:Name {value: "CreatedByUserIDFK"}
    int:Signed32 createdByUserIDFK?;
    # List of file attachments on this message
    TaskDiscussionResponseAttachment[] attachments?;
    @jsondata:Name {value: "ReplyToFileProvider1"}
    string replyToFileProvider1?;
    # Unique identifier for this discussion message
    @jsondata:Name {value: "TaskResponseID"}
    int taskResponseID?;
    # Whether the current user can edit this message (author + not system + active membership)
    boolean canEdit?;
    # Body of the message being replied to
    @jsondata:Name {value: "ReplyToBody"}
    string replyToBody?;
    # True if the author has edited this message after posting; drives the (edited) UI indicator
    boolean isEdited?;
    @jsondata:Name {value: "ReplyToFileID1"}
    int replyToFileID1?;
    # Whether this message is active (not deleted)
    boolean isActive?;
    # Formatted creation date string
    @jsondata:Name {value: "DateCreatedString"}
    string dateCreatedString?;
    # The message ID this is a reply to, if any
    @jsondata:Name {value: "ReplyToMessageID"}
    int replyToMessageID?;
    # User ID of the author of the message being replied to
    @jsondata:Name {value: "ReplyToCreatedByUserIDFK"}
    int replyToCreatedByUserIDFK?;
    # The message content (may contain HTML)
    @jsondata:Name {value: "ResponseBody"}
    string responseBody?;
    # Whether this is a system-generated message (e.g. status change notification)
    boolean isSystem?;
    @jsondata:Name {value: "ReplyToFileName1"}
    string replyToFileName1?;
    # Timestamp (UTC) of the most recent user edit. Null if never edited. Distinct from DateUpdated
    @jsondata:Name {value: "DateLastEditedUtc"}
    string dateLastEditedUtc?;
    # Creation date of the message being replied to
    @jsondata:Name {value: "ReplyToDateCreated"}
    string replyToDateCreated?;
    # Whether the current user can delete this message
    boolean canDelete?;
    # Author name of the message being replied to
    @jsondata:Name {value: "ReplyToUserName"}
    string replyToUserName?;
    @jsondata:Name {value: "ReplyToFilePreview1"}
    string replyToFilePreview1?;
};

# Request payload for posting a new comment / discussion message to a task. Use POST /api/FileAttachment first to upload any attachments and pass the resulting FileAttachmentIDs here
public type NewTaskDiscussion record {
    # True to post as an internal note (not visible to external/customer users). Only team members may post internal notes. Default: false
    boolean isInternalNote?;
    # The TaskID to post the discussion message to. Required
    @jsondata:Name {value: "TaskID"}
    int:Signed32 taskID?;
    # Optional. The TaskResponseID of an existing message on the same task being replied to. Set null/0/omit for a top-level message
    @jsondata:Name {value: "ReplyToMessageID"}
    int replyToMessageID?;
    # The message body. May contain a limited HTML subset (sanitised on save). Required unless FileAttachmentIDs is non-empty.
    # To @mention a user (notifies them and adds them as a task follower), include a span that carries a class attribute immediately before data-mentionid, e.g.
    # &lt;span class="mention" data-mentionid="12345"&gt;@Firstname Lastname&lt;/span&gt;. The class attribute is required — a span with data-mentionid but no class is stored as plain text and is NOT treated as a mention. Resolve the numeric user id via GET /api/User
    @jsondata:Name {value: "ResponseBody"}
    string responseBody?;
    # Optional. List of FileAttachmentIDs returned from prior /api/FileAttachment uploads to attach to this message. Each must be owned by the current user and not already linked (AttachmentType='Draft'). Maximum 8 per message
    @jsondata:Name {value: "FileAttachmentIDs"}
    int[] fileAttachmentIDs?;
};

