# Billing address and tax details for the Avaza account (the party issuing an invoice or estimate)
public type IssuerDetails record {
    # Formatted multi-line billing address
    @jsondata:Name {value: "BillingAddress"}
    string billingAddress?;
    # Label printed next to the issuer's tax number: the template's override, else the account's Company Default Tax Number Label, else "Tax Number"
    @jsondata:Name {value: "TaxNumberLabel"}
    string taxNumberLabel?;
    # Street address line of the billing address
    @jsondata:Name {value: "BillingAddressLine"}
    string billingAddressLine?;
    # State/province of the billing address
    @jsondata:Name {value: "BillingAddressState"}
    string billingAddressState?;
    # ISO 3166-1 alpha-2 country code of the billing address
    @jsondata:Name {value: "BillingCountryCode"}
    string billingCountryCode?;
    # Postal/ZIP code of the billing address
    @jsondata:Name {value: "BillingAddressPostCode"}
    string billingAddressPostCode?;
    # Tax registration number (e.g. VAT number, ABN, EIN) as printed on the document: the template's Company Tax Number override, else the account's Company Default Tax Number. Null when neither is set
    @jsondata:Name {value: "TaxNumber"}
    string taxNumber?;
    # City/suburb of the billing address
    @jsondata:Name {value: "BillingAddressCity"}
    string billingAddressCity?;
};

# Represents the Queries record for the operation: listUserProfiles
public type ListUserProfilesQueries record {
