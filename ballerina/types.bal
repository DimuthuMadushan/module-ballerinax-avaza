    boolean includeProjectName?;
    # Project IDs to pull uninvoiced fixed amounts from. When omitted, all projects of the invoice's customer are included
    @jsondata:Name {value: "ProjectIDs"}
    int:Signed32[] projectIDs?;
    # Include the task's assigned users in generated descriptions. Default true
    @jsondata:Name {value: "IncludeAssignedUser"}
    boolean includeAssignedUser?;
    # Include the task title in generated descriptions. Default true
    @jsondata:Name {value: "IncludeTask"}
    boolean includeTask?;
    # Include fixed amount notes in generated descriptions. Default true
    @jsondata:Name {value: "IncludeNotes"}
    boolean includeNotes?;
};

# Result of uploading an expense file attachment, containing the file details
public type ExpenseAttachmentUploadResult record {
