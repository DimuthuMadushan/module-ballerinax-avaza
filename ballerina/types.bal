    # Total estimate amount including tax
    @jsondata:Name {value: "TotalAmount"}
    decimal totalAmount?;
    # Unique identifier for the estimate
    @jsondata:Name {value: "EstimateID"}
    int estimateID?;
    # Subject line for the estimate
    @jsondata:Name {value: "Subject"}
    string subject?;
    # The estimate number (without prefix)
    @jsondata:Name {value: "EstimateItemNumber"}
    string estimateItemNumber?;
    # ISO 3-character currency code for the estimate
    @jsondata:Name {value: "CurrencyCode"}
    string currencyCode?;
    # Name of the customer company
    @jsondata:Name {value: "CompanyName"}
    string companyName?;
    # Total tax amount across all line items
    @jsondata:Name {value: "TaxAmount"}
    decimal taxAmount?;
    # Date the estimate was created/issued
    @jsondata:Name {value: "DateIssued"}
    string dateIssued?;
    # Date the estimate was sent to the customer
    @jsondata:Name {value: "DateSent"}
    string dateSent?;
    @jsondata:Name {value: "Links"}
    EstimateLinks links?;
    # Expiry date for the estimate
    @jsondata:Name {value: "DueDate"}
    string dueDate?;
    # Remaining balance on the estimate
    @jsondata:Name {value: "Balance"}
    decimal balance?;
    # Additional notes on the estimate
    @jsondata:Name {value: "Notes"}
    string notes?;
