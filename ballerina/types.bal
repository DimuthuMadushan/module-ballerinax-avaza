};

# JSON body for POST /api/FileAttachment/Upload (step 1 of the signed-URL upload flow). Describes the file the caller is about to send
public type FileAttachmentUploadAuthorizeRequest record {
    # Optional MIME type. Inferred from the extension if omitted. The stored ContentType comes from here, never from the PUT request headers
    @jsondata:Name {value: "ContentType"}
    string contentType?;
    # Original filename including extension. Required
    @jsondata:Name {value: "Filename"}
    string filename?;
    # Optional exact size in bytes (1 .. 52428800). When supplied, the PUT is rejected if its Content-Length is larger. Omit to allow any size up to 50 MB
    @jsondata:Name {value: "SizeBytes"}
    int sizeBytes?;
    @jsondata:Name {value: "LinkTo"}
    FileAttachmentLinkTarget linkTo?;
};

# Aggregated uninvoiced billable value for one customer (or one project)
public type UninvoicedSummaryGroup record {
    # The customer's currency. Uninvoiced time and fixed amounts are expressed in this currency
    @jsondata:Name {value: "CurrencyCode"}
    string currencyCode?;
    # The customer company name
    @jsondata:Name {value: "CompanyName"}
    string companyName?;
    # The project title, when grouping by project
    @jsondata:Name {value: "ProjectTitle"}
    string projectTitle?;
    # Number of uninvoiced chargeable expenses (Approved/AutoApproved)
    @jsondata:Name {value: "ExpenseCount"}
    int:Signed32 expenseCount?;
    # Indicative uninvoiced time value (sum of duration x billable rate, before rounding rules) in the customer's currency. Use PreviewUninvoicedItems for exact invoice amounts
    @jsondata:Name {value: "UninvoicedTimeAmount"}
    decimal uninvoicedTimeAmount?;
    # The project, when grouping by project. Null for expenses without a project
    @jsondata:Name {value: "ProjectIDFK"}
    int:Signed32 projectIDFK?;
    # Total uninvoiced fixed amount value in the customer's currency
    @jsondata:Name {value: "UninvoicedFixedAmount"}
    decimal uninvoicedFixedAmount?;
    # Total uninvoiced billable hours
    @jsondata:Name {value: "UninvoicedHours"}
    decimal uninvoicedHours?;
    # Uninvoiced chargeable expense value in the ACCOUNT's base currency (before markup). Exact converted-with-markup amounts come from PreviewUninvoicedItems
    @jsondata:Name {value: "UninvoicedExpenseAmount"}
    decimal uninvoicedExpenseAmount?;
    # The customer company
    @jsondata:Name {value: "CompanyIDFK"}
    int:Signed32 companyIDFK?;
    # Number of uninvoiced fixed amounts
    @jsondata:Name {value: "FixedAmountCount"}
    int:Signed32 fixedAmountCount?;
    # Number of uninvoiced billable timesheet entries (Approved/AutoApproved)
    @jsondata:Name {value: "TimesheetEntryCount"}
    int:Signed32 timesheetEntryCount?;
};

